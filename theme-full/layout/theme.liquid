  <style>
    /* === Nora Furnish Cart Drawer === */
    #cart-drawer p.h4[slot="header"]{ font-family:var(--heading-font-family); text-transform:uppercase; letter-spacing:0.14em; font-size:15px; font-weight:400; }
    /* Frame product photos so white/transparent images don't vanish */
    #cart-drawer .line-item__media{ background:#f6f4f1 !important; border:1px solid #ece8e3 !important; border-radius:10px !important; object-fit:contain !important; }
    #cart-drawer .line-item{ padding-bottom:18px; border-bottom:1px solid #ece8e3; }
    #cart-drawer .line-item-info a.h6{ font-family:var(--heading-font-family); font-size:13.5px; line-height:1.4; letter-spacing:0.01em; }
    #cart-drawer .cart-drawer__footer{ border-top:1px solid #e4e0db; padding-top:4px; }
    #cart-drawer .cart-drawer__footer .text-subdued{ font-size:11px; letter-spacing:0.02em; }
    /* Checkout button: Nora Furnish charcoal, authoritative */
    #cart-drawer .cart-drawer__footer .button, #cart-drawer .button-group .button{
      background:#1c1c1c !important; background-image:none !important; color:#ffffff !important; -webkit-text-fill-color:#ffffff !important;
      border:1px solid #1c1c1c !important; border-radius:0 !important; text-transform:uppercase !important; letter-spacing:0.14em !important;
      font-size:13px !important; font-weight:500 !important; padding:18px 22px !important; width:100% !important; min-height:0 !important;
    }
    #cart-drawer .cart-drawer__footer .button *, #cart-drawer .button-group .button *{ color:#ffffff !important; -webkit-text-fill-color:#ffffff !important; }
    #cart-drawer .cart-drawer__footer .button:hover, #cart-drawer .button-group .button:hover{ background:#2b2520 !important; border-color:#2b2520 !important; }
    /* Trust / authority badges above checkout */
    #cart-drawer .nf-cart-trust{ display:flex; justify-content:space-between; align-items:flex-start; gap:8px; padding:16px 0; margin:6px 0 4px; border-top:1px solid #ece8e3; }
    #cart-drawer .nf-cart-trust__item{ display:flex; flex-direction:column; align-items:center; gap:6px; flex:1; text-align:center; color:#1c1c1c; }
    #cart-drawer .nf-cart-trust__item svg{ width:20px; height:20px; }
    #cart-drawer .nf-cart-trust__item span{ font-size:9.5px; letter-spacing:0.07em; text-transform:uppercase; color:#5c5047; line-height:1.25; }
    /* Reassurance line */
    #cart-drawer .nf-cart-reassure{ display:flex; align-items:center; justify-content:center; gap:7px; font-size:11px; letter-spacing:0.04em; color:#1c1c1c; padding:2px 0 0; }
    #cart-drawer .cart-drawer__footer p.nf-cart-note{ display:block; width:100%; flex:0 0 100%; text-align:center; font-size:11px; letter-spacing:0.04em; color:#1c1c1c; margin:10px 0 0; padding:0; }
    .nf-cart-reassure svg{ width:14px; height:14px; flex:0 0 auto; }
    /* Empty state */
    #cart-drawer .nf-cart-empty{ display:flex; flex-direction:column; align-items:center; text-align:center; padding:8px 24px; gap:9px; }
    #cart-drawer .nf-cart-empty__icon{ width:42px; height:42px; color:#1c1c1c; opacity:0.5; margin-bottom:2px; }
    #cart-drawer .nf-cart-empty__title{ font-family:var(--heading-font-family); font-size:20px; letter-spacing:0.05em; margin:0; }
    #cart-drawer .nf-cart-empty__text{ font-size:13px; color:#5c5047; max-width:250px; line-height:1.5; margin:0; }
    #cart-drawer .nf-cart-empty__btn{ display:inline-block; margin-top:8px; background:#1c1c1c; color:#fff; text-decoration:none; text-transform:uppercase; letter-spacing:0.14em; font-size:12px; font-weight:500; padding:14px 30px; }
    #cart-drawer .nf-cart-empty__btn:hover{ background:#2b2520; }
    #cart-drawer .nf-cart-trust--empty{ display:flex; justify-content:center; gap:14px; flex-wrap:wrap; margin-top:20px; padding-top:16px; border-top:1px solid #ece8e3; width:100%; }
    #cart-drawer .nf-cart-trust--empty span{ font-size:10px; letter-spacing:0.06em; text-transform:uppercase; color:#5c5047; }
  </style>

