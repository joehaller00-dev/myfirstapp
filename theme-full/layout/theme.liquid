{%- comment -%} NF-TOTOP-V2 the original never added its is-on class, so the button could not appear {%- endcomment -%}
<script>
(function(){
  if (window.__nfToTopV2) return; window.__nfToTopV2 = 1;
  function init(){
    var b = document.querySelector(".nf-totop");
    if (!b) {
      b = document.createElement("button");
      b.type = "button"; b.className = "nf-totop"; b.setAttribute("aria-label", "Back to top");
      b.innerHTML = '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5M5 12l7-7 7 7"/></svg>';
      document.body.appendChild(b);
    }
    b.addEventListener("click", function(){
      try { window.scrollTo({ top: 0, behavior: "smooth" }); } catch (e) { window.scrollTo(0, 0); }
    });
    var on = false, last = 0;
    function upd(){
      var y = window.scrollY || document.documentElement.scrollTop || 0;
      var show = y > 600;
      if (show !== on) { on = show; b.classList.toggle("is-on", on); }
    }
    // no requestAnimationFrame here on purpose: it is frozen in background tabs
    window.addEventListener("scroll", function(){
      var now = Date.now();
      if (now - last > 90) { last = now; upd(); }
    }, { passive: true });
    window.addEventListener("resize", upd, { passive: true });
    document.addEventListener("visibilitychange", upd);
    upd();
    setTimeout(upd, 800);
  }
  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", init); else init();
})();
</script>
