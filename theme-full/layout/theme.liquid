    {%- comment -%} NF-SPEED-0914: Meta Pixel 1312346300797035 removed (owner 2026-09-14: no Meta or Facebook ads, Google Ads only), so fbevents.js
      no longer loads. fbq stays as a harmless no-op so the AddToCart and Purchase calls further down never throw. {%- endcomment -%}
    <script>window.fbq = window.fbq || function () {};</script>
    <script>
      /* NF-PERF-0911 tag loader. The Google tag and Meta Pixel command queues (dataLayer, fbq) are created above,
         so every call (both AW configs, PageView, AddToCart, Purchase) is queued and sent the moment the library
         arrives. The libraries load on the first interaction or after 4s, so ~1s of third party script parsing no
         longer lands on top of first paint on low end phones. GSF custom pixel conversions are not affected. */
      (function(){
        var done = false, EV = ['pointerdown','keydown','touchstart','scroll','wheel'];
        function add(src){ var t = document.createElement('script'); t.async = true; t.src = src; document.head.appendChild(t); }
        function load(){
          if (done) return; done = true;
          EV.forEach(function(e){ window.removeEventListener(e, load, true); });
          add('https://www.googletagmanager.com/gtag/js?id=AW-18133462360');
        }
        EV.forEach(function(e){ window.addEventListener(e, load, {capture:true, passive:true}); });
        /* NF-SPEED-0913: without an interaction, wait until the page has finished loading plus a quiet moment instead of a flat 4s, so the tag libraries never share a slow phone connection with the first screen. Hard ceiling 12s. Every queued call (both AW configs, PageView, AddToCart) is still sent when they arrive. */
        function nfIdle(){ (window.requestIdleCallback || function(f){ setTimeout(f, 1); })(load, { timeout: 2000 }); }
        if (document.readyState === 'complete') { setTimeout(nfIdle, 1000); } else { window.addEventListener('load', function(){ setTimeout(nfIdle, 1000); }); }
        setTimeout(load, 12000);
      })();
    </script>

