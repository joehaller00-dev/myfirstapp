  <script>
    (function(){
      var d = document.documentElement;
      /* NF-SPEED-0913: moving between our own pages never shows the white sheet or the curtain. The old page stays on screen until the new one can paint (cross document view transition), so there is no blank white moment. The sheet is kept only for a fresh landing. */
      try { var nfNav = (performance.getEntriesByType && performance.getEntriesByType("navigation")[0]) || {}; var nfRef = document.referrer; /* NF-RELOAD-SOFT (2026-09-14, owner: reload felt slow and showed the page half ready): a reload or back/forward is not a fresh landing, so no sheet and no logo curtain. */ if (nfNav.type === "reload" || nfNav.type === "back_forward" || (nfRef && new URL(nfRef).host === location.host)) { d.classList.add("nf-soft"); return; } } catch (e) {}
      /* NF-SPEED-0916 (owner 09-16: page must load at least 40% faster, "it could be the animations"): a fresh landing no longer waits behind the white sheet, the logo curtain or the #main render block. The page paints while it streams. Internal clicks keep the #main block so their cross fade still works. To restore the landing curtain, delete this line. */
      d.classList.add("nf-soft"); try { var nfEx = document.querySelector('link[rel="expect"]'); if (nfEx) nfEx.remove(); } catch (e) {} return;
      d.classList.add("nf-preload", "nf-cur-in");
      /* NF-SPEED-0913 (curtain v2): the logo curtain now sits at the top of <body> (styles in this head, entrance driven by CSS
         through html.nf-cur-in), so the brand moment shows from the first paint while the page loads underneath. It lifts the
         moment the page is ready: when the hero or LCP image (img[fetchpriority=high]) has decoded, or on pages without one at
         DOMContentLoaded + 250ms, and never later than 1.2s from navigation start (it used to wait for DOMContentLoaded, cap 2.5s,
         which held pages that had already painted). The cap is checked by a timer and on every parser chunk, because a busy parser
         starves timers on slow phones. The curtain slides up and the sheet goes at the same instant underneath it, so the page,
         not white, is revealed. The logo keeps at least 90ms on screen. */
      var CAP = 1200, done = false, hero = null, mo = null, curAt = 0;
      function lift(capped){
        if (done) return; done = true;
        if (mo) mo.disconnect();
        var c = document.getElementById("nf-curtain");
        if (c && c.style.display !== "none" && getComputedStyle(c).display !== "none") {
          var wait = curAt ? Math.max(0, 90 - (performance.now() - curAt)) : 0;
          setTimeout(function(){ d.classList.remove("nf-preload"); c.classList.add("lift"); setTimeout(function(){ c.style.display = "none"; }, 460); }, wait);
          return;
        }
