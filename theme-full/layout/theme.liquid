    {%- comment -%} NF-HERO-PRELOAD-V2 (2026-09-16): the homepage hero was requested ~4s late on phones (the parser only reached it after the head CSS). These three hints mirror the <picture> in the hero section exactly (same media, srcset and sizes), so the browser starts the one it will use at once and never a second copy. If the homepage hero photo is changed, change the filename here too (or delete this block). {%- endcomment -%}
    {%- if request.page_type == 'index' -%}
      {%- assign nf_hero = images['nf-hero-patio-evening.jpg'] -%}
      {%- if nf_hero != blank -%}
        {%- capture nf_hs1 -%}{%- for w in (0..2) -%}{%- assign nw = '360,450,550' | split: ',' | slice: w | first | plus: 0 -%}{{ nf_hero | image_url: width: nw, crop: 'region', crop_width: 1700, crop_height: 1786, crop_left: 930, crop_top: 0 }} {{ nw }}w{% unless forloop.last %}, {% endunless %}{%- endfor -%}{%- endcapture -%}
        {%- capture nf_hs2 -%}{%- for w in (0..3) -%}{%- assign nw = '400,600,800,1000' | split: ',' | slice: w | first | plus: 0 -%}{{ nf_hero | image_url: width: nw }} {{ nw }}w{% unless forloop.last %}, {% endunless %}{%- endfor -%}{%- endcapture -%}
        {%- capture nf_hs3 -%}{%- for w in (0..19) -%}{%- assign nw = '200,300,400,500,600,700,800,900,1000,1200,1400,1600,1800,2000,2200,2400,2600,2800,3000,3200' | split: ',' | slice: w | first | plus: 0 -%}{{ nf_hero | image_url: width: nw }} {{ nw }}w{% unless forloop.last %}, {% endunless %}{%- endfor -%}{%- endcapture -%}
        <link rel="preload" as="image" fetchpriority="high" media="(max-width: 499px)" imagesrcset="{{ nf_hs1 }}" imagesizes="460px">
        <link rel="preload" as="image" fetchpriority="high" media="(min-width: 500px) and (max-width: 699px)" imagesrcset="{{ nf_hs2 }}" imagesizes="100vw">
        <link rel="preload" as="image" fetchpriority="high" media="(min-width: 700px)" imagesrcset="{{ nf_hs3 }}" imagesizes="100vw">
      {%- endif -%}
    {%- endif -%}
    <meta name="p:domain_verify" content="39ed78a4b9b8c28158601782b1d9472a"/>
