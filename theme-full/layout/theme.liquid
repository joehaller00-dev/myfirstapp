    <!-- Google tag (gtag.js) -->
{%- comment -%} NF-PERF-0911: gtag.js is now injected by the tag loader below the Meta Pixel block (first interaction or 4s). The dataLayer queue and both AW configs are unchanged and are sent when it loads. {%- endcomment -%}
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'AW-18133462360');
  gtag('config', 'AW-18130838733');
</script>
    <meta charset="utf-8">
