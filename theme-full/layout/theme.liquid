  <style id="nora-bestsellers-banner">
    /* Best Sellers banner: inset with gaps */
    .shopify-section--main-product ~ .shopify-section--image-with-text-overlay {
      padding-left: 60px !important;
      padding-right: 60px !important;
    }
    .shopify-section--main-product ~ .shopify-section--image-with-text-overlay .content-over-media {
      background-color: #1c1c1c !important;
      border-radius: 12px !important;
      min-height: 580px !important;
      overflow: hidden !important;
    }
    /* Push content below the sticky add-to-cart bar, match nf-hero-content spacing */
    .shopify-section--main-product ~ .shopify-section--image-with-text-overlay .content {
      padding: 60px 40px 32px !important;
      gap: 14px !important;
      row-gap: 14px !important;
      align-items: flex-start !important;
    }
    /* Center button under heading */
    .shopify-section--main-product ~ .shopify-section--image-with-text-overlay .button,
    .shopify-section--main-product ~ .shopify-section--image-with-text-overlay .button--solid {
      align-self: center !important;
      margin-left: 0 !important;
      margin-right: 0 !important;
    }
    /* Heading: match nf-hero-heading */
    .shopify-section--main-product ~ .shopify-section--image-with-text-overlay .content p,
    .shopify-section--main-product ~ .shopify-section--image-with-text-overlay .content h2 {
      font-size: clamp(26px, 2.5vw, 36.4px) !important;
      font-weight: 300 !important;
      letter-spacing: 0.5px !important;
      line-height: 1.4 !important;
      margin: 0 !important;
    }
    /* Button: match nf-hero-btn */
    .shopify-section--main-product ~ .shopify-section--image-with-text-overlay a.button,
    .shopify-section--main-product ~ .shopify-section--image-with-text-overlay .button {
      font-size: 11px !important;
      letter-spacing: 0.12em !important;
      text-transform: uppercase !important;
      padding: 13px 22px !important;
      font-weight: 500 !important;
      min-height: 0 !important;
      line-height: 1 !important;
      margin-top: 4px !important;
    }
  </style>


