  function tick(){ if (!isOpen()){ if (iv){ clearInterval(iv); iv = 0; } return; } if (!raf) raf = requestAnimationFrame(function(){ raf = 0; sync(); }); } /* NF-SMOOTH-V1: one measure per event, no per-frame loop or 100ms poll while open */
