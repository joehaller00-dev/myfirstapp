        setTimeout(function(){ d.classList.remove("nf-preload", "nf-sheet-out"); }, 260);
      }
      window.__nfPageReady = lift;
      function watchHero(img){
        hero = img;
        var ok = function(){ lift(false); };
        var dec = function(){ if (img.decode) { img.decode().then(ok, ok); } else { ok(); } };
        if (img.complete) { dec(); } else { img.addEventListener("load", dec, { once: true }); img.addEventListener("error", ok, { once: true }); }
      }
      function scan(){
        if (!curAt && document.getElementById("nf-curtain")) curAt = performance.now();
        if (!hero) { var h = document.querySelector('img[fetchpriority="high"]'); if (h) watchHero(h); }
      }
      setTimeout(function(){ lift(true); }, Math.max(0, CAP - performance.now()));
      if (window.MutationObserver) {
