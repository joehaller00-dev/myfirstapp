  {%- if request.page_type == 'index' -%}
  <script>(function(){var d=0;function go(){if(d)return;d=1;var s=document.createElement("script");s.src="{{ "custom-nav.js" | asset_url }}";document.head.appendChild(s);}if(document.readyState==="complete"){go();}else{window.addEventListener("load",go,{once:true});["pointerdown","touchstart","keydown"].forEach(function(e){window.addEventListener(e,go,{once:true,passive:true,capture:true});});}})();</script>
  {%- else -%}
