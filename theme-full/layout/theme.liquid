  var root = document.documentElement, bar = null, lastY = window.scrollY, ticking = false;
  // re-query when the section re-renders after a filter or sort change
  function el(){ if (!bar || !bar.isConnected) bar = document.querySelector(".collection-toolbar"); return bar; }
  function busy(b){
    if (b.querySelector("[aria-expanded='true']") || b.querySelector("details[open]")) return true;
    var m = document.querySelectorAll("dialog[open], [aria-modal='true']");
    for (var i = 0; i < m.length; i++) if (m[i].offsetParent !== null) return true;
    return false;
  }
  function update(){
    ticking = false;
    var b = el(); if (!b) return;
    var y = window.scrollY;
    if (y > lastY + 6 && y > 200 && !root.classList.contains("nf-toolbar-off") && busy(b)) { lastY = y; return; } /* NF-SMOOTH-V1 */
    if (y > lastY + 6 && y > 200) root.classList.add("nf-toolbar-off");
    else if (y < lastY - 6) root.classList.remove("nf-toolbar-off");
    lastY = y;
  }
  window.addEventListener("scroll", function(){
    if (!ticking) { ticking = true; requestAnimationFrame(update); }
  }, {passive:true});
})();
</script>
