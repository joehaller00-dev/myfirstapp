    (function(){
      var el = document.querySelector('[data-nfa-end]'); if (!el) return;
      var end = Date.parse(el.getAttribute('data-nfa-end')), t = el.querySelector('[data-nfa-t]');
      function two(n){ return (n < 10 ? '0' : '') + n; }
      function tick(){
        var left = end - Date.now();
        if (!(left > 0)) { el.remove(); return; }
        var s = Math.floor(left / 1000), d = Math.floor(s / 86400), h = Math.floor(s % 86400 / 3600), m = Math.floor(s % 3600 / 60);
        t.textContent = 'Ends in ' + (d ? d + 'd ' : '') + two(h) + 'h ' + two(m) + 'm ' + two(s % 60) + 's';
        setTimeout(tick, 1000);
