        "open_first": false
      },
      "blocks": {
        "q1": {
          "type": "faq",
          "settings": {
            "q": "How do I measure my window?",
            "a": "<p>Measure the width of the frame from outside edge to outside edge, and the height from the top of the frame down to the sill. Use a steel tape and write the numbers down in inches. The helper above turns those two numbers into panel sizes.</p>"
          }
        },
        "q2": {
          "type": "faq",
          "settings": {
            "q": "How much wider than the window should curtains be?",
            "a": "<p>For a full look, the curtains together should be about twice as wide as the rod. Sheers look best closer to three times, and a flat, tailored look can be as little as one and a half times. The fullness setting does this math for you.</p>"
          }
        },
        "q3": {
          "type": "faq",
          "settings": {
            "q": "How high should I hang the rod?",
            "a": "<p>Four inches or more above the frame is standard. Hanging it higher, even just below the ceiling, makes the window look taller. Letting the rod run a few inches past each side lets the panels open clear of the glass.</p>"
          }
        },
        "q4": {
          "type": "faq",
          "settings": {
            "q": "What if my measurements are off?",
            "a": "<p>Please measure twice before you approve your quote, because each panel is made to the sizes you approve. If you are unsure, send a photo of the window with the tape measure in it and we will check your numbers with you.</p>"
          }
        },
        "q5": {
          "type": "faq",
          "settings": {
            "q": "Will blackout curtains make the room fully dark?",
            "a": "<p>Blackout fabric or a blackout lining blocks most light through the fabric. Some light can still come in around the edges, so hanging the rod higher and wider than the frame helps a bedroom get darker.</p>"
          }
        },
        "q6": {
          "type": "faq",
          "settings": {
            "q": "Can I return made to measure curtains?",
            "a": "<p>Custom pieces are made for your order, so they are final sale and cannot be returned for a change of mind. If anything arrives damaged or has a defect, we replace it or refund it. Email photos to info@norafurnish.com as soon as you can and we will put it right.</p>"
          }
        }
      },
      "block_order": [
        "q1",
