        "liquid": "<style>\n.nf-hero-wrap {\n  position: relative;\n  width: 100%;\n  height: 780px;\n  background-color: #c9b9a7; background-image: url('https://cdn.shopify.com/s/files/1/0750/8380/8820/files/nf_kd_hero.jpg?v=1780641648&width=2000');\n  background-size: cover;\n  background-position: center;\n}\n.nf-hero-overlay {\n  position: absolute;\n  inset: 0;\n}\n.nf-hero-content {\n  position: absolute;\n  top: 0;\n  left: 0;\n  padding: 32px 40px;\n  display: flex;\n  flex-direction: column;\n  align-items: flex-start;\n  gap: 14px;\n}\n.nf-hero-eyebrow {\n  font-size: 11px;\n  letter-spacing: 0.15em;\n  text-transform: uppercase;\n  color: #fff;\n  font-weight: 400;\n}\n.nf-hero-heading {\n  font-size: clamp(26px, 2.5vw, 34px);\n  font-family: var(--font-heading-family, Georgia, serif);\n  color: #fff;\n  font-weight: 400;\n  line-height: 1.1;\n  margin: 0;\n  white-space: nowrap;\n}\n.nf-hero-btn {\n  display: inline-block;\n  background: #fff;\n  color: #222;\n  text-decoration: none;\n  font-size: 11px;\n  letter-spacing: 0.12em;\n  text-transform: uppercase;\n  padding: 13px 22px;\n  font-weight: 500;\n  margin-top: 4px;\n}\n@media (max-width: 768px) {\n  .nf-hero-wrap {\n    height: 300px;\n    background-position: center 50%;\n  }\n  .nf-hero-content {\n    padding: 22px 24px;\n    gap: 10px;\n  }\n  .nf-hero-eyebrow {\n    font-size: 10px;\n  }\n  .nf-hero-heading {\n    font-size: 24px;\n    white-space: normal;\n  }\n  .nf-hero-btn {\n    padding: 15px 20px;\n    font-size: 11px;\n    line-height: 1.4;\n  }\n}\n</style>\n\n{% assign hero_img = images['kitchen_dining_hero.jpg'] %}\n{% if hero_img %}\n{% endif %}\n\n<div class=\"nf-hero-wrap\" style=\"background-image:linear-gradient(rgba(0,0,0,0.08),rgba(0,0,0,0.08)),url('https://cdn.shopify.com/s/files/1/0750/8380/8820/files/nf_kd_hero.jpg?v=1780641648&width=2000');background-size:cover;background-position:center;\">\n  <div class=\"nf-hero-overlay\"></div>\n  <div class=\"nf-hero-content\">\n    <span class=\"nf-hero-eyebrow\">Curated for your home</span>\n    <h2 class=\"nf-hero-heading\">Fresh Ideas for Every Room</h2>\n    <a href=\"/collections/decor\" class=\"nf-hero-btn\">Shop Decor</a>\n  </div>\n</div>",
