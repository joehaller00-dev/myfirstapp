n:all .25s}\n.nf-mosaic__big:hover .nf-mosaic__btn{background:#c9a36a;color:#fff}\n@media(max-width:899px){\n.nf-mosaic{padding:10px 14px 28px}\n.nf-mosaic__head{margin-bottom:12px;padding:0 6px}\n.nf-mosaic__grid{grid-template-columns:1fr 1fr;grid-auto-rows:auto}\n.nf-mosaic__big{grid-column:1/3;grid-row:auto;min-height:330px}\n.nf-mosaic__grid a{min-height:168px}\n.nf-mosaic__label{font-size:16px;bottom:12px}\n.nf-mosaic__big-content{padding:0 18px 24px}\n}\n</style>\n{%- assign img_wall = '' -%}\n{%- for product in collections['outdoor-wall-lights'].products limit: 40 -%}\n{%- capture fsrc -%}{{ product.featured_image | image_url: width: 1100 }}{%- endcapture -%}\n{%- if img_wall == '' and fsrc contains '/image_1' -%}{%- assign img_wall = fsrc -%}{%- endif -%}\n{%- endfor -%}\n{%- if img_wall == '' -%}{%- assign img_wall = 'https://cdn.shopify.com/s/files/1/0750/8380/8820/files/tile_outdoor_lighting_hq.webp?width=800' -%}{%- endif -%}\n{%- assign img_post = '' -%}\n{%- for product in collections['outdoor-post-lights'].products limit: 40 -%}\n{%- capture fsrc -%}{{ product.featured_image | image_url: width: 1100 }}{%- endcapture -%}\n{%- if img_post == '' and fsrc contains '/image_1' -%}{%- assign img_post = fsrc -%}{%- endif -%}\n{%- endfor -%}\n{%- if img_post == '' -%}{%- assign img_post = 'https://cdn.shopify.com/s/files/1/0750/8380/8820/files/tile_outdoor_lighting_hq.webp?width=800' -%}{%- endif -%}\n{%- assign img_lant = '' -%}\n{%- for product in collections['outdoor-lanterns'].products limit: 40 -%}\n{%- capture fsrc -%}{{ product.featured_image | image_url: width: 1100 }}{%- endcapture -%}\n{%- if img_lant == '' and fsrc contains '/image_1' -%}{%- assign img_lant = fsrc -%}{%- endif -%}\n{%- endfor -%}\n{%- if img_lant == '' -%}{%- assign img_lant = 'https://cdn.shopify.com/s/files/1/0750/8380/8820/files/tile_outdoor_lighting_hq.webp?width=800' -%}{%- endif -%}\n{%- assign img_land = '' -%}\n{%- for product in collections['landscape-lighting'].products li