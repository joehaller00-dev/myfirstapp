    "custom_liquid_nfnewin": {
      "type": "custom-liquid",
      "name": "NF New Arrivals",
      "settings": {
        "color_scheme": "scheme-2",
        "separate_section_with_border": true,
        "remove_vertical_spacing": true,
        "remove_horizontal_spacing": true,
        "liquid": "{%- assign nf_fallback_out = 'https://cdn.shopify.com/s/files/1/0750/8380/8820/files/tile_outdoor_lighting_hq.webp?v=1785976124' -%}\n{%- assign nf_fallback_in = 'https://cdn.shopify.com/s/files/1/0750/8380/8820/files/nf_chandelier_dining.jpg' -%}\n{%- assign img1 = '' -%}\n{%- for product in collections['path-lights'].products -%}\n  {%- if img1 == '' -%}\n    {%- capture fsrc -%}{{ product.featured_image | image_url: width: 1600 }}{%- endcapture -%}\n    {%- if fsrc contains '/image_1' -%}{%- assign img1 = fsrc -%}{%- endif -%}\n  {%- endif -%}\n{%- endfor -%}\n{%- if img1 == '' -%}{%- assign img1 = nf_fallback_out -%}{%- endif -%}\n{%- assign img2 = '' -%}\n{%- for product in collections['outdoor-wall-lights'].products -%}\n  {%- if img2 == '' -%}\n    {%- capture fsrc -%}{{ product.featured_image | image_url: width: 1600 }}{%- endcapture -%}\n    {%- if fsrc contains '/image_1' -%}{%- assign img2 = fsrc -%}{%- endif -%}\n  {%- endif -%}\n{%- endfor -%}\n{%- if img2 == '' -%}{%- assign img2 = nf_fallback_out -%}{%- endif -%}\n{%- assign img3 = '' -%}\n{%- for product in collections['outdoor-post-lights'].products -%}\n  {%- if img3 == '' -%}\n    {%- capture fsrc -%}{{ product.featured_image | image_url: width: 1600 }}{%- endcapture -%}\n    {%- if fsrc contains '/image_1' -%}{%- assign img3 = fsrc -%}{%- endif -%}\n  {%- endif -%}\n{%- endfor -%}\n{%- if img3 == '' -%}{%- assign img3 = nf_fallback_out -%}{%- endif -%}\n{%- assign img4 = '' -%}\n{%- for product in collections['outdoor-lanterns'].products -%}\n  {%- if img4 == '' -%}\n    {%- capture fsrc -%}{{ product.featured_image | image_url: width: 1600 }}{%- endcapture -%}\n    {%- if fsrc contains '/image_1' -%}{%- assign img4 = fsrc -%}{%- endif -%}\n  {%- endif -%}\n{%- endfor -%}\n{%- if img4 == '' -%}{%- assign img4 = nf_fallback_out -%}{%- endif -%}\n{%- assign img5 = '' -%}\n{%- for product in collections['chandeliers'].products -%}\n  {%- if img5 == '' -%}\n    {%- capture fsrc -%}{{ product.featured_image | image_url: width: 1600 }}{%- endcapture -%}\n    {%- if fsrc contains '/image_1' -%}{%- assign img5 = fsrc -%}{%- endif -%}\n  {%- endif -%}\n{%- endfor -%}\n{%- if img5 == '' -%}{%- assign img5 = nf_fallback_in -%}{%- endif -%}\n{%- assign img6 = '' -%}\n{%- for product in collections['pendants'].products -%}\n  {%- if img6 == '' -%}\n    {%- capture fsrc -%}{{ product.featured_image | image_url: width: 1600 }}{%- endcapture -%}\n    {%- if fsrc contains '/image_1' -%}{%- assign img6 = fsrc -%}{%- endif -%}\n  {%- endif -%}\n{%- endfor -%}\n{%- if img6 == '' -%}{%- assign img6 = nf_fallback_in -%}{%- endif -%}\n{%- assign img7 = '' -%}\n{%- for product in collections['flush-mount-lighting'].products -%}\n  {%- if img7 == '' -%}\n    {%- capture fsrc -%}{{ product.featured_image | image_url: width: 1600 }}{%- endcapture -%}\n    {%- if fsrc contains '/image_1' -%}{%- assign img7 = fsrc -%}{%- endif -%}\n  {%- endif -%}\n{%- endfor -%}\n{%- if img7 == '' -%}{%- assign img7 = nf_fallback_in -%}{%- endif -%}\n{%- assign img8 = '' -%}\n{%- for product in collections['table-lamps'].products -%}\n  {%- if img8 == '' -%}\n    {%- capture fsrc -%}{{ product.featured_image | image_url: width: 1600 }}{%- endcapture -%}\n    {%- if fsrc contains '/image_1' -%}{%- assign img8 = fsrc -%}{%- endif -%}\n  {%- endif -%}\n{%- endfor -%}\n{%- if img8 == '' -%}{%- assign img8 = nf_fallback_in -%}{%- endif -%}\n<style>\n.nf-newin{padding:48px 0 6px}\n.nf-newin__grid{display:grid;grid-template-columns:minmax(0,500px) minmax(0,1fr);gap:40px;align-items:start;padding:0 48px;max-width:1500px;margin:0 auto}\n.nf-eyebrow{font-family:Inter,sans-serif;font-size:10.5px;letter-spacing:.24em;text-transform:uppercase;color:#8a8580;font-weight:600}\n.nf-newin__title{font-family:var(--heading-font-family);font-size:clamp(38px,4vw,58px);line-height:1.02;font-weight:360;margin:12px 0 0;color:#141414}\n.nf-newin__rule{display:block;width:52px;height:1px;background:#141414;opacity:.4;margin:20px 0}\n.nf-newin__copy{font-size:14px;line-height:1.6;color:#5f5c58;max-width:44ch;margin:0 0 18px}\n.nf-newin__toggle{display:inline-flex;border:1px solid #DEDCD8;border-radius:999px;padding:4px;gap:2px;margin-bottom:16px;background:#fff}\n.nf-toggle-btn{display:inline-flex;align-items:center;gap:7px;border:0;background:transparent;border-radius:999px;padding:10px 20px;font:700 10.5px/1 Inter,sans-serif;letter-spacing:.1em;text-transform:uppercase;color:#141414;cursor:pointer;transition:all .2s}\n.nf-toggle-btn svg{width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}\n.nf-toggle-btn.is-active{background:#141414;color:#fff}\n.nf-newin__cats{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-bottom:20px}\n.nf-newin__cats[hidden]{display:none}\n.nf-cat{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;text-align:center;border:1px solid #DEDCD8;border-radius:4px;background:#fff;padding:14px 6px 12px;font:600 9.5px/1.3 Inter,sans-serif;letter-spacing:.07em;text-transform:uppercase;color:#141414;cursor:default;transition:all .2s;min-height:78px}\n.nf-cat svg{width:24px;height:24px;stroke:currentColor;fill:none;stroke-width:1.4;stroke-linecap:round;stroke-linejoin:round}\n.nf-cat:hover,.nf-cat.is-active{background:#FBF8F2;border-color:#C9C4BC}\n.nf-cat.is-active{position:relative}\n.nf-cat.is-active::after{content:\"\";position:absolute;bottom:8px;left:50%;transform:translateX(-50%);width:22px;height:1.5px;background:#c9a36a}\n.nf-newin__ctas{display:flex;align-items:center;gap:22px;flex-wrap:wrap}\n.nf-btn-solid{display:inline-block;background:#141414;color:#fff !important;border-radius:999px;padding:14px 24px;font:700 10.5px/1 Inter,sans-serif;letter-spacing:.12em;text-transform:uppercase;text-decoration:none;transition:background .25s}\n.nf-btn-solid:hover{background:#c9a36a}\n.nf-btn-text{font-family:var(--heading-font-family);font-size:14.5px;color:#141414;text-decoration:underline;text-underline-offset:4px}\n.nf-btn-text:hover{color:#c9a36a}\n.nf-newin__media{border-radius:6px;overflow:hidden;background:#f4f4f2;aspect-ratio:4/3;max-height:540px}\n.nf-newin__media img{width:100%;height:100%;object-fit:cover;display:block;transition:opacity .25s}\n.nf-newin__media img.is-fading{opacity:0}\n.nf-newin__rowwrap{padding:20px 48px 20px;max-width:1500px;margin:0 auto}\n.nf-newin__row{display:grid;grid-template-columns:repeat(6,1fr);gap:16px}\n.nf-newin__row[hidden]{display:none}\n.nf-np{text-decoration:none;color:#141414;display:block}\n.nf-np__img{position:relative;aspect-ratio:1/1;border-radius:4px;overflow:hidden;background:#f6f6f5;border:1px solid #EEECE8}\n.nf-np__img img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .35s cubic-bezier(.22,1,.36,1)}\n.nf-np:hover .nf-np__img img{transform:scale(1.045)}\n.nf-np__badge{position:absolute;top:10px;left:10px;z-index:1;background:#E8B54A;color:#141414;font:700 9.5px/1 Inter,sans-serif;letter-spacing:.08em;border-radius:999px;padding:6px 11px}\n.nf-np__title{font-family:var(--heading-font-family);font-size:14px;line-height:1.35;margin:10px 0 4px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}\n.nf-np__price{font:600 12.5px/1 Inter,sans-serif;color:#141414}\n@media(max-width:899px){\n.nf-newin{padding:32px 0 4px}\n.nf-newin__grid{grid-template-columns:1fr;gap:20px;padding:0 20px}\n.nf-newin__media{order:-1;aspect-ratio:16/10;max-height:none}\n.nf-newin__cats{grid-template-columns:repeat(2,1fr)}\n.nf-cat{min-height:70px}\n.nf-newin__rowwrap{padding:18px 0 12px 20px}\n.nf-newin__row{display:flex;overflow-x:auto;gap:12px;scroll-snap-type:x mandatory;padding-right:20px;scrollbar-width:none}\n.nf-newin__row::-webkit-scrollbar{display:none}\n.nf-newin__row>a{flex:0 0 46vw;scroll-snap-align:start}\n.nf-newin__row[hidden]{display:none}\n}\n</style>\n<section class=\"nf-newin\" id=\"nf-newin\">\n  <div clas