    "custom_liquid_nfautumn": {
      "type": "custom-liquid",
      "settings": {
        "color_scheme": "scheme-2",
        "separate_section_with_border": false,
        "remove_vertical_spacing": true,
        "remove_horizontal_spacing": true,
        "liquid": "{%- comment -%} NF-AUTUMNHOME-V7 (2026-09-22, supersedes V6; sale badge + compare-at strike on cards; nav-home-fragrance now tested BEFORE nav-decor so the Candles and Fragrance tab is not swallowed by the decor bucket): tabbed band under Pieces Made for Every Home. Tabs are store categories, driven by the nav-* tags. One panel at a time, 7 cards each in a wrapping grid so every card is fully visible: no scroll track, no edge fade. No requestAnimationFrame. V5 adds inline SVG fall decals in the two side gutters only: absolutely positioned, clipped, hidden under 900px, aria-hidden, pointer-events none, no animation. Plus non layout polish: warm charcoal gradient, fading gold hairline, warmer pill and card states, dark media placeholder instead of cream. Every box model dimension is unchanged from V4 so the band height does not move. {%- endcomment -%}\n{%- assign nf_ah = collections['autumn-at-home'] -%}\n{%- if nf_ah != blank and nf_ah.products.size > 0 -%}\n{%- assign nf_keys = 'fall,halloween,inflatables,soft,fragrance' | split: ',' -%}\n{%- assign nf_names = 'Fall Decor|Halloween Decor|Halloween Inflatables|Throws and Pillows|Candles and Fragrance' | split: '|' -%}\n{%- assign nf_limits = '14,14,14,14,14' | split: ',' -%}\n<style>\n.nf-ah{position:relative;background-color:#1c1c1c;background-image:linear-gradient(180deg,#211d19 0%,#1c1c1c 40%,#1c1c1c 70%,#201c18 100%);color:#fff;padding:62px 0 66px;text-align:left;overflow-x:clip}\n.nf-ah__wrap{position:relative;z-index:1;width:min(2400px,82%);margin:0 auto}\n.nf-ah__head{display:flex;align-items:flex-end;justify-content:space-between;gap:32px;flex-wrap:wrap}\n.nf-ah__intro{max-width:62ch;min-width:0;flex:1 1 320px}\n.nf-ah__eyebrow{margin:0;font-family:Inter,sans-serif;font-size:10.5px;font-weight:600;letter-spacing:.24em;text-transform:uppercase;color:#c9a36a}\n.nf-ah__title{font-family:var(--heading-font-family);font-size:clamp(34px,3.2vw,54px);line-height:1.04;font-weight:360;letter-spacing:.4px;margin:12px 0 0;color:#fff}\n.nf-ah__copy{margin:14px 0 0;font-size:14.5px;line-height:1.62;color:#cfc8bf}\n.nf-ah__cta{display:inline-block;flex:none;border:1px solid rgba(201,163,106,.5);border-radius:999px;padding:14px 26px;font:700 10.5px/1 Inter,sans-serif;letter-spacing:.12em;text-transform:uppercase;color:#fff !important;text-decoration:none;transition:background .25s,color .25s,border-color .25s,box-shadow .25s}\n.nf-ah__cta:hover{background:#c9a36a;border-color:#c9a36a;color:#1c1c1c !important;box-shadow:0 2px 18px rgba(201,163,106,.28)}\n.nf-ah__rule{height:1px;background:linear-gradient(90deg,rgba(201,163,106,.58) 0%,rgba(201,163,106,.17) 38%,rgba(201,163,106,0) 100%);margin:28px 0 22px}\n.nf-ah__tabs{display:flex;gap:8px;overflow-x:auto;scrollbar-width:none;padding:2px 0 4px;margin-bottom:22px}\n.nf-ah__tabs::-webkit-scrollbar{display:none}\n.nf-ah__tab{flex:0 0 auto;appearance:none;cursor:pointer;background:transparent;border:1px solid rgba(201,163,106,.24);border-radius:999px;padding:11px 19px;font:600 11px/1 Inter,sans-serif;letter-spacing:.11em;text-transform:uppercase;color:#cfc8bf;transition:color .22s ease,border-color .22s ease,background-color .22s ease,box-shadow .22s ease}\n.nf-ah__tab:hover{color:#fff;border-color:rgba(201,163,106,.7)}\n.nf-ah__tab:focus-visible{outline:2px solid #c9a36a;outline-offset:3px}\n.nf-ah__tab[aria-selected=\"true\"]{background:#c9a36a;border-color:#c9a36a;color:#1c1c1c;box-shadow:0 2px 16px rgba(201,163,106,.26)}\n.nf-ah__panel[hidden]{display:none}\n.nf-ah__panel.is-in{animation:nfAhIn .3s cubic-bezier(.22,1,.36,1) both}\n@keyframes nfAhIn{from{opacity:0;transform:translateY(7px)}to{opacity:1;transform:none}}\n.nf-ah__row{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));column-gap:18px;row-gap:26px}\n.nf-ah__card{display:block;min-width:0;text-decoration:none;color:#fff}\n.nf-ah__media{position:relative;aspect-ratio:1/1;border-radius:6px;overflow:hidden;background:#26231f;box-shadow:inset 0 0 0 1px rgba(201,163,106,.12);transition:box-shadow .3s ease}\n.nf-ah__media img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .45s cubic-bezier(.22,1,.36,1)}\n.nf-ah__card:hover .nf-ah__media{box-shadow:inset 0 0 0 1px rgba(201,163,106,.34)}\n.nf-ah__card:hover .nf-ah__media img{transform:scale(1.045)}\n.nf-ah__name{font-family:var(--heading-font-family);font-size:14px;line-height:1.35;margin:12px 0 5px;color:#fff;height:2.7em;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;transition:color .22s ease}\n.nf-ah__card:hover .nf-ah__name{color:#f0e4d2}\n.nf-ah__price{margin:0;font:600 12.5px/1 Inter,sans-serif;color:#c9a36a}\n.nf-ah__badge{position:absolute;top:8px;left:8px;z-index:2;background:#e32c2b;color:#fff;border-radius:999px;padding:5px 9px;font:700 9.5px/1 Inter,sans-serif;letter-spacing:.07em;text-transform:uppercase;pointer-events:none}\n.nf-ah__was{margin-left:7px;color:#9c918a;font-weight:500;text-decoration:line-through}\n.nf-ah__leaves{position:absolute;inset:0;z-index:0;pointer-events:none}\n.nf-ah__gut{position:absolute;top:0;bottom:0;width:calc((100% - min(2400px,82%)) / 2);overflow:hidden}\n.nf-ah__gut--l{left:0}\n.nf-ah__gut--r{right:0}\n.nf-ah__lf{position:absolute;display:block;height:auto;width:clamp(34px,3.4vw,66px);opacity:.9;transform:rotate(var(--r0,0deg));filter:drop-shadow(0 3px 6px rgba(0,0,0,.35))}\n.nf-ah__lf--sm{width:clamp(24px,2.4vw,46px)}\n.nf-ah__lf--float{animation:nfAhSway 10s ease-in-out infinite;will-change:transform}\n@keyframes nfAhSway{0%,100%{transform:translate3d(0,0,0) rotate(var(--r0,0deg))}50%{transform:translate3d(5px,9px,0) rotate(calc(var(--r0,0deg) + 14deg))}}\n.nf-ah__tree{position:absolute;bottom:0;left:50%;width:min(90%,220px);height:auto;transform:translateX(-50%);filter:drop-shadow(0 6px 14px rgba(0,0,0,.4))}\n.nf-ah__pk{position:absolute;bottom:4px;right:4%;width:min(78%,170px);height:auto;z-index:2;filter:drop-shadow(0 6px 12px rgba(0,0,0,.45))}\n.nf-ah__pk--sm{right:auto;left:2%;bottom:2px;width:min(46%,100px);z-index:1}\n.nf-ah__acorn{position:absolute;bottom:2px;right:1%;z-index:3;width:clamp(16px,1.5vw,28px);height:auto;transform:rotate(18deg);opacity:.95}\n.nf-ah__corner{display:none}\n@media(max-width:899px){\n.nf-ah__corner{display:block;position:absolute;top:14px;right:12px;width:92px;height:84px;z-index:0;pointer-events:none}\n.nf-ah__corner svg{position:absolute;display:block;height:auto;filter:drop-shadow(0 3px 6px rgba(0,0,0,.4))}\n.nf-ah__corner-pk{right:0;bottom:0;width:64px}\n.nf-ah__corner-lf{left:0;top:4px;width:34px;transform:rotate(-22deg)}\n.nf-ah__corner-lf2{left:30px;top:0;width:24px;transform:rotate(18deg)}\n}\n@media(prefers-reduced-motion:reduce){.nf-ah__lf--float{animation:none}}\n@media(max-width:1499px){\n.nf-ah__row{grid-template-columns:repeat(4,minmax(0,1fr));column-gap:16px;row-gap:24px}\n}\n@media(max-width:899px){\n.nf-ah{padding:40px 0 44px}\n.nf-ah__leaves{display:none}\n.nf-ah__title{font-size:clamp(28px,7.4vw,38px)}\n.nf-ah__intro{max-width:100%;flex:1 1 100%}\n.nf-ah__rule{margin:20px 0 16px}\n.nf-ah__tabs{gap:7px;margin-bottom:16px}\n.nf-ah__tab{padding:10px 15px;font-size:10.5px}\n.nf-ah__row{grid-template-columns:repeat(2,minmax(0,1fr));column-gap:12px;row-gap:20px}\n}\n@media(prefers-reduced-motion:reduce){.nf-ah__media img{transition:none}.nf-ah__media{transition:none}.nf-ah__panel.is-in{animation:none}}\n@media(max-width:749px){.nf-ah__row{display:grid;grid-auto-flow:column;grid-template-columns:none;grid-template-rows:repeat(2,auto);grid-auto-columns:44%;column-gap:12px;row-gap:18px;overflow-x:auto;overscroll-behavior-x:contain;scroll-snap-type:x mandatory;scroll-padding-left:16px;padding-bottom:6px;-webkit-overflow-scrolling:touch}.nf-ah__row::-webkit-scrollbar{display:none}.nf-ah__row{scrollbar-width:none}.nf-ah__card{scroll-snap-align:start}.nf-ah__tabs{overflow-x:auto;flex-wrap:nowrap;scrollbar-width:none}.nf-ah__tabs::-webkit-scrollbar{display:none}}</style>\n<svg width=\"0\" height=\"0\" aria-hidden=\"true\" focusable=\"false\" style=\"position:absolute;width:0;height:0;overflow:hidden\">\n  <defs>\n    <linearGradient id=\"nf-ah-g-red\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\"><stop offset=\"0\" stop-color=\"#f08a3c\"/><stop offset=\".55\" stop-color=\"#d8522a\"/><stop offset=\"1\" stop-color=\"#a8301c\"/></linearGradient>\n    <linearGradient id=\"nf-ah-g-gold\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\"><stop offset=\"0\" stop-color=\"#f6cf5c\"/><stop offset=\".6\" stop-color=\"#e9a23c\"/><stop offset=\"1\" stop-color=\"#c9732a\"/></linearGradient>\n    <linearGradient id=\"nf-ah-g-oak\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\"><stop offset=\"0\" stop-color=\"#d9a045\"/><stop offset=\"1\" stop-color=\"#8e4f20\"/></linearGradient>\n    <linearGradient id=\"nf-ah-g-pk\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\"><stop offset=\"0\" stop-color=\"#f6a044\"/><stop offset=\"1\" stop-color=\"#cc5a1e\"/></linearGradient>\n    <linearGradient id=\"nf-ah-g-pkd\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\"><stop offset=\"0\" stop-color=\"#d8662a\"/><stop offset=\"1\" stop-color=\"#8f3314\"/></linearGradient>\n    <linearGradient id=\"nf-ah-g-pkh\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\"><stop offset=\"0\" stop-color=\"#ffba62\"/><stop offset=\"1\" stop-color=\"#e2762a\"/></linearGradient>\n    <linearGradient id=\"nf-ah-g-nut\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\"><stop offset=\"0\" stop-color=\"#d49a4a\"/><stop offset=\"1\" stop-color=\"#8a5222\"/></linearGradient>\n    <symbol id=\"nf-ah-maple\" viewBox=\"0 0 100 110\"><path fill=\"url(#nf-ah-g-red)\" d=\"M50 3l7 18 10-6-3 22 15-10-3 9 18-3-8 14 10 6-24 13 3 11-20-4-2 11h-6l-2-11-20 4 3-11L4 53l10-6-8-14 18 3-3-9 15 10-3-22 10 6z\"/><path fill=\"none\" stroke=\"#6e1f10\" stroke-opacity=\".5\" stroke-width=\"1.4\" stroke-linecap=\"round\" d=\"M50 80V12M50 62l36-24M50 62L14 38M50 71l24 2M50 71l-24 2\"/><path fill=\"none\" stroke=\"#6b3a1c\" stroke-width=\"2.2\" stroke-linecap=\"round\" d=\"M50 80c0 12-2 20-6 28\"/></symbol>\n    <symbol id=\"nf-ah-maple-y\" viewBox=\"0 0 100 110\"><path fill=\"url(#nf-ah-g-gold)\" d=\"M50 3l7 18 10-6-3 22 15-10-3 9 18-3-8 14 10 6-24 13 3 11-20-4-2 11h-6l-2-11-20 4 3-11L4 53l10-6-8-14 18 3-3-9 15 10-3-22 10 6z\"/><path fill=\"none\" stroke=\"#7a4516\" stroke-opacity=\".45\" stroke-width=\"1.4\" stroke-linecap=\"round\" d=\"M50 80V12M50 62l36-24M50 62L14 38M50 71l24 2M50 71l-24 2\"/><path fill=\"none\" stroke=\"#6b3a1c\" stroke-width=\"2.2\" stroke-linecap=\"round\" d=\"M50 80c0 12-2 20-6 28\"/></symbol>\n    <symbol id=\"nf-ah-oak\" viewBox=\"0 0 60 110\"><path fill=\"url(#nf-ah-g-oak)\" d=\"M30 4c6 0 8 6 6 10 6-2 10 2 8 8-4 4-6 4-6 6 6-2 12 2 10 8-2 4-6 4-8 6 6 0 12 4 10 10-2 6-8 6-10 6 4 2 8 6 6 12-2 4-8 4-12 2l-2 8H28l-2-8c-4 2-10 2-12-2-2-6 2-10 6-12-2 0-8 0-10-6-2-6 4-10 10-10-2-2-6-2-8-6-2-6 4-10 10-8 0-2-2-2-6-6-2-6 2-10 8-8-2-4 0-10 6-10z\"/><path fill=\"none\" stroke=\"#5e3214\" stroke-opacity=\".55\" stroke-width=\"1.5\" stroke-linecap=\"round\" d=\"M30 10v94M30 30l8-4M30 30l-8-4M30 46l10-4M30 46l-10-4M30 62l8-4M30 62l-8-4\"/></symbol>\n    <symbol id=\"nf-ah-ginkgo\" viewBox=\"0 0 60 64\"><path fill=\"url(#nf-ah-g-gold)\" d=\"M30 40C20 39 10 34 5 26 2 21 6 13 13 8c5-4 11-6 16-7l1 15 1-15c5 1 11 3 16 7 7 5 11 13 8 18-5 8-15 13-25 14z\"/><path fill=\"none\" stroke=\"#8a5a1a\" stroke-opacity=\".4\" stroke-width=\"1\" d=\"M30 40L12 14M30 40L20 8M30 40l10-32M30 40l18-26\"/><path d=\"M30 40v22\" stroke=\"#6b3a1c\" stroke-width=\"2\" fill=\"none\" stroke-linecap=\"round\"/></symbol>\n    <symbol id=\"nf-ah-acorn\" viewBox=\"0 0 40 56\"><path fill=\"url(#nf-ah-g-nut)\" d=\"M20 54c-7 0-12.6-5.8-12.6-13.2 0-4.8 2.4-9 6-11.4 2-1.4 4.4-2 6.6-2s4.6.6 6.6 2c3.6 2.4 6 6.6 6 11.4C32.6 48.2 27 54 20 54z\"/><ellipse cx=\"15\" cy=\"38\" rx=\"2.4\" ry=\"5\" fill=\"#f3d2a0\" opacity=\".35\"/><path fill=\"#6b4424\" d=\"M5 24c0-3.2 6.7-5.8 15-5.8s15 2.6 15 5.8c0 3.6-6.7 7-15 7S5 27.6 5 24z\"/><path fill=\"none\" stroke=\"#3f2614\" stroke-width=\".9\" opacity=\".7\" d=\"M9 22l5 7M15 20l5 10M21 19.5l5 10M27 20l4 8M12 29l6-9M18 30l6-10M24 30l6-9\"/><path d=\"M20 19V7c0-2 2-4 5-4\" stroke=\"#4a2e18\" stroke-width=\"2.2\" fill=\"none\" stroke-linecap=\"round\"/></symbol>\n    <symbol id=\"nf-ah-pumpkin\" viewBox=\"0 0 140 112\"><ellipse cx=\"34\" cy=\"72\" rx=\"30\" ry=\"34\" fill=\"url(#nf-ah-g-pkd)\"/><ellipse cx=\"106\" cy=\"72\" rx=\"30\" ry=\"34\" fill=\"url(#nf-ah-g-pkd)\"/><ellipse cx=\"52\" cy=\"70\" rx=\"28\" ry=\"38\" fill=\"url(#nf-ah-g-pk)\"/><ellipse cx=\"88\" cy=\"70\" rx=\"28\" ry=\"38\" fill=\"url(#nf-ah-g-pk)\"/><ellipse cx=\"70\" cy=\"70\" rx=\"21\" ry=\"39\" fill=\"url(#nf-ah-g-pkh)\"/><path fill=\"none\" stroke=\"#7a2a0e\" stroke-opacity=\".4\" stroke-width=\"1.6\" d=\"M52 34c-9 20-9 54 0 72M88 34c9 20 9 54 0 72\"/><ellipse cx=\"63\" cy=\"52\" rx=\"4.5\" ry=\"12\" fill=\"#ffe2b8\" opacity=\".32\"/><path fill=\"#6f5530\" d=\"M65 34c0-10 2-19 10-26l5 4c-6 6-7 13-6 22z\"/><path fill=\"none\" stroke=\"#7d8636\" stroke-width=\"2\" stroke-linecap=\"round\" d=\"M77 14c11-7 22-1 18 7-3 6-10 2-6-2\"/><path fill=\"#76803a\" d=\"M79 24c10-9 25-6 30 3-10 5-22 5-30-3z\"/><path fill=\"none\" stroke=\"#4f5a22\" stroke-width=\"1\" d=\"M81 24c9 0 18 1 26 3\"/></symbol>\n    <symbol id=\"nf-ah-tree\" viewBox=\"0 0 200 284\"><ellipse cx=\"100\" cy=\"280\" rx=\"74\" ry=\"4\" fill=\"#c9a36a\" opacity=\".14\"/><path fill=\"#4d3423\" d=\"M86 282c4-32 6-68 4-96-10-10-26-18-40-28l5-5c13 7 25 13 36 19-1-16-5-32-15-48l5-3c11 15 17 29 19 43 6-20 16-34 32-44l4 4c-15 12-25 28-28 48 14-8 30-18 42-30l4 4c-13 14-29 26-44 38-3 30-1 66 4 98z\"/><g opacity=\".95\"><circle cx=\"100\" cy=\"150\" r=\"30\" fill=\"#9c321b\"/><circle cx=\"60\" cy=\"140\" r=\"34\" fill=\"#b8401f\"/><circle cx=\"145\" cy=\"135\" r=\"34\" fill=\"#c24a24\"/><circle cx=\"50\" cy=\"106\" r=\"27\" fill=\"#e07a33\"/><circle cx=\"156\" cy=\"102\" r=\"27\" fill=\"#eeb04a\"/><circle cx=\"100\" cy=\"110\" r=\"42\" fill=\"#d9642c\"/><circle cx=\"76\" cy=\"88\" r=\"32\" fill=\"#e8923a\"/><circle cx=\"126\" cy=\"84\" r=\"34\" fill=\"#dd7a2f\"/><circle cx=\"132\" cy=\"54\" r=\"24\" fill=\"#c9541f\"/><circle cx=\"72\" cy=\"60\" r=\"24\" fill=\"#d6922f\"/><circle cx=\"100\" cy=\"60\" r=\"34\" fill=\"#f0ad45\"/><circle cx=\"100\" cy=\"32\" r=\"20\" fill=\"#f6c65a\"/></g><g fill=\"#ffd98a\" opacity=\".35\"><circle cx=\"90\" cy=\"46\" r=\"5\"/><circle cx=\"64\" cy=\"82\" r=\"4\"/><circle cx=\"120\" cy=\"74\" r=\"4.5\"/><circle cx=\"146\" cy=\"96\" r=\"3.5\"/><circle cx=\"44\" cy=\"102\" r=\"3\"/></g><g fill=\"#6e2412\" opacity=\".28\"><circle cx=\"112\" cy=\"140\" r=\"6\"/><circle cx=\"70\" cy=\"150\" r=\"5\"/><circle cx=\"150\" cy=\"148\" r=\"5\"/></g><path fill=\"#d8522a\" d=\"M40 274c4-5 10-5 13 0-4 4-9 4-13 0z\"/><path fill=\"#e9a23c\" d=\"M150 276c4-6 11-5 14 1-5 3-10 3-14-1z\"/><path fill=\"#b8401f\" d=\"M122 278c3-4 8-4 10 0-3 3-7 3-10 0z\"/></symbol>\n  </defs>\n</svg>\n<section class=\"nf-ah\" data-nf-ah aria-labelledby=\"nf-ah-title\">\n  <div class=\"nf-ah__leaves\" aria-hidden=\"true\">\n    <div class=\"nf-ah__gut nf-ah__gut--l\">\n      <svg class=\"nf-ah__lf nf-ah__lf--float\" viewBox=\"0 0 100 110\" style=\"top:7%;left:14%;--r0:-18deg;animation-duration:9s\"><use href=\"#nf-ah-maple\"></use></svg>\n      <svg class=\"nf-ah__lf nf-ah__lf--sm nf-ah__lf--float\" viewBox=\"0 0 60 64\" style=\"top:25%;left:58%;--r0:14deg;animation-duration:11s;animation-delay:-3s\"><use href=\"#nf-ah-ginkgo\"></use></svg>\n      <svg class=\"nf-ah__lf nf-ah__lf--sm nf-ah__lf--float\" viewBox=\"0 0 60 110\" style=\"top:40%;left:18%;--r0:24deg;animation-duration:10s;animation-delay:-6s\"><use href=\"#nf-ah-oak\"></use></svg>\n      <svg class=\"nf-ah__tree\" viewBox=\"0 0 200 284\"><use href=\"#nf-ah-tree\"></use></svg>\n    </div>\n    <div class=\"nf-ah__gut nf-ah__gut--r\">\n      <svg class=\"nf-ah__lf nf-ah__lf--float\" viewBox=\"0 0 100 110\" style=\"top:8%;right:16%;--r0:16deg;animation-duration:10s;animation-delay:-2s\"><use href=\"#nf-ah-maple-y\"></use></svg>\n      <svg class=\"nf-ah__lf nf-ah__lf--sm nf-ah__lf--float\" viewBox=\"0 0 100 110\" style=\"top:28%;right:56%;--r0:-22deg;animation-duration:8.5s;animation-delay:-5s\"><use href=\"#nf-ah-maple\"></use></svg>\n      <svg class=\"nf-ah__lf nf-ah__lf--sm nf-ah__lf--float\" viewBox=\"0 0 60 110\" style=\"top:45%;right:18%;--r0:-10deg;animation-duration:12s;animation-delay:-7s\"><use href=\"#nf-ah-oak\"></use></svg>\n      <svg class=\"nf-ah__acorn\" viewBox=\"0 0 40 56\"><use href=\"#nf-ah-acorn\"></use></svg>\n      <svg class=\"nf-ah__pk nf-ah__pk--sm\" viewBox=\"0 0 140 112\"><use href=\"#nf-ah-pumpkin\"></use></svg>\n      <svg class=\"nf-ah__pk\" viewBox=\"0 0 140 112\"><use href=\"#nf-ah-pumpkin\"></use></svg>\n    </div>\n  </div>\n  <div class=\"nf-ah__corner\" aria-hidden=\"true\">\n    <svg class=\"nf-ah__corner-lf\" viewBox=\"0 0 100 110\"><use href=\"#nf-ah-maple\"></use></svg>\n    <svg class=\"nf-ah__corner-lf2\" viewBox=\"0 0 60 64\"><use href=\"#nf-ah-ginkgo\"></use></svg>\n    <svg class=\"nf-ah__corner-pk\" viewBox=\"0 0 140 112\"><use href=\"#nf-ah-pumpkin\"></use></svg>\n  </div>\n<div class=\"nf-ah__wrap\">\n    <div class=\"nf-ah__head\">\n      <div class=\"nf-ah__intro\">\n        <p class=\"nf-ah__eyebrow\">Seasonal edit</p>\n        <h2 class=\"nf-ah__title\" id=\"nf-ah-title\">Autumn at Home</h2>\n        <p class=\"nf-ah__copy\">The light goes early now. Warm brass and bronze, amber and smoked glass, walnut and rattan, chunky knit throws in rust and ochre, candles and dried stems, and a lantern for the path home.</p>\n      </div>\n      <a class=\"nf-ah__cta\" href=\"{{ nf_ah.url }}\">Shop the collection</a>\n    </div>\n    <div class=\"nf-ah__rule\"></div>\n    <div class=\"nf-ah__tabs\" role=\"tablist\" aria-label=\"Autumn at Home categories\">\n      {%- for nf_key in nf_keys -%}\n      <button type=\"button\" class=\"nf-ah__tab\" role=\"tab\" id=\"nf-ah-t-{{ nf_key }}\" aria-controls=\"nf-ah-p-{{ nf_key }}\" aria-selected=\"{% if forloop.first %}true{% else %}false{% endif %}\" tabindex=\"{% if forloop.first %}0{% else %}-1{% endif %}\">{{ nf_names[forloop.index0] }}</button>\n      {%- endfor -%}\n    </div>\n    <div class=\"nf-ah__panels\">\n      {%- for nf_key in nf_keys -%}\n        {%- assign nf_lim = nf_limits[forloop.index0] | plus: 0 -%}\n        {%- assign nf_first = forloop.first -%}\n        {%- assign nf_src = nf_ah -%}{%- if nf_key == 'inflatables' -%}{%- assign nf_src = collections['halloween-inflatables'] -%}{%- elsif nf_key == 'halloween' -%}{%- assign nf_src = collections['halloween-decor'] -%}{%- elsif nf_key == 'fall' -%}{%- assign nf_src = collections['fall-decor'] -%}{%- elsif nf_key == 'soft' -%}{%- assign nf_src = collections['soft-furnishings'] -%}{%- elsif nf_key == 'fragrance' -%}{%- assign nf_src = collections['home-fragrance'] -%}{%- endif -%}{%- capture nf_cards -%}\n          {%- assign shown = 0 -%}\n          {%- for product in nf_src.products -%}\n            {%- if shown >= nf_lim -%}{%- break -%}{%- endif -%}\n            {%- assign bucket = '' -%}\n            {%- if product.tags contains 'hw-inflatables' -%}{%- assign bucket = 'inflatables' -%}{%- elsif product.tags contains 'hw-decor' -%}{%- assign bucket = 'halloween' -%}{%- elsif product.tags contains 'fall-decor' -%}{%- assign bucket = 'fall' -%}{%- elsif product.tags contains 'nav-outdoor-lighting' or product.tags contains 'nav-outdoor-wall-lights' -%}\n              {%- assign bucket = 'outdoor' -%}\n            {%- elsif product.tags contains 'nav-ceiling-light' -%}\n              {%- assign bucket = 'ceiling' -%}\n            {%- elsif product.tags contains 'nav-wall-lights' -%}\n              {%- assign bucket = 'wall' -%}\n            {%- elsif product.tags contains 'nav-lamps' -%}\n              {%- assign bucket = 'lamps' -%}\n            {%- elsif product.tags contains 'nav-soft-furnishings' or product.tags contains 'nav-poufs-floor-cushions' -%}\n              {%- assign bucket = 'soft' -%}\n            {%- elsif product.tags contains 'nav-home-fragrance' -%}\n              {%- assign bucket = 'fragrance' -%}\n            {%- elsif product.tags contains 'nav-decor' or product.tags contains 'nav-storage-shelves' -%}\n              {%- assign bucket = 'decor' -%}\n            {%- endif -%}\n            {%- if bucket == nf_key -%}\n              {%- assign shown = shown | plus: 1 -%}\n          <a class=\"nf-ah__card\" href=\"{{ product.url }}\">\n            {%- assign nf_cmp = product.compare_at_price_min -%}\n            {%- assign nf_sale = false -%}\n            {%- if nf_cmp > product.price_min -%}{%- assign nf_sale = true -%}{%- assign nf_off = nf_cmp | minus: product.price_min | times: 100.0 | divided_by: nf_cmp | round -%}{%- endif -%}\n            <div class=\"nf-ah__media\">\n              {%- if nf_sale -%}<span class=\"nf-ah__badge\">{{ nf_off }}% OFF</span>{%- endif -%}\n              {%- if product.featured_image -%}\n              <img src=\"{{ product.featured_image | image_url: width: 500 }}\"\n                   srcset=\"{{ product.featured_image | image_url: width: 340 }} 340w, {{ product.featured_image | image_url: width: 500 }} 500w, {{ product.featured_image | image_url: width: 700 }} 700w\"\n                   sizes=\"(max-width: 899px) 46vw, (max-width: 1499px) 22vw, 12vw\"\n                   alt=\"{{ product.featured_image.alt | default: product.title | escape }}\"\n                   width=\"500\" height=\"500\" loading=\"lazy\" decoding=\"async\">\n              {%- endif -%}\n            </div>\n            <h3 class=\"nf-ah__name\">{{ product.title }}</h3>\n            <p class=\"nf-ah__price\">{%- if product.price_varies -%}From {{ product.price_min | money }}{%- else -%}{{ product.price | money }}{%- endif -%}{%- if nf_sale -%}<s class=\"nf-ah__was\">{{ nf_cmp | money }}</s>{%- endif -%}</p>\n          </a>\n            {%- endif -%}\n          {%- endfor -%}\n        {%- endcapture -%}\n        {%- if nf_cards != blank -%}\n      <div class=\"nf-ah__panel\" id=\"nf-ah-p-{{ nf_key }}\" role=\"tabpanel\" aria-labelledby=\"nf-ah-t-{{ nf_key }}\" tabindex=\"0\"{% unless nf_first %} hidden{% endunless %}>\n        <div class=\"nf-ah__rowwrap\">\n          <div class=\"nf-ah__row\">{{ nf_cards }}</div>\n        </div>\n      </div>\n        {%- endif -%}\n      {%- endfor -%}\n    </div>\n  </div>\n</section>\n<script>\n(function(){\n  var root = document.querySelector('[data-nf-ah]');\n  if (!root || root.getAttribute('data-nf-ah-ready')) { return; }\n  root.setAttribute('data-nf-ah-ready', '1');\n  var tabs = Array.prototype.slice.call(root.querySelectorAll('[role=\"tab\"]'));\n  if (!tabs.length) { return; }\n  function panelOf(tab) { return document.getElementById(tab.getAttribute('aria-controls')); }\n  function select(index, moveFocus) {\n    for (var i = 0; i < tabs.length; i++) {\n      var on = (i === index);\n      var tab = tabs[i];\n      var panel = panelOf(tab);\n      tab.setAttribute('aria-selected', on ? 'true' : 'false');\n      tab.tabIndex = on ? 0 : -1;\n      if (!panel) { continue; }\n      panel.classList.remove('is-in');\n      if (on) {\n        panel.hidden = false;\n        (function (el) { setTimeout(function () { el.classList.add('is-in'); }, 0); })(panel);\n      } else {\n        panel.hidden = true;\n      }\n    }\n    if (moveFocus) { tabs[index].focus(); }\n  }\n  for (var i = 0; i < tabs.length; i++) {\n    (function (i) {\n      tabs[i].addEventListener('click', function () { select(i, false); });\n      tabs[i].addEventListener('keydown', function (e) {\n        var next = null;\n        var k = e.key;\n        if (k === 'ArrowRight' || k === 'ArrowDown') { next = (i + 1) % tabs.length; }\n        else if (k === 'ArrowLeft' || k === 'ArrowUp') { next = (i - 1 + tabs.length) % tabs.length; }\n        else if (k === 'Home') { next = 0; }\n        else if (k === 'End') { next = tabs.length - 1; }\n        if (next !== null) { e.preventDefault(); select(next, true); }\n      });\n    })(i);\n  }\n})();\n</script>\n{%- endif -%}\n"
      }
    },
