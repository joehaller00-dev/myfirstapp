    "custom_liquid_nfmosaic": {
      "type": "custom-liquid",
      "name": "NF Mosaic Collections",
      "settings": {
        "color_scheme": "scheme-2",
        "separate_section_with_border": false,
        "remove_vertical_spacing": true,
        "remove_horizontal_spacing": true,
        "liquid": "<style>\n.nf-mosaic{padding:26px 48px 44px;max-width:1500px;margin:0 auto}\n.nf-mosaic__head{display:flex;align-items:baseline;justify-content:space-between;gap:16px;margin-bottom:16px}\n.nf-mosaic__head h2{font-family:var(--heading-font-family);font-size:clamp(24px,2.4vw,34px);font-weight:360;margin:0;color:#1c1c1c}\n.nf-mosaic__head a{font-family:var(--heading-font-family);font-size:15px;color:#1c1c1c;text-decoration:underline;text-underline-offset:4px}\n.nf-mosaic__head a:hover{color:#c9a36a}\n.nf-mosaic__grid{display:grid;grid-template-columns:1.25fr 1fr 1fr;grid-auto-rows:minmax(240px,295px);gap:14px}\n.nf-mosaic__grid a{position:relative;display:block;border-radius:16px;overflow:hidden;text-decoration:none;background-size:cover;background-position:center;background-color:#efefed}\n.nf-mosaic__grid a::after{content:\"\";position:absolute;inset:0;background:linear-gradient(185deg,rgba(20,17,14,0) 45%,rgba(20,17,14,.52) 100%);transition:background .3s}\n.nf-mosaic__grid a:hover::after{background:linear-gradient(185deg,rgba(20,17,14,.1) 40%,rgba(20,17,14,.62) 100%)}\n.nf-mosaic__big{grid-row:1/3}\n.nf-mosaic__label{position:absolute;left:0;right:0;bottom:18px;z-index:1;text-align:center;color:#fff;font-family:var(--heading-font-family);font-size:21px;font-weight:400;letter-spacing:.04em;text-shadow:0 2px 14px rgba(0,0,0,.45)}\n.nf-mosaic__big-content{position:absolute;left:0;right:0;bottom:0;z-index:1;text-align:center;padding:0 26px 34px;color:#fff}\n.nf-mosaic__big-content h3{font-family:var(--heading-font-family);font-size:clamp(26px,2.6vw,38px);font-weight:340;margin:0 0 8px;color:#fff;text-shadow:0 2px 18px rgba(0,0,0,.5)}\n.nf-mosaic__big-content p{font:400 13px/1.5 Inter,sans-serif;opacity:.94;margin:0 0 16px;text-shadow:0 1px 10px rgba(0,0,0,.5)}\n.nf-mosaic__btn{display:inline-block;background:#fff;color:#1c1c1c;border-radius:999px;padding:14px 28px;font:600 11px/1 Inter,sans-serif;letter-spacing:.13em;text-transform:uppercase;transition:all .25s}\n.nf-mosaic__big:hover .nf-mosaic__btn{background:#c9a36a;color:#fff}\n@media(max-width:899px){\n.nf-mosaic{padding:10px 14px 28px}\n.nf-mosaic__head{margin-bottom:12px;padding:0 6px}\n.nf-mosaic__grid{grid-template-columns:1fr 1fr;grid-auto-rows:auto}\n.nf-mosaic__big{grid-column:1/3;grid-row:auto;min-height:330px}\n.nf-mosaic__grid a{min-height:168px}\n.nf-mosaic__label{font-size:16px;bottom:12px}\n.nf-mosaic__big-content{padding:0 18px 24px}\n}\n</style>\n<section class=\"nf-mosaic\">\n  <div class=\"nf-mosaic__head\">\n    <h2>Rooms That Glow</h2>\n    <a href=\"/collections/lighting\">Shop all lighting</a>\n  </div>\n  <div class=\"nf-mosaic__grid\">\n    <a class=\"nf-mosaic__big\" href=\"/collections/indoor-lighting\" data-nf-bg=\"https://cdn.shopify.com/s/files/1/0750/8380/8820/files/image_1787884583951_b1b47181_1787884584707_6539e8bc.png?width=1600\" aria-label=\"Shop the indoor lighting collection\">\n      <div class=\"nf-mosaic__big-content\">\n        <h3>The Indoor Collection</h3>\n        <p>Ceiling lights, lamps and warm glow for every room in the house.</p>\n        <span class=\"nf-mosaic__btn\">Shop Indoor Lighting</span>\n      </div>\n    </a>\n    <div class=\"nf-mosaic__tiles\">\n    <a href=\"/collections/chandeliers\" data-nf-bg=\"https://cdn.shopify.com/s/files/1/0750/8380/8820/files/image_1787884607586_3a3d7eb9_1787884608148_d3a69553.png?width=1000\"><span class=\"nf-mosaic__label\">Chandeliers</span></a>\n    <a href=\"/collections/ceiling-light\" data-nf-bg=\"https://cdn.shopify.com/s/files/1/0750/8380/8820/files/image_1787889040588_7ebe35b8_1787889041237_7b0375fb_a29e3d50-c88a-4d6d-937b-511d1f7001c1.png?width=1000\"><span class=\"nf-mosaic__label\">Ceiling Lights</span></a>\n    <a href=\"/collections/wall-lights\" data-nf-bg=\"https://cdn.shopify.com/s/files/1/0750/8380/8820/files/cone-wall-light-bedroom.webp?width=1000\"><span class=\"nf-mosaic__label\">Wall Lights</span></a>\n    <a href=\"/collections/home-fragrance\" data-nf-bg=\"https://cdn.shopify.com/s/files/1/0750/8380/8820/files/image_1787885515324_42a1d124_1787885515692_5e12f1ec.png?width=1000\"><span class=\"nf-mosaic__label\">Home Fragrance</span></a>\n  </div>\n  </div>\n</section>",
        "text_alignment": "start"
      }
    },
