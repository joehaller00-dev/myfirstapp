    "faq": {
      "type": "nf-pro-faq",
      "settings": {
        "bg": "white",
        "anchor": "faq",
        "eyebrow": "",
        "heading": "Common questions",
        "text": "",
        "show_email": true,
        "open_first": false
      },
      "blocks": {
        "q1": {
          "type": "faq",
          "settings": {
            "q": "How big should a chandelier be for my room?",
            "a": "<p>Add the length and width of the room in feet. The total, read in inches, is a good diameter. A 14 by 12 foot room suits a chandelier about 26 inches across.</p>"
          }
        },
        "q2": {
          "type": "faq",
          "settings": {
            "q": "How big should a chandelier be over a dining table?",
            "a": "<p>Choose a diameter between one half and two thirds of the table width, so no one bumps it when they stand up. Hang the bottom about 30 to 36 inches above the tabletop with an 8 foot ceiling, and about 3 inches higher for each extra foot.</p>"
          }
        },
        "q3": {
          "type": "faq",
          "settings": {
            "q": "What is a drop length?",
            "a": "<p>The drop is the chain or cord between the ceiling and the top of the fixture. On a staircase or in a tall foyer, a custom drop puts the chandelier exactly where you want it, for example level with the upstairs landing or centered in a tall window.</p>"
          }
        },
        "q4": {
          "type": "faq",
          "settings": {
            "q": "How low can a chandelier hang in a foyer or over stairs?",
            "a": "<p>Keep the bottom at least 7 feet above the floor or the stair beneath it. In a two story foyer, many people line it up with the upper floor so it reads well from both levels.</p>"
          }
        },
        "q5": {
          "type": "faq",
          "settings": {
            "q": "Can my ceiling hold a large chandelier?",
            "a": "<p>Large fixtures need a ceiling box rated for their weight, and heavy pieces often need extra bracing. We share the fixture weight in your quote so your electrician can plan the install. Please have a licensed electrician install any hardwired light.</p>"
          }
        },
        "q6": {
          "type": "faq",
          "settings": {
            "q": "Can I return a custom size chandelier?",
            "a": "<p>Custom pieces are made for your order, so they are final sale and cannot be returned for a change of mind. If anything arrives damaged or has a defect, we replace it or refund it. Email photos to info@norafurnish.com as soon as you can and we will put it right.</p>"
          }
        }
      },
      "block_order": [
        "q1",
