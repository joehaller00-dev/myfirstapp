          }
        },
        "q_custom_5": {
          "type": "question",
          "settings": {
            "question": "Do you offer bulk or volume pricing?",
            "answer": "<p>Yes. Send your full list on our <a href=\"/pages/bulk-project-orders\">Bulk and Project Orders</a> page and we price every piece together, with pricing that reflects your quantities. There is no minimum order, we reply within 2 business days, and there is no commitment until you approve the quote.</p>",
            "keywords": "bulk wholesale volume quantity many discount large order",
