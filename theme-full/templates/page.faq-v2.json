        "q_orders_1": {
          "type": "question",
          "settings": {
            "question": "Can I cancel my order?",
            "answer": "<p>Yes. Orders can be canceled within <strong>24 hours</strong> of being placed. Email <a href=\"mailto:info@norafurnish.com\">info@norafurnish.com</a> with your order number as soon as possible within that window to request the cancellation.</p>",
            "keywords": "cancel cancellation stop change order mistake",
            "anchor": "",
            "show_payment_icons": false
          }
        },
        "q_orders_2": {
          "type": "question",
          "settings": {
            "question": "How do I track my order?",
            "answer": "<p>As soon as your order ships you receive a confirmation email with a shipment notification, your tracking number and instructions for following the delivery. You can check its progress at any time on our <a href=\"/apps/trackyourorder\">Track Your Order</a> page.</p>",
            "keywords": "tracking track where is my order shipped status number",
            "anchor": "",
            "show_payment_icons": false
          }
        },
        "q_orders_3": {
          "type": "question",
          "settings": {
            "question": "What is the daily order cutoff?",
            "answer": "<p>The cutoff is <strong>5:00 PM (CST), Monday through Friday</strong>. Orders placed after that time begin processing on the next business day, which can add one business day to your delivery estimate.</p>",
            "keywords": "cutoff deadline time same day processing weekend",
            "anchor": "",
            "show_payment_icons": false
          }
        },
        "q_orders_4": {
          "type": "question",
          "settings": {
            "question": "How do I contact customer support?",
            "answer": "<p>Email us at <a href=\"mailto:info@norafurnish.com\">info@norafurnish.com</a> or use the form on our <a href=\"/pages/contact\">Contact</a> page. Our team works Monday through Friday, 9:00 AM to 5:00 PM (CST), and we aim to reply to every message within 1 to 2 business days.</p>",
            "keywords": "contact support help email customer service hours reach talk",
            "anchor": "",
            "show_payment_icons": false
          }
        },
        "q_orders_5": {
          "type": "question",
          "settings": {
            "question": "Where is Nora Furnish based?",
            "answer": "<p>Nora Furnish is a U.S. based online retailer. All prices and transactions are in U.S. dollars (USD), and we currently ship only within the United States.</p>",
            "keywords": "location located based usa united states company",
            "anchor": "",
            "show_payment_icons": false
          }
        },
        "topic_shipping": {
          "type": "topic",
          "settings": {
            "title": "Shipping and Delivery",
            "anchor": "shipping",
            "icon": "truck"
          }
        },
        "q_shipping_1": {
          "type": "question",
          "settings": {
            "question": "How long does delivery take?",
            "answer": "<p>Most orders arrive within <strong>6 to 9 business days</strong> of the order date.</p><ul><li><strong>Processing:</strong> 1 to 2 business days while your order is prepared, packed and handed to the carrier.</li><li><strong>Transit:</strong> 5 to 7 business days, depending on your destination and the carrier.</li></ul><p>Business days do not include weekends or holidays. Full details are in our <a href=\"/policies/shipping-policy\">Shipping Policy</a>.</p>",
            "keywords": "delivery time how long shipping time arrive days handling transit",
            "anchor": "",
            "show_payment_icons": false
          }
        },
        "q_shipping_2": {
          "type": "question",
          "settings": {
            "question": "Is shipping free?",
            "answer": "<p>Yes. Standard shipping is free on every order delivered within the United States, with no minimum purchase and no extra shipping charges at checkout.</p>",
            "keywords": "free shipping cost fee charge price minimum",
            "anchor": "",
            "show_payment_icons": false
          }
        },
        "q_shipping_3": {
          "type": "question",
          "settings": {
            "question": "Do you ship outside the United States?",
            "answer": "<p>Not at the moment. We currently ship only to addresses within the United States.</p>",
            "keywords": "international worldwide canada overseas abroad ship outside",
            "anchor": "",
            "show_payment_icons": false
          }
        },
        "q_shipping_4": {
          "type": "question",
          "settings": {
            "question": "Which carriers deliver my order?",
            "answer": "<p>We ship with <strong>USPS, UPS and FedEx</strong>. The carrier depends on your location and what is available for your delivery.</p>",
            "keywords": "carrier usps ups fedex courier post",
            "anchor": "",
            "show_payment_icons": false
          }
        },
        "q_shipping_5": {
          "type": "question",
          "settings": {
            "question": "What if my package is late, lost or stops updating?",
            "answer": "<p>Email <a href=\"mailto:info@norafurnish.com\">info@norafurnish.com</a> with your order number as soon as you notice. We work directly with the carrier to resolve delays, lost packages and tracking problems, and to make sure your package reaches you safely.</p>",
            "keywords": "late delayed lost missing stolen tracking not updating problem",
            "anchor": "",
            "show_payment_icons": false
          }
        },
        "topic_returns": {
          "type": "topic",
          "settings": {
            "title": "Returns and Refunds",
            "anchor": "returns",
            "icon": "return"
          }
        },
        "q_returns_1": {
          "type": "question",
          "settings": {
            "question": "What is your return policy?",
            "answer": "<p>You can request a return within <strong>30 days</strong> of the date your order is delivered. Items must be unused, in their original condition and in the original packaging. Read the full <a href=\"/policies/refund-policy\">Refund Policy</a>.</p>",
            "keywords": "return policy 30 days send back eligible",
            "anchor": "",
            "show_payment_icons": false
          }
        },
        "q_returns_2": {
          "type": "question",
          "settings": {
            "question": "How do I start a return?",
            "answer": "<ul><li><strong>Email us first.</strong> Send your order number and the reason for the return to <a href=\"mailto:info@norafurnish.com\">info@norafurnish.com</a>. Please contact us before sending anything back.</li><li><strong>Pack it up.</strong> Repack the item securely in its original packaging with all tags, accessories and documentation.</li><li><strong>Ship it back.</strong> Drop the parcel at your nearest carrier location, following the instructions in your return authorization email.</li></ul>",
            "keywords": "start return process how to return steps label authorization",
            "anchor": "",
            "show_payment_icons": false
          }
        },
        "q_returns_3": {
          "type": "question",
          "settings": {
            "question": "Who pays for return shipping?",
            "answer": "<p>If your item arrives damaged, defective, incorrect or harmed in transit, the return costs you nothing. If you ordered the wrong product, it did not meet your expectations or you simply changed your mind, the return shipping cost is yours.</p>",
            "keywords": "return shipping cost pay fee label change of mind",
            "anchor": "",
            "show_payment_icons": false
          }
        },
        "q_returns_4": {
          "type": "question",
          "settings": {
            "question": "What if my item arrives damaged or defective?",
            "answer": "<p>We send a replacement at no additional charge, and there is no return cost to you. Email <a href=\"mailto:info@norafurnish.com\">info@norafurnish.com</a> with your order number and a photo of the problem, then return the item within 30 days of delivery using the instructions we send you.</p>",
            "keywords": "damaged broken defective faulty wrong incorrect replacement cracked",
            "anchor": "",
            "show_payment_icons": false
          }
        },
        "q_returns_5": {
          "type": "question",
          "settings": {
            "question": "When will I receive my refund?",
            "answer": "<p>Once your return arrives we inspect it to make sure it meets the return conditions. After approval your refund is issued, and it usually takes <strong>5 to 7 business days</strong> to appear on your original payment method, depending on your bank or payment provider.</p>",
            "keywords": "refund money back how long when credit",
            "anchor": "",
            "show_payment_icons": false
          }
        },
        "q_returns_6": {
          "type": "question",
          "settings": {
            "question": "Can I exchange an item?",
            "answer": "<p>Yes. If you need a different size, color or product, email <a href=\"mailto:info@norafurnish.com\">info@norafurnish.com</a> and we will gladly help you with a quick exchange. Please contact us before sending anything back.</p>",
            "keywords": "exchange swap different size color",
            "anchor": "",
            "show_payment_icons": false
          }
        },
        "q_returns_7": {
          "type": "question",
          "settings": {
            "question": "Are any items not returnable?",
            "answer": "<p>Some products cannot be returned for hygiene or safety reasons. Any such item is clearly marked as non returnable in its product description.</p>",
            "keywords": "non returnable final sale hygiene safety exceptions",
            "anchor": "",
            "show_payment_icons": false
          }
        },
        "q_returns_8": {
          "type": "question",
          "settings": {
            "question": "Do your products come with a warranty?",
            "answer": "<p>Yes. Every item purchased from Nora Furnish comes with a <strong>30 day warranty</strong>. If a product turns out to be faulty, email <a href=\"mailto:info@norafurnish.com\">info@norafurnish.com</a> and we will send a replacement at no additional charge.</p>",
            "keywords": "warranty guarantee faulty stopped working",
            "anchor": "",
            "show_payment_icons": false
          }
        },
