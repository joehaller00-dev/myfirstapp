{%- comment -%}
  NF-DIRECTORY-V1 (2026-09-11): hero of the /collections directory (templates/list-collections.json).
  Dark charcoal band (the Ideas & Guides family) with a live "find a collection" filter that works across every
  nf-directory-* section on the page, jump pills and a collage of three bright store photos (Files, by filename).
  Pressing Enter with one match opens it; otherwise the form falls through to the product search.
  Styles: assets/nf-directory.css. Behaviour: assets/nf-directory.js.
{%- endcomment -%}
{{- 'nf-directory.css' | asset_url | stylesheet_tag -}}
<script src="{{ 'nf-directory.js' | asset_url }}" defer></script>
<section class="nfd nfd-hero nfd-on-dark" aria-labelledby="nfd-h1-{{ section.id }}" data-nfd-hero>
  <div class="nfd-wrap nfd-hero__grid">
    <div class="nfd-hero__copy">
      {%- if section.settings.eyebrow != blank -%}<p class="nfd-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h1 class="nfd-h1" id="nfd-h1-{{ section.id }}">{{ section.settings.heading | escape }}</h1>
      {%- if section.settings.text != blank -%}<p class="nfd-lead">{{ section.settings.text | escape }}</p>{%- endif -%}
      <form class="nfd-search" role="search" action="{{ routes.search_url }}" method="get" data-nfd-form>
        <label class="nfd-vh" for="nfd-q-{{ section.id }}">Find a collection</label>
        <span class="nfd-search__icon" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.6-3.6"/></svg></span>
        <input id="nfd-q-{{ section.id }}" type="search" name="q" autocomplete="off" spellcheck="false" enterkeyhint="search" placeholder="{{ section.settings.placeholder | escape }}" data-nfd-input>
        <button type="button" class="nfd-search__clear" data-nfd-clear hidden aria-label="Clear"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6 6 18"/></svg></button>
      </form>
      <p class="nfd-status" data-nfd-status aria-live="polite">{{ section.settings.status | escape }}</p>
      {%- if section.blocks.size > 0 -%}
        <nav class="nfd-jump" aria-label="On this page">
          <ul role="list">
            {%- for block in section.blocks -%}
              {%- if block.settings.label != blank -%}<li {{ block.shopify_attributes }}><a class="nfd-pill" href="{{ block.settings.url | escape }}">{{ block.settings.label | escape }}</a></li>{%- endif -%}
            {%- endfor -%}
          </ul>
        </nav>
      {%- endif -%}
    </div>
    <div class="nfd-hero__art" aria-hidden="true">
      {%- for i in (1..3) -%}
        {%- assign k = 'img' | append: i -%}
        {%- assign f = section.settings[k] -%}
        {%- assign im = blank -%}
        {%- if f != blank -%}{%- assign im = images[f] -%}{%- if im.width == blank or im.width == 0 -%}{%- assign im = blank -%}{%- endif -%}{%- endif -%}
        <figure class="nfd-hero__fig nfd-hero__fig--{{ i }}">
          {%- if im != blank -%}
            {%- if i == 1 -%}
              {{- im | image_url: width: 900 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '360,540,720,900', sizes: '(min-width: 1000px) 22vw, 50vw', alt: '' -}}
            {%- else -%}
              {{- im | image_url: width: 900 | image_tag: loading: 'eager', widths: '360,540,720,900', sizes: '(min-width: 1000px) 22vw, 50vw', alt: '' -}}
            {%- endif -%}
          {%- endif -%}
        </figure>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "NF directory hero",
  "class": "nfd-section nfd-section--hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Collection directory" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop every collection" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "placeholder", "label": "Filter placeholder", "default": "Find a collection, for example chandeliers or wall sconces" },
    { "type": "text", "id": "status", "label": "Status line before the script runs" },
    { "type": "text", "id": "img1", "label": "Tall image filename in Files" },
    { "type": "text", "id": "img2", "label": "Top right image filename" },
    { "type": "text", "id": "img3", "label": "Bottom right image filename" }
  ],
  "blocks": [
    {
      "type": "jump",
      "name": "Jump link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "text", "id": "url", "label": "Link", "info": "An anchor such as #rooms" }
      ]
    }
  ],
  "max_blocks": 8
}
{% endschema %}
