{%- comment -%}
  NF-CART-PAGE-V3 (2026-09-12): the /cart page, redesigned after the Ideas & Guides page. Strong heading, clean line
  items with big images, a charcoal and gold order summary card (Buy 2+ progress line, totals, gold checkout, trust
  row), "Pairs well with" and the "What happens next" band. Phones get a slim sticky checkout bar until the summary
  card is on screen. Styles: assets/nf-cart-page.css (loaded here only). Pairs and the progress fill: assets/nf-cart-v2.js.
  Cart functions kept: quantity (Prestige line-item-quantity reloads this page after /cart/change.js), remove links,
  order note (cart-note), discount field (section setting), app blocks, dynamic checkout buttons, checkout.
  Backup of the previous file: scratchpad newbuild/polish2/backup/sections__main-cart.liquid
{%- endcomment -%}
{{- 'nf-cart-page.css' | asset_url | stylesheet_tag -}}
{%- liquid
  assign nfcp_trust = '<span><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M1.6 5.6h11v9h-11z" stroke="currentColor" stroke-width="1.2"/><path d="M12.6 8.4h4.2l3.6 3.4v2.8h-7.8z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/><circle cx="6" cy="17.4" r="1.7" stroke="currentColor" stroke-width="1.2"/><circle cx="16.7" cy="17.4" r="1.7" stroke="currentColor" stroke-width="1.2"/></svg>Free US shipping</span><span><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20 12a8 8 0 1 1-2.3-5.6" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/><path d="M20 3.5V8h-4.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>30 day returns</span><span><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="5" y="10.5" width="14" height="9" rx="1.5" stroke="currentColor" stroke-width="1.3"/><path d="M8 10.5V8a4 4 0 0 1 8 0v2.5" stroke="currentColor" stroke-width="1.3"/></svg>Secure checkout</span>'
  assign nfcp_continue = settings.cart_empty_cart_link | default: routes.all_products_collection_url
  assign nfcp_trust_sum = nfcp_trust | remove: '<span><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M1.6 5.6h11v9h-11z" stroke="currentColor" stroke-width="1.2"/><path d="M12.6 8.4h4.2l3.6 3.4v2.8h-7.8z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/><circle cx="6" cy="17.4" r="1.7" stroke="currentColor" stroke-width="1.2"/><circle cx="16.7" cy="17.4" r="1.7" stroke="currentColor" stroke-width="1.2"/></svg>Free US shipping</span>'
  assign nfcp_logo = images['e0cf0a7c-0740-403b-9bd3-70fc7e7f6dc9.png']
-%}
<div class="nfcp-page color-scheme color-scheme--{{ section.settings.color_scheme.id }}">
  {%- if cart.empty? -%}
    <div class="nfcp nfcp--empty">
      <svg class="nf-cv2-lamp nfcp-lamp" viewBox="0 0 92 116" aria-hidden="true" focusable="false"><defs><radialGradient id="nfcpGlowGrad" cx="50%" cy="30%" r="62%"><stop offset="0" stop-color="#c9a36a" stop-opacity="0.9"/><stop offset="0.45" stop-color="#c9a36a" stop-opacity="0.38"/><stop offset="1" stop-color="#c9a36a" stop-opacity="0"/></radialGradient></defs><ellipse class="nf-cv2-lamp__glow" cx="46" cy="88" rx="45" ry="30" fill="url(#nfcpGlowGrad)"/><path class="nf-cv2-lamp__line" d="M37 2.5h18M46 2.5v41"/><path class="nf-cv2-lamp__shade" d="M41 43.5h10l1.6 6.2C63.5 52.6 71.4 62 73 75.5H19c1.6-13.5 9.5-22.9 20.4-25.8z"/><path class="nf-cv2-lamp__bulb" d="M39.5 75.5a6.5 6.5 0 0 0 13 0z"/></svg>
      <h1 class="nfcp-title nfcp-title--empty">Your cart</h1>
      <p class="nfcp-empty__text">Your cart is empty. Start with a favorite, or pick a room to light.</p>
      <p class="nf-cv2-offer nfcp-offer"><span class="nf-cv2-offer__dot" aria-hidden="true"></span>Buy 2 items, save 10%. Buy 3 or more, save 15%</p>
      <div class="nfcp-empty__actions">
        <a class="nfcp-btn" href="{{ routes.collections_url }}/best-sellers">Shop best sellers<span class="nfcp-arrow" aria-hidden="true">&rarr;</span></a>
        <a class="nfcp-link" href="{{ routes.collections_url }}">Browse all categories</a>
      </div>
      <div class="nfcp-tiles">
        {%- capture nfcp_tiles -%}best-sellers|Best Sellers~ceiling-light|Ceiling Lights~outdoor-lighting|Outdoor Lighting{%- endcapture -%}
        {%- assign nfcp_tiles = nfcp_tiles | split: '~' -%}
        {%- for t in nfcp_tiles -%}
          {%- assign tp = t | split: '|' -%}
          {%- assign nf_img = collections[tp[0]].featured_image -%}
          <a class="nfcp-tile" href="{{ routes.collections_url }}/{{ tp[0] }}">
            <span class="nfcp-tile__img">{%- if nf_img -%}{{ nf_img | image_url: width: 720 | image_tag: loading: 'lazy', sizes: '(max-width: 749px) 45vw, 300px', widths: '360,480,720', alt: '' }}{%- endif -%}</span>
            <span class="nfcp-tile__label">{{ tp[1] }}</span>
          </a>
        {%- endfor -%}
      </div>
      <div class="nfcp-trust nfcp-trust--light">{{ nfcp_trust }}</div>
    </div>
  {%- else -%}
    <div class="nfcp nf-cv2-cartpage">
      <header class="nfcp-head">
        <div>
          <p class="nfcp-eyebrow">{% if cart.item_count == 1 %}1 item{% else %}{{ cart.item_count }} items{% endif %}</p>
          <h1 class="nfcp-title">Your cart</h1>
        </div>
        <a class="nfcp-link" href="{{ nfcp_continue }}">{{ 'cart.general.continue_shopping' | t }}</a>
      </header>

      <form action="{{ routes.cart_url }}" method="POST" class="nfcp-form" id="nfcp-form">
        <input type="hidden" name="attributes[products_mobile_grid_mode]" value="">
        <input type="hidden" name="attributes[products_desktop_grid_mode]" value="">

        <div class="nfcp-grid">
          <div class="nfcp-main">
            <ul class="nfcp-items" role="list">
              {%- for line_item in cart.items -%}
                <li class="nfcp-item">
                  <line-item class="nfcp-line">
                    <a class="nfcp-line__img" href="{{ line_item.url }}" tabindex="-1" aria-hidden="true">
                      {%- if line_item.image != blank -%}
                        {{- line_item.image | image_url: width: 480 | image_tag: loading: 'lazy', sizes: '(max-width: 749px) 96px, 150px', widths: '96,150,192,300,480', alt: '' -}}
                      {%- endif -%}
                    </a>
                    <div class="nfcp-line__info">
                      {%- if line_item.url != blank -%}
                        <a class="nfcp-line__title" href="{{ line_item.url }}">{{ line_item.product.title | default: line_item.title }}</a>
                      {%- else -%}
                        <p class="nfcp-line__title">{{ line_item.product.title | default: line_item.title }}</p>
                      {%- endif -%}
                      {%- unless line_item.product.has_only_default_variant or line_item.gift_card -%}
                        <p class="nfcp-line__opts">
                          {%- for o in line_item.options_with_values -%}
                            <span>{{ o.name | escape }}: {{ o.value | escape }}</span>
                          {%- endfor -%}
                        </p>
                      {%- endunless -%}
                      <div class="nfcp-line__price">{%- render 'price-list', line_item: line_item, context: 'line_item' -%}</div>
                      {%- if line_item.selling_plan_allocation -%}
                        <p class="nfcp-line__meta">{{ line_item.selling_plan_allocation.selling_plan.name }}</p>
                      {%- endif -%}
                      {%- unless line_item.properties == empty -%}
                        <ul class="nfcp-line__meta" role="list">
                          {%- for property in line_item.properties -%}
                            {%- assign first_character_in_key = property.first | truncate: 1, '' -%}
                            {%- if property.last == blank or first_character_in_key == '_' -%}{%- continue -%}{%- endif -%}
                            <li>
                              {%- if property.last contains '/uploads/' or property.last contains '/files/' -%}
                                <a href="{{ property.last }}">{{ property.last | split: '/' | last }}</a>
                              {%- else -%}
                                {{ property.first }}: {{ property.last }}
                              {%- endif -%}
                            </li>
                          {%- endfor -%}
                        </ul>
                      {%- endunless -%}
                      {%- if line_item.line_level_discount_allocations != blank -%}
                        <ul class="nfcp-line__disc" role="list">
                          {%- for discount_allocation in line_item.line_level_discount_allocations -%}
                            <li class="discount-badge text-xs">
                              {%- render 'icon' with 'discount', width: 12 -%}
                              {{ discount_allocation.discount_application.title }} (Save {{ discount_allocation.amount | money }})
                              {%- if section.settings.allow_discount_application and discount_allocation.discount_application.type != '' -%}
                                <cart-discount-remove-button discount-code="{{ discount_allocation.discount_application.title }}" class="h-stack align-center">
                                  <button type="button">{%- render 'icon' with 'close', width: 8 -%}</button>
                                </cart-discount-remove-button>
                              {%- endif -%}
                            </li>
                          {%- endfor -%}
                        </ul>
                      {%- endif -%}
                    </div>
                    <line-item-quantity class="nfcp-line__qty">
                      {%- render 'quantity-selector', line_item: line_item, size: 'sm' -%}
                      <a href="{{ line_item.url_to_remove }}" class="nfcp-remove" aria-label="{{ 'cart.order.remove_with_title' | t: title: line_item.title | escape }}">
                        {{- 'cart.order.remove' | t -}}
                      </a>
                    </line-item-quantity>
                    <div class="nfcp-line__total">
                      {%- if line_item.original_line_price > line_item.final_line_price -%}
                        <s class="nfcp-line__was">{{ line_item.original_line_price | money }}</s>
                      {%- endif -%}
                      <span>
                        {%- if settings.currency_code_enabled -%}{{- line_item.final_line_price | money_with_currency -}}{%- else -%}{{- line_item.final_line_price | money -}}{%- endif -%}
                      </span>
                    </div>
                  </line-item>
                </li>
              {%- endfor -%}
            </ul>

            {%- if section.settings.show_cart_note -%}
              <details class="nf-cv2-note nfcp-note"{% if cart.note != blank %} open{% endif %}>
                <summary><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 20h4L19 9l-4-4L4 16z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/><path d="M13.5 6.5l4 4" stroke="currentColor" stroke-width="1.3"/></svg>Add a note</summary>
                <cart-note class="cart-note">
                  {%- assign order_note = 'cart.general.add_order_note' | t -%}
                  {%- assign placeholder = 'cart.general.note_placeholder' | t -%}
                  {%- render 'input', name: 'note', multiline: 3, label: order_note, value: cart.note, placeholder: placeholder, show_label_as_block: true -%}
                </cart-note>
              </details>
            {%- endif -%}
          </div>

          <aside class="nfcp-sum" aria-labelledby="nfcp-sum-h">
            {%- comment -%} NF-CART-SUM-V4 (2026-09-14, owner: the brown checkout button looked cheap and the card felt bare; add the logo and
              a delivery note: usual delivery 6 to 9 business days, large orders may vary). Styles at the end of assets/nf-cart-page.css. {%- endcomment -%}
            <div class="nfcp-sum__brand">
              {%- if nfcp_logo != blank -%}<img src="{{ nfcp_logo | image_url: width: 360 }}" alt="{{ shop.name | escape }}" width="150" height="{{ 150 | divided_by: nfcp_logo.aspect_ratio | round }}" loading="eager" decoding="async">{%- else -%}<span class="nfcp-sum__brand-t">{{ shop.name | escape }}</span>{%- endif -%}
            </div>
            <h2 class="nfcp-sum__title" id="nfcp-sum-h">Order summary</h2>
            {%- render 'nf-cart-progress' -%}

            <dl class="nfcp-rows">
              <div class="nfcp-row"><dt>{{ 'cart.general.subtotal' | t }}</dt><dd>{%- if settings.currency_code_enabled -%}{{- cart.items_subtotal_price | money_with_currency -}}{%- else -%}{{- cart.items_subtotal_price | money -}}{%- endif -%}</dd></div>
              {%- for discount_application in cart.cart_level_discount_applications -%}
                <div class="nfcp-row nfcp-row--save">
                  <dt>
                    {{- discount_application.title -}}
                    {%- if section.settings.allow_discount_application and discount_application.type != '' -%}
                      <cart-discount-remove-button discount-code="{{ discount_application.title | escape }}" class="nfcp-row__x">
                        <button type="button" aria-label="Remove {{ discount_application.title | escape }}">{%- render 'icon' with 'close', width: 8 -%}</button>
                      </cart-discount-remove-button>
                    {%- endif -%}
                  </dt>
                  <dd>Save {{ discount_application.total_allocated_amount | money }}</dd>
                </div>
              {%- endfor -%}
              <div class="nfcp-row"><dt>Shipping</dt><dd>Free</dd></div>
              {%- if section.settings.show_order_weight -%}
                <div class="nfcp-row"><dt>{{ 'cart.general.weight' | t }}</dt><dd>{{ cart.total_weight | weight_with_unit }}</dd></div>
              {%- endif -%}
              <div class="nfcp-row nfcp-row--total"><dt>{{ 'cart.general.total' | t }}</dt><dd>{{- cart.total_price | money_with_currency -}}</dd></div>
            </dl>

            <div class="nfcp-ship">
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M1.6 5.6h11v9h-11z" stroke="currentColor" stroke-width="1.3"/><path d="M12.6 8.4h4.2l3.6 3.4v2.8h-7.8z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/><circle cx="6" cy="17.4" r="1.7" stroke="currentColor" stroke-width="1.3"/><circle cx="16.7" cy="17.4" r="1.7" stroke="currentColor" stroke-width="1.3"/></svg>
              <p class="nfcp-ship__t">Free shipping on every US order</p>
              <p class="nfcp-ship__d">Usual delivery is 6 to 9 business days. Large orders may take a little longer.</p>
            </div>

            <p class="nfcp-sum__note">Taxes are calculated at checkout.</p>

            {%- if section.settings.allow_discount_application -%}
              <div class="nfcp-sum__disc">{%- render 'cart-discount' -%}</div>
            {%- endif -%}

            {%- comment -%}Give apps a special hook to add features on the recap (such as capturing delivery dates){%- endcomment -%}
            {%- for block in section.blocks -%}
              {%- if block.type == '@app' -%}
                {%- render block -%}
              {%- endif -%}
            {%- endfor -%}

            <noscript>
              <button type="submit" class="nfcp-update">{{ 'cart.general.update_cart' | t }}</button>
            </noscript>

            {%- comment -%}NF-MAILNOTE-V1{%- endcomment -%}
            <p class="nf-mailnote"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg><span>Watch your email after checkout. Nora Furnish sends the confirmation there, and on made to fit or larger pieces a short question before the order ships.</span></p>
            <button type="submit" name="checkout" class="nfcp-checkout" data-nfcp-checkout>
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="5" y="10.5" width="14" height="9" rx="1.5" stroke="currentColor" stroke-width="1.4"/><path d="M8 10.5V8a4 4 0 0 1 8 0v2.5" stroke="currentColor" stroke-width="1.4"/></svg>
              {{ 'cart.general.checkout' | t }}
            </button>

            {%- if section.settings.show_accelerated_buttons and additional_checkout_buttons -%}
              <div class="additional-checkout-buttons additional-checkout-buttons--vertical nfcp-sum__dyn">
                {{- content_for_additional_checkout_buttons -}}
              </div>
            {%- endif -%}

            <div class="nfcp-trust">{{ nfcp_trust_sum }}</div>
          </aside>
        </div>
      </form>

      {%- comment -%} NF-CART-V2: "Pairs well with" (filled by assets/nf-cart-v2.js) and the "What happens next" band.
        Shipping emails are OFF by owner decision (2026-08-30), so tracking points to the Track Your Order page. {%- endcomment -%}
      <div class="nf-cv2-pairs nf-cv2-pairs--page nfcp-pairs" data-nf-cv2-pairs data-product-id="{{ cart.items.first.product_id }}" data-cart-key="{{ cart.items | map: 'variant_id' | join: '-' }}" hidden>
        <p class="nf-cv2-pairs__title">Pairs well with</p>
        <div class="nf-cv2-pairs__slot nf-cv2-pairs__list"></div>
      </div>

      <div class="nf-cv2-next nfcp-next">
        <p class="nf-cv2-next__heading">What happens next</p>
        <ul class="nf-cv2-next__grid">
          <li class="nf-cv2-next__item"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M1.6 5.6h11v9h-11z" stroke="currentColor" stroke-width="1.2"/><path d="M12.6 8.4h4.2l3.6 3.4v2.8h-7.8z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/><circle cx="6" cy="17.4" r="1.7" stroke="currentColor" stroke-width="1.2"/><circle cx="16.7" cy="17.4" r="1.7" stroke="currentColor" stroke-width="1.2"/></svg><div><p class="nf-cv2-next__title">Free US shipping</p><p class="nf-cv2-next__text">Every order ships free within the US. Usual delivery is 6 to 9 business days, and large orders may take a little longer.</p></div></li>
          <li class="nf-cv2-next__item"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 21s-6.5-6.1-6.5-11A6.5 6.5 0 0 1 18.5 10c0 4.9-6.5 11-6.5 11z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/><circle cx="12" cy="10" r="2.3" stroke="currentColor" stroke-width="1.2"/></svg><div><p class="nf-cv2-next__title">Track it any time</p><p class="nf-cv2-next__text">Track your order any time from the <a href="/apps/trackyourorder">Track Your Order</a> page.</p></div></li>
          <li class="nf-cv2-next__item"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20 12a8 8 0 1 1-2.3-5.6" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/><path d="M20 3.5V8h-4.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg><div><p class="nf-cv2-next__title">30 day returns</p><p class="nf-cv2-next__text">Not right for your room? Send it back within 30 days.</p></div></li>
        </ul>
      </div>

      <div class="nfcp-mbar" data-nfcp-mbar>
        <div class="nfcp-mbar__sum"><span>{{ 'cart.general.total' | t }}</span><strong>{{- cart.total_price | money -}}</strong></div>
        <button type="submit" form="nfcp-form" name="checkout" class="nfcp-mbar__btn">{{ 'cart.general.checkout' | t }}</button>
      </div>
      <script>
        (function () {
          var bar = document.querySelector('[data-nfcp-mbar]');
          var btn = document.querySelector('[data-nfcp-checkout]');
          if (!bar || !btn || !('IntersectionObserver' in window)) return;
          new IntersectionObserver(function (es) {
            var e = es[0];
            // show the bar while the real checkout button is still below the fold
            var on = !e.isIntersecting && e.boundingClientRect.top > 0;
            if (bar.classList.contains('is-on') !== on) bar.classList.toggle('is-on', on);
            var html = document.documentElement; if (html.classList.contains('nfcp-bar-on') !== on) html.classList.toggle('nfcp-bar-on', on);
          }).observe(btn);
        })();
      </script>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:sections.main_cart.name",
  "class": "shopify-section--main-cart",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "show_cart_note",
      "label": "t:sections.main_cart.show_cart_note",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "allow_discount_application",
      "label": "t:sections.main_cart.allow_discount_application",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_order_weight",
      "label": "t:sections.main_cart.show_order_weight",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_shipping_text",
      "label": "t:sections.main_cart.show_shipping_text",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_accelerated_buttons",
      "label": "t:sections.main_cart.show_accelerated_buttons",
      "info": "t:sections.main_cart.show_accelerated_buttons_info",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_shipping_estimator",
      "label": "t:sections.main_cart.show_shipping_estimator",
      "default": true
    }
  ],

  "blocks": [{ "type": "@app" }]
}
{% endschema %}
