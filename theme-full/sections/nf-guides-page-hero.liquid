{%- comment -%}
  nf-guides-page-hero : Ideas & Guides resource center hero (templates/page.ideas-and-guides.json). 2026-09-11.
  Dark photo hero with the page title, the dark and gold button family and an "on this page" jump bar.
  The photo is a Shopify Files image picked by FILENAME through the images global.
  Styles: assets/nf-guides-page.css. Behaviour: assets/nf-guides-page.js (both shared by every nf-guides-page-* section).
{%- endcomment -%}
{{- 'nf-guides-page.css' | asset_url | stylesheet_tag -}}
<script src="{{ 'nf-guides-page.js' | asset_url }}" defer></script>
{%- liquid
  assign nfg_img = blank
  if section.settings.image_file != blank
    assign nfg_img = images[section.settings.image_file]
  endif
  assign nfg_title = section.settings.heading | default: page.title
-%}
<section class="nfg nfg-hero nfg-on-dark" aria-labelledby="nfg-hero-h-{{ section.id }}">
  <div class="nfg-hero__media" aria-hidden="true">
    {%- if nfg_img != blank and nfg_img.width > 0 -%}
      {{- nfg_img | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '640,960,1280,1600,2000,2400', sizes: '100vw', alt: '' -}}
    {%- endif -%}
  </div>
  <div class="nfg-wrap nfg-hero__inner">
    <div class="nfg-hero__copy">
      {%- if section.settings.eyebrow != blank -%}<p class="nfg-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h1 class="nfg-h1" id="nfg-hero-h-{{ section.id }}">{{ nfg_title | escape }}</h1>
      {%- if section.settings.text != blank -%}<p class="nfg-lead">{{ section.settings.text | escape }}</p>{%- endif -%}
      <div class="nfg-actions">
        {%- if section.settings.btn1_label != blank -%}
          <a class="nfg-btn nfg-btn--gold" href="{{ section.settings.btn1_url | escape }}">{{ section.settings.btn1_label | escape }}<span class="nfg-arrow" aria-hidden="true">&rarr;</span></a>
        {%- endif -%}
        {%- if section.settings.btn2_label != blank -%}
          <a class="nfg-btn nfg-btn--outline" href="{{ section.settings.btn2_url | escape }}">{{ section.settings.btn2_label | escape }}</a>
        {%- endif -%}
        {%- if section.settings.link_label != blank -%}
          <a class="nfg-link" href="{{ section.settings.link_url | escape }}">{{ section.settings.link_label | escape }}<span class="nfg-arrow" aria-hidden="true">&rarr;</span></a>
        {%- endif -%}
      </div>
    </div>
    {%- if section.blocks.size > 0 -%}
      <nav class="nfg-jump" aria-label="{{ section.settings.jump_label | default: 'On this page' | escape }}">
        <span class="nfg-jump__label" aria-hidden="true">{{ section.settings.jump_label | default: 'On this page' | escape }}</span>
        <ul role="list">
          {%- for block in section.blocks -%}
            {%- if block.settings.label != blank -%}
              <li {{ block.shopify_attributes }}><a class="nfg-jump__a" href="{{ block.settings.url | escape }}">{{ block.settings.label | escape }}</a></li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "NF guides hero",
  "class": "nfg-section nfg-section--hero",
  "settings": [
    { "type": "text", "id": "image_file", "label": "Image filename in Files", "info": "For example nf-discover-hero.jpg" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Nora Furnish Resource Center" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Leave blank to use the page title." },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "btn1_label", "label": "Gold button label" },
    { "type": "text", "id": "btn1_url", "label": "Gold button link", "info": "A path such as /pages/lighting-catalog or an anchor such as #stories" },
    { "type": "text", "id": "btn2_label", "label": "Outline button label" },
    { "type": "text", "id": "btn2_url", "label": "Outline button link" },
    { "type": "text", "id": "link_label", "label": "Text link label" },
    { "type": "text", "id": "link_url", "label": "Text link link" },
    { "type": "text", "id": "jump_label", "label": "Jump bar label", "default": "On this page" }
  ],
  "blocks": [
    {
      "type": "jump",
      "name": "Jump link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "text", "id": "url", "label": "Link", "info": "Usually an anchor such as #reviews" }
      ]
    }
  ],
  "max_blocks": 8
}
{% endschema %}
