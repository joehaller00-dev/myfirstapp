{%- comment -%}
  nf-guides-page-reviews : review zone for the Ideas & Guides page. 2026-09-11.
  One "review" block per real customer review. Photo, quote, name and date in a block all come from the SAME row of
  the review source file (REVIEWS_REBUILD_v3.csv); never pair a photo with another review's words.
  Photos are re-hosted on our own CDN as Files named nf-review-zone-NN (AliExpress URLs render blank on the storefront).
  Layout: block 1 is a featured quote beside its photo, the rest form a masonry wall (CSS columns). On phones the wall
  shows the first six and a "Show more reviews" button (assets/nf-guides-page.js). These are different reviews from the
  homepage carousel (templates/index.json, custom_liquid_nfproof).
{%- endcomment -%}
{{- 'nf-guides-page.css' | asset_url | stylesheet_tag -}}
{%- capture nfg_star -%}<svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M10 1.6l2.6 5.3 5.8.8-4.2 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.6 7.7l5.8-.8z"/></svg>{%- endcapture -%}
{%- capture nfg_stars -%}{{ nfg_star }}{{ nfg_star }}{{ nfg_star }}{{ nfg_star }}{{ nfg_star }}{%- endcapture -%}
{%- assign nfg_show = section.settings.mobile_count | default: 6 -%}
<section class="nfg nfg-sec nfg-reviews"{% if section.settings.anchor != blank %} id="{{ section.settings.anchor | handle }}"{% endif %} aria-labelledby="nfg-rv-h-{{ section.id }}">
  <div class="nfg-wrap">
    <header class="nfg-head">
      <div class="nfg-head__main">
        {%- if section.settings.eyebrow != blank -%}<p class="nfg-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2 class="nfg-h2" id="nfg-rv-h-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.text != blank -%}<p class="nfg-lead">{{ section.settings.text | escape }}</p>{%- endif -%}
      </div>
      {%- if section.settings.summary != blank -%}
        <p class="nfg-rv-sum"><span class="nfg-stars" role="img" aria-label="Rated 5 out of 5">{{ nfg_stars }}</span><span>{{ section.settings.summary | escape }}</span></p>
      {%- endif -%}
    </header>

    {%- for block in section.blocks limit: 1 -%}
      {%- liquid
        assign r_img = blank
        if block.settings.image_file != blank
          assign r_img = images[block.settings.image_file]
        endif
        assign r_prod = block.settings.product
      -%}
      <figure class="nfg-rv-feature" {{ block.shopify_attributes }}>
        <div class="nfg-rv-feature__photo">
          {%- if r_img != blank and r_img.width > 0 -%}
            {{- r_img | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '480,720,960,1200,1400', sizes: '(max-width: 899px) 92vw, 40vw', alt: block.settings.alt -}}
          {%- endif -%}
        </div>
        <figcaption class="nfg-rv-feature__body nfg-on-dark">
          <span class="nfg-rv-feature__mark" aria-hidden="true">&ldquo;</span>
          <span class="nfg-stars" role="img" aria-label="Rated 5 out of 5">{{ nfg_stars }}</span>
          <blockquote class="nfg-rv-feature__q"><p>{{ block.settings.quote | escape }}</p></blockquote>
          <p class="nfg-rv-feature__who">{%- if block.settings.name == blank or block.settings.name == 'Anonymous' -%}<span class="nf-vbadge"><svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><circle cx="8" cy="8" r="7.2"/><path d="M4.9 8.3l2.1 2.1 4.2-4.4"/></svg>Verified Buyer</span>{%- else -%}<span class="nfg-rv__name">{{ block.settings.name | escape }}</span>{%- endif -%}{% if block.settings.date != blank %}<span class="nfg-rv__date">{{ block.settings.date | date: '%B %Y' }}</span>{% endif %}</p>
          {%- if r_prod != blank -%}
            <a class="nfg-link" href="{{ r_prod.url }}">{{ r_prod.title | escape }}<span class="nfg-arrow" aria-hidden="true">&rarr;</span></a>
          {%- endif -%}
        </figcaption>
      </figure>
    {%- endfor -%}

    {%- if section.blocks.size > 1 -%}
      <ul class="nfg-rv-wall" role="list" data-nfg-rv>
        {%- for block in section.blocks offset: 1 -%}
          {%- liquid
            assign r_img = blank
            if block.settings.image_file != blank
              assign r_img = images[block.settings.image_file]
            endif
            assign r_prod = block.settings.product
          -%}
          <li class="nfg-rv{% if forloop.index > nfg_show %} nfg-rv--extra{% endif %}" {{ block.shopify_attributes }}>
            <figure class="nfg-rv__fig">
              <div class="nfg-rv__photo">
                {%- if r_img != blank and r_img.width > 0 -%}
                  {{- r_img | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300,450,600,900', sizes: '(max-width: 699px) 46vw, (max-width: 1199px) 30vw, 300px', alt: block.settings.alt -}}
                {%- endif -%}
              </div>
              <figcaption class="nfg-rv__body">
                <span class="nfg-stars" role="img" aria-label="Rated 5 out of 5">{{ nfg_stars }}</span>
                <blockquote class="nfg-rv__q"><p>{{ block.settings.quote | escape }}</p></blockquote>
                <p class="nfg-rv__who">{%- if block.settings.name == blank or block.settings.name == 'Anonymous' -%}<span class="nf-vbadge"><svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><circle cx="8" cy="8" r="7.2"/><path d="M4.9 8.3l2.1 2.1 4.2-4.4"/></svg>Verified Buyer</span>{%- else -%}<span class="nfg-rv__name">{{ block.settings.name | escape }}</span>{%- endif -%}{% if block.settings.date != blank %}<span class="nfg-rv__date">{{ block.settings.date | date: '%b %Y' }}</span>{% endif %}</p>
                {%- if r_prod != blank -%}
                  <a class="nfg-rv__prod" href="{{ r_prod.url }}"><span>{{ r_prod.title | escape }}</span><span class="nfg-arrow" aria-hidden="true">&rarr;</span></a>
                {%- endif -%}
              </figcaption>
            </figure>
          </li>
        {%- endfor -%}
      </ul>
      {%- assign nfg_wall = section.blocks.size | minus: 1 -%}
      {%- if nfg_wall > nfg_show -%}
        <div class="nfg-rv-more">
          <button type="button" class="nfg-btn nfg-btn--line" data-nfg-rv-more aria-expanded="false">{{ section.settings.more_label | default: 'Show more reviews' | escape }}</button>
        </div>
      {%- endif -%}
    {%- endif -%}

    {%- if section.settings.cta_label != blank -%}
      <p class="nfg-rv-cta"><a class="nfg-link" href="{{ section.settings.cta_url | escape }}">{{ section.settings.cta_label | escape }}<span class="nfg-arrow" aria-hidden="true">&rarr;</span></a></p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "NF guides reviews",
  "class": "nfg-section nfg-section--reviews",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "reviews" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Customer reviews" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Real rooms, five stars" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "summary", "label": "Rating line" },
    { "type": "range", "id": "mobile_count", "label": "Wall cards shown on phones before the button", "min": 2, "max": 12, "step": 1, "default": 6 },
    { "type": "text", "id": "more_label", "label": "Show more label", "default": "Show more reviews" },
    { "type": "text", "id": "cta_label", "label": "Closing link label" },
    { "type": "text", "id": "cta_url", "label": "Closing link" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "paragraph", "content": "Photo, quote, name and date must all come from the same customer review." },
        { "type": "text", "id": "image_file", "label": "Photo filename in Files", "info": "For example nf-review-zone-01.webp" },
        { "type": "text", "id": "alt", "label": "Photo alt text" },
        { "type": "product", "id": "product", "label": "Product reviewed" },
        { "type": "textarea", "id": "quote", "label": "Review text, as written" },
        { "type": "text", "id": "name", "label": "Reviewer name, as shown in the source" },
        { "type": "text", "id": "date", "label": "Review date (YYYY-MM-DD)" }
      ]
    }
  ],
  "max_blocks": 20
}
{% endschema %}
