{%- comment -%}
  NF-PRO-V2 nf-pro2-quote (2026-09-11). The detailed quote sheet (snippets/nf-pro2-quote-form) with a "what happens
  next" panel. Replaces nf-pro-quote and nf-custom-quote on the 15 Professionals and custom service pages.
  On the three tool pages (tool checked) it also loads assets/nf-custom.js, which fills the Design details box.
{%- endcomment -%}
{{- 'nf-pro.css' | asset_url | stylesheet_tag -}}
{%- if section.settings.tool -%}{{- 'nf-custom.css' | asset_url | stylesheet_tag -}}{%- endif -%}
{{- 'nf-pro2.css' | asset_url | stylesheet_tag -}}
<script src="{{ 'nf-pro.js' | asset_url }}" defer></script>
<script src="{{ 'nf-pro2.js' | asset_url }}" defer></script>
{%- if section.settings.tool -%}<script src="{{ 'nf-custom.js' | asset_url }}" defer></script>{%- endif -%}
{%- liquid
  assign s = section.settings
  assign steps = s.steps | newline_to_br | split: '<br />'
  assign inc = s.include | newline_to_br | split: '<br />'
-%}
<section class="nfp nfp2 nfp2-quote nfp2--{{ s.bg | default: 'grey' }} nfp-sec" id="{{ s.anchor | default: 'quote' | handle }}" aria-labelledby="{{ section.id }}-h">
  <div class="nfp-wrap">
    <div class="nfp2-head">
      <div class="nfp2-head__main">
        {%- if s.eyebrow != blank -%}<p class="nfp2-eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
        <h2 class="nfp2-h2" id="{{ section.id }}-h">{{ s.heading | escape }}</h2>
        {%- if s.text != blank -%}<p class="nfp2-lead">{{ s.text | escape }}</p>{%- endif -%}
      </div>
    </div>
    <div class="nfp-quote nfp2-quote__grid">
      {%- render 'nf-pro2-quote-form',
        form_id: s.form_id, service: s.service, form_label: s.form_label, adjust: s.adjust, refs: s.refs,
        zone_placeholder: s.zone_placeholder, space_default: s.space_default, qty_label: s.qty_label,
        qty_placeholder: s.qty_placeholder, msg_placeholder: s.msg_placeholder, button_label: s.button_label,
        tool: s.tool, summary_label: s.summary_label, summary_help: s.summary_help, zip: s.zip
      -%}
      <aside class="nfp-aside nfp2-aside" aria-label="How quotes work">
        {%- if s.steps != blank -%}
          <div class="nfp-aside__box">
            <h3 class="nfp2-h4">{{ s.steps_title | escape }}</h3>
            <ol>
              {%- for st in steps -%}
                {%- assign stt = st | strip -%}
                {%- if stt == blank -%}{%- continue -%}{%- endif -%}
                {%- if stt contains ': ' -%}{%- assign sp = stt | split: ': ' -%}<li><strong>{{ sp[0] | escape }}</strong>{{ stt | remove_first: sp[0] | remove_first: ': ' | escape }}</li>{%- else -%}<li>{{ stt | escape }}</li>{%- endif -%}
              {%- endfor -%}
            </ol>
          </div>
        {%- endif -%}
        {%- if s.include != blank -%}
          <div class="nfp-aside__box">
            <h3 class="nfp2-h4">{{ s.include_title | escape }}</h3>
            <ul>{%- for i in inc -%}{%- assign it = i | strip -%}{%- if it != blank -%}<li>{{ it | escape }}</li>{%- endif -%}{%- endfor -%}</ul>
          </div>
        {%- endif -%}
        <div class="nfp-aside__box nfp2-aside__dark">
          <h3 class="nfp2-h4">Prefer to write to us?</h3>
          <p>Email is our only support line, and a real person answers it. Drawings and photos are always welcome.</p>
          <a class="nfp2-mail" href="mailto:info@norafurnish.com">info@norafurnish.com <span class="nfp-arrow" aria-hidden="true">&rarr;</span></a>
        </div>
      </aside>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "NF Pro quote sheet",
  "class": "nfp-shell",
  "settings": [
    { "type": "select", "id": "bg", "label": "Background", "default": "grey", "options": [ { "value": "grey", "label": "Light grey" }, { "value": "white", "label": "White" } ] },
    { "type": "text", "id": "anchor", "label": "Section anchor", "default": "quote" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Get started" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Request your custom quote" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "form_id", "label": "Form id", "default": "nf-quote-form" },
    { "type": "text", "id": "service", "label": "Service", "info": "Goes in the email subject after NFPRO quote request:" },
    { "type": "text", "id": "form_label", "label": "Form name in the email" },
    { "type": "textarea", "id": "adjust", "label": "What would you like to adjust", "info": "One per line: key|icon|Label. A 'Not sure yet, need guidance' tile is always added." },
    { "type": "textarea", "id": "refs", "label": "Reference labels for 'Seen in a project?'", "info": "One per line, matching the Application references on the page" },
    { "type": "text", "id": "zone_placeholder", "label": "Zone or area placeholder" },
    { "type": "text", "id": "space_default", "label": "Preselected space type", "info": "Exactly one of: Home, Rental property or several units, Hotel or guest house, Restaurant, cafe or bar, Office or workspace, Shop or showroom, Salon, spa or studio, Outdoor or garden, Event or venue, Other" },
    { "type": "text", "id": "qty_label", "label": "Quantity label", "default": "Quantity needed" },
    { "type": "text", "id": "qty_placeholder", "label": "Quantity placeholder" },
    { "type": "text", "id": "msg_placeholder", "label": "Message placeholder" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Get My Free Custom Quote" },
    { "type": "checkbox", "id": "tool", "label": "Page has a design tool", "default": false, "info": "Adds the Design details box that the tool fills in" },
    { "type": "text", "id": "summary_label", "label": "Design box label", "default": "Design details" },
    { "type": "text", "id": "summary_help", "label": "Design box help" },
    { "type": "checkbox", "id": "zip", "label": "Ask for ZIP code", "default": false },
    { "type": "text", "id": "steps_title", "label": "Steps title", "default": "What happens next" },
    { "type": "textarea", "id": "steps", "label": "Steps", "info": "One per line, 'Title: text'" },
    { "type": "text", "id": "include_title", "label": "List title", "default": "Helpful to include" },
    { "type": "textarea", "id": "include", "label": "List", "info": "One per line" }
  ]
}
{% endschema %}
