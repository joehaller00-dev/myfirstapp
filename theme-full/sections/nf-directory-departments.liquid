{%- comment -%}
  NF-DIRECTORY-V1 (2026-09-11): the departments of the /collections directory (templates/list-collections.json).
  Owner: "so that people can pick through any collection they want, with images." Each department is one row:
  a big bright department photo card (sticky on desktop) and, beside it, every collection inside the department as a
  picture tile (snippets/nf-directory-groups.liquid + nf-directory-tile.liquid), grouped in labelled sets.
  Outdoor Wall Lights (the 11th nav parent) is a set inside Outdoor Lighting with its own "All" tile.
  Tile photos: the collection image, else a bright product photo from inside it; dark ones are swapped through the
  img_overrides setting (handle=Files filename or handle=https CDN URL, one per line).
  Delight: the little pendant bulb on each department photo swings and lights up, and the photo warms, on hover.
  Counts are collection.all_products_count (what shoppers can see), never admin productsCount.
{%- endcomment -%}
{{- 'nf-directory.css' | asset_url | stylesheet_tag -}}
{%- assign nfd_anchor = section.settings.anchor | default: 'departments' -%}
{%- assign nfd_ov = section.settings.img_overrides -%}
<section class="nfd nfd-depts" id="{{ nfd_anchor }}" data-nfd-sec aria-labelledby="nfd-dh-{{ section.id }}">
  <div class="nfd-wrap">
    <div class="nfd-head">
      <div class="nfd-head__main">
        {%- if section.settings.eyebrow != blank -%}<p class="nfd-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2 class="nfd-h2" id="nfd-dh-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.text != blank -%}<p class="nfd-lead">{{ section.settings.text | escape }}</p>{%- endif -%}
      </div>
    </div>
    <nav class="nfd-deptnav" aria-label="Jump to a department">
      <ul role="list">
        {%- for block in section.blocks -%}
          {%- assign c = block.settings.collection -%}
          {%- if c == blank or c.all_products_count == 0 -%}{%- continue -%}{%- endif -%}
          <li><a class="nfd-dpill" href="#dept-{{ c.handle }}">{{ block.settings.title | default: c.title | escape }}</a></li>
        {%- endfor -%}
      </ul>
    </nav>
    <div class="nfd-depts__list">
      {%- for block in section.blocks -%}
        {%- assign c = block.settings.collection -%}
        {%- if c == blank or c.all_products_count == 0 -%}{%- continue -%}{%- endif -%}
        {%- assign d_title = block.settings.title | default: c.title -%}
        {%- assign d_img = blank -%}
        {%- if block.settings.image_file != blank -%}
          {%- assign d_img = images[block.settings.image_file] -%}
          {%- if d_img.width == blank or d_img.width == 0 -%}{%- assign d_img = blank -%}{%- endif -%}
        {%- endif -%}
        {%- if d_img == blank -%}{%- assign d_img = c.image | default: c.featured_image -%}{%- endif -%}
        {%- assign d_b = block.settings.brighten | default: 100 | divided_by: 100.0 -%}
        {%- capture d_sets -%}{%- render 'nf-directory-groups', groups: block.settings.groups, ov: nfd_ov -%}{%- endcapture -%}
        {%- assign d_n = d_sets | split: 'nfd-stile-li' | size | minus: 1 -%}
        <article class="nfd-dept{% if d_n <= 4 %} nfd-dept--few{% endif %}" id="dept-{{ c.handle }}" data-nfd-card data-nfd-k="{{ d_title | downcase | escape }} {{ block.settings.keywords | downcase | escape }}" {{ block.shopify_attributes }}>
          <div class="nfd-dept__lead">
            <a class="nfd-dept__media" href="{{ c.url }}" tabindex="-1" aria-hidden="true" style="--b: {{ d_b }};{% if block.settings.image_pos != blank %} --pos: {{ block.settings.image_pos | escape }};{% endif %}">
              {%- if d_img != blank -%}
                {%- if forloop.index <= 1 -%}
                  {{- d_img | image_url: width: 900 | image_tag: loading: 'eager', widths: '360,540,720,900', sizes: '(min-width: 1000px) 26vw, 100vw', alt: '', class: 'nfd-dept__img' -}}
                {%- else -%}
                  {{- d_img | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360,540,720,900', sizes: '(min-width: 1000px) 26vw, 100vw', alt: '', class: 'nfd-dept__img' -}}
                {%- endif -%}
              {%- endif -%}
              <span class="nfd-dept__glow"></span>
              <span class="nfd-bulb"><i></i></span>
            </a>
            <div class="nfd-dept__body">
              <h3 class="nfd-dept__t"><a href="{{ c.url }}">{{ d_title | escape }}</a></h3>
              <p class="nfd-dept__n">{{ c.all_products_count }} pieces{% if d_n > 0 %} &middot; {{ d_n }} collections{% endif %}</p>
              {%- if block.settings.text != blank -%}<p class="nfd-dept__p">{{ block.settings.text | escape }}</p>{%- endif -%}
              <a class="nfd-link" href="{{ c.url }}">Shop all {{ d_title | downcase | escape }}<span class="nfd-arrow" aria-hidden="true">&rarr;</span></a>
            </div>
          </div>
          {%- if d_n > 0 -%}<div class="nfd-dept__sets">{{ d_sets }}</div>{%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "NF directory departments",
  "class": "nfd-section nfd-section--depts",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "departments" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Departments" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Browse by department" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "textarea", "id": "img_overrides", "label": "Tile photo swaps", "info": "handle=Files filename or handle=https CDN URL, one per line. Use for collections with no image or a dark one." }
  ],
  "blocks": [
    {
      "type": "department",
      "name": "Department",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Title", "info": "Leave blank to use the collection title." },
        { "type": "textarea", "id": "text", "label": "Short line" },
        { "type": "text", "id": "image_file", "label": "Image filename in Files", "info": "Big and bright, lights on." },
        { "type": "text", "id": "image_pos", "label": "Image focus", "info": "CSS object position, for example 50% 30%" },
        { "type": "range", "id": "brighten", "label": "Brighten photo", "min": 100, "max": 130, "step": 1, "unit": "%", "default": 100 },
        { "type": "textarea", "id": "groups", "label": "Collection sets", "info": "Title@group-handle=child,child:Label;Title=child,child" },
        { "type": "text", "id": "keywords", "label": "Extra filter words" }
      ]
    }
  ],
  "max_blocks": 16
}
{% endschema %}
