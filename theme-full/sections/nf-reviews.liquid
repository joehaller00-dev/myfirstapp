{%- comment -%}
  NF-REVIEWS-V5 (2026-09-25, owner round 5: "the reviews didn't change at all"). Restyling Judge.me's widget depended on
  class names that are not on the live page, so this section draws the reviews itself, in the Baskoraa layout:
    the average, stars and count on the left, Write a review and Ask a question on the right,
    Reviews (N) / Questions (N) tabs on a full width rule, a sort menu on the right,
    fixed width cards that start at the left, photo first.
  Data: judgeme.review_widget_data (the first page of reviews Judge.me keeps on the product). "Show more reviews" asks
  Judge.me for the next page (assets/nf-pdp3.js, section 9); if that fails it opens Judge.me's own full list.
  Write a review opens Judge.me's own form, so reviews still go to Judge.me. The Judge.me section stays on the page,
  hidden until it is needed. Questions: the #nf-questions panel (custom-nav.js, NF-QA-V1) is moved into the Questions tab.
  Room sets (round 7): a set is new and has no reviews of its own, so it shows the real reviews of each piece inside it,
  every card labelled with the piece it is about, and the summary says so. This replaces sections/nf-set-reviews.liquid.
{%- endcomment -%}
{%- liquid
  assign is_set = false
  if product.type == 'Room Set' and product.metafields.custom.set_items.value != blank
    assign is_set = true
  endif
  assign jd = product.metafields.judgeme.review_widget_data.value
  assign n = jd.number_of_reviews | default: 0
  assign avg = jd.average_rating | default: 0 | plus: 0
  assign revs = jd.reviews
  assign shown = revs.size | default: 0
  if is_set
    assign n = 0
    assign tot = 0
    assign shown = 0
    assign seen = ','
    for it in product.metafields.custom.set_items.value
      assign h = it.url | split: '/products/' | last | split: '?' | first
      assign key = ',' | append: h | append: ','
      if seen contains key
        continue
      endif
      assign seen = seen | append: h | append: ','
      assign pjd = all_products[h].metafields.judgeme.review_widget_data.value
      assign pn = pjd.number_of_reviews | default: 0
      if pn > 0
        assign pa = pjd.average_rating | plus: 0
        assign n = n | plus: pn
        assign tot = pa | times: pn | plus: tot
        assign shown = shown | plus: pjd.reviews.size
      endif
    endfor
    if n > 0
      assign avg = tot | divided_by: n
    endif
  endif
  assign nq = 0
  assign qa = product.metafields.custom.qa.value
  if qa != blank
    assign nq = qa.size
  endif
-%}
  {{ 'nf-pdp3.css' | asset_url | stylesheet_tag }}
  <section class="nfrv" id="nf-reviews" data-nfrv data-n="{{ n }}"{% if is_set %} data-set{% endif %} data-loaded="{{ shown }}" data-pid="{{ product.id }}" data-shop="{{ shop.permanent_domain }}" aria-labelledby="nfrv-h">
    <div class="nfrv__in">
      <h2 class="nfrv__sr" id="nfrv-h">Customer reviews</h2>
      <div class="nfrv__top">
        <div class="nfrv__sum">
          {%- if n > 0 -%}
            <p class="nfrv__score">{{ avg | round: 1 }} <span class="nfsr__stars" style="--r: {{ avg | times: 20 }}%" role="img" aria-label="{{ avg | round: 1 }} out of 5 stars"></span></p>
            <p class="nfrv__count">{{ n }} {% if n == 1 %}review{% else %}reviews{% endif %}{% if is_set %} of the pieces in this set{% endif %}</p>
          {%- else -%}
            <p class="nfrv__score">No reviews yet</p>
            <p class="nfrv__count">Be the first to share how it looks at home.</p>
          {%- endif -%}
        </div>
        <div class="nfrv__acts">
          <button type="button" class="nfrv__btn" data-nfrv-write>Write a review</button>
          <button type="button" class="nfrv__btn" data-nfrv-ask>Ask a question</button>
        </div>
      </div>

      <div class="nfrv__tabs" role="tablist">
        <button type="button" class="nfrv__tab is-on" role="tab" aria-selected="true" data-nfrv-tab="r">Reviews ({{ n }})</button>
        <button type="button" class="nfrv__tab" role="tab" aria-selected="false" data-nfrv-tab="q">Questions ({{ nq }})</button>
      </div>

      <div class="nfrv__panel" data-nfrv-panel="r">
        {%- if shown > 0 -%}
          <div class="nfrv__bar">
            <label class="nfrv__sort"><span class="nfrv__sr">Sort reviews</span>
              <select data-nfrv-sort>
                <option value="new">Newest</option>
                <option value="high">Highest rating</option>
                <option value="low">Lowest rating</option>
                <option value="pics">With photos</option>
              </select>
            </label>
          </div>
          <div class="nfrv__grid" data-nfrv-grid>
            {%- if is_set -%}
              {%- assign seen = ',' -%}
              {%- for it in product.metafields.custom.set_items.value -%}
                {%- assign h = it.url | split: '/products/' | last | split: '?' | first -%}
                {%- assign key = ',' | append: h | append: ',' -%}
                {%- if seen contains key -%}{%- continue -%}{%- endif -%}
                {%- assign seen = seen | append: h | append: ',' -%}
                {%- assign pc = all_products[h] -%}
                {%- for r in pc.metafields.judgeme.review_widget_data.value.reviews -%}{%- render 'nf-review-card', r: r, piece: pc -%}{%- endfor -%}
              {%- endfor -%}
            {%- else -%}
              {%- for r in revs -%}{%- render 'nf-review-card', r: r -%}{%- endfor -%}
            {%- endif -%}
          </div>
          {%- if n > shown and is_set == false -%}
            <div class="nfrv__more"><button type="button" class="nfrv__btn" data-nfrv-more>Show more reviews</button></div>
          {%- endif -%}
        {%- else -%}
          <p class="nfrv__empty">No reviews for this piece yet. Bought one? Tell other shoppers what it is like at home.</p>
        {%- endif -%}
      </div>

      <div class="nfrv__panel" data-nfrv-panel="q" hidden></div>
    </div>
  </section>

{% schema %}
{
  "name": "NF reviews",
  "tag": "div",
  "class": "shopify-section--nf-reviews",
  "settings": [],
  "presets": [{ "name": "NF reviews" }],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
