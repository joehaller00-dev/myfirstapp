{%- comment -%} nf-pro-products (Professionals, 2026-09-11). Recommended fixture types: one tab per block, each a product rail from a real collection. {%- endcomment -%}
{{- 'nf-pro.css' | asset_url | stylesheet_tag -}}
<script src="{{ 'nf-pro.js' | asset_url }}" defer></script>
{%- assign s = section.settings -%}
<section class="nfp nfp--{{ s.bg }} nfp-sec"{% if s.anchor != blank %} id="{{ s.anchor | handle }}"{% endif %}>
  <div class="nfp-wrap">
    <div class="nfp-head">
      <div class="nfp-head__main">
        {%- if s.eyebrow != blank -%}<p class="nfp-eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
        <h2 class="nfp-h2">{{ s.heading | escape }}</h2>
        {%- if s.text != blank -%}<p class="nfp-lead">{{ s.text | escape }}</p>{%- endif -%}
      </div>
      {%- if s.link_label != blank -%}<a class="nfp-btn nfp-btn--browse" href="{{ s.link_url }}">{{ s.link_label | escape }} <span class="nfp-arrow" aria-hidden="true">&rarr;</span></a>{%- endif -%}
    </div>

    {%- if section.blocks.size > 1 -%}
      <div class="nfp-tabs" role="tablist" data-nfp-tabs aria-label="{{ s.heading | escape }}">
        {%- for block in section.blocks -%}
          <button type="button" class="nfp-tab" role="tab" id="nfp-tab-{{ block.id }}" aria-controls="nfp-panel-{{ block.id }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" tabindex="{% if forloop.first %}0{% else %}-1{% endif %}">{{ block.settings.label | default: block.settings.collection.title | escape }}</button>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- for block in section.blocks -%}
      {%- assign c = block.settings.collection -%}
      <div class="nfp-panel" id="nfp-panel-{{ block.id }}"{% if section.blocks.size > 1 %} role="tabpanel" aria-labelledby="nfp-tab-{{ block.id }}"{% endif %}{% unless forloop.first %} hidden{% endunless %} {{ block.shopify_attributes }}>
        <div class="nfp-panel__intro">
          {%- if block.settings.text != blank -%}<p>{{ block.settings.text | escape }}</p>{%- endif -%}
          {%- if c != blank -%}<a class="nfp-link" href="{{ c.url }}">{{ block.settings.shop_label | default: 'Shop the collection' | escape }} <span class="nfp-arrow" aria-hidden="true">&rarr;</span></a>{%- endif -%}
        </div>
        {%- if c != blank -%}
          <div class="nfp-rail" data-nfp-rail>
            <div class="nfp-rail__track" tabindex="0" aria-label="{{ block.settings.label | default: c.title | escape }}">
              {%- assign shown = 0 -%}{%- comment -%} NF-PRO-V2: skip ceiling fans in rails unless the collection is a fan collection {%- endcomment -%}{%- assign nfp_nofan = true -%}{%- if c.handle contains 'fan' -%}{%- assign nfp_nofan = false -%}{%- endif -%}
              {%- for p in c.products -%}
                {%- if p.available == false -%}{%- continue -%}{%- endif -%}{%- comment -%} NF-PRO3: skip products with no lit evening photo {%- endcomment -%}{%- if p.metafields.nfpro.card_skip.value == true -%}{%- continue -%}{%- endif -%}{%- if nfp_nofan -%}{%- if p.type contains 'Fan' or p.title contains ' Fan' -%}{%- continue -%}{%- endif -%}{%- endif -%}
                {%- render 'nf-pro-product-card', product: p -%}
                {%- assign shown = shown | plus: 1 -%}
                {%- if shown >= block.settings.limit -%}{%- break -%}{%- endif -%}
              {%- endfor -%}
            </div>
            <div class="nfp-rail__nav" style="justify-content:flex-end">
              <button type="button" class="nfp-iconbtn" data-nfp-prev aria-label="Previous products"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg></button>
              <button type="button" class="nfp-iconbtn" data-nfp-next aria-label="Next products"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg></button>
            </div>
          </div>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "NF Pro product rails",
  "class": "nfp-shell",
  "settings": [
    { "type": "select", "id": "bg", "label": "Background", "default": "cream", "options": [ { "value": "cream", "label": "Cream" }, { "value": "sand", "label": "Sand" }, { "value": "white", "label": "White" } ] },
    { "type": "text", "id": "anchor", "label": "Anchor id" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Recommended fixture types" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "link_label", "label": "Browse button label" },
    { "type": "text", "id": "link_url", "label": "Browse button link" }
  ],
  "blocks": [
    {
      "type": "rail",
      "name": "Fixture type",
      "settings": [
        { "type": "text", "id": "label", "label": "Tab label" },
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "textarea", "id": "text", "label": "Why it works here" },
        { "type": "text", "id": "shop_label", "label": "Shop link label" },
        { "type": "range", "id": "limit", "label": "Products shown", "min": 4, "max": 16, "step": 1, "default": 10 }
      ]
    }
  ],
  "max_blocks": 6
}
{% endschema %}
