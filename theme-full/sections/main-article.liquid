{%- comment -%} NF article page (nf-blog). Styles: assets/nf-blog.css, script: assets/nf-blog.js {%- endcomment -%}
{{ 'nf-blog.css' | asset_url | stylesheet_tag }}
<script src="{{ 'nf-blog.js' | asset_url }}" defer></script>
{%- liquid
  assign nf_wm_img = images['e0cf0a7c-0740-403b-9bd3-70fc7e7f6dc9.png']
  if nf_wm_img
    assign nf_wm = nf_wm_img | image_url: width: 300
  else
    assign nf_wm = 'e0cf0a7c-0740-403b-9bd3-70fc7e7f6dc9.png' | file_img_url: '300x'
  endif

  assign nf_blog_url = blog.url | default: '/blogs/blog'
  assign nf_share_url = shop.url | append: article.url
  assign nf_share_url_enc = nf_share_url | url_encode
  assign nf_share_title_enc = article.title | url_encode
  assign nf_share_img = ''
  if article.image
    assign nf_share_img = article.image | image_url: width: 1200 | prepend: 'https:' | url_encode
  endif
-%}
<div class="nf-article" style="--nf-wm: url('{{ nf_wm }}');">
  <article class="nf-article__col">
    <header class="nf-article__head">
      <h1 class="nf-article__title">{{ article.title }}</h1>
      <p class="nf-article__meta">
        <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: '%b %-d, %Y' }}</time>
        {%- if article.author != blank -%}
          <span class="nf-dot" aria-hidden="true">&bull;</span>
          <span>{{ article.author }}</span>
        {%- endif -%}
      </p>
    </header>

    <div class="nf-article__body">
      {{- article.content -}}
    </div>
  </article>

  {%- assign nf_recs = article.metafields.custom.rec_products.value -%}
  {%- if nf_recs != blank -%}
    <section class="nf-recs nf-article__col" aria-labelledby="nf-recs-title">
      <h2 id="nf-recs-title" class="nf-sec-title">Bestselling Product Recommendations</h2>
      <div class="nf-recs__grid">
        {%- assign nf_shown = 0 -%}
        {%- for p in nf_recs -%}
          {%- if p == blank or nf_shown >= 4 -%}{%- continue -%}{%- endif -%}
          {%- assign nf_shown = nf_shown | plus: 1 -%}
          <a class="nf-rec" href="{{ p.url }}">
            <span class="nf-rec__media">
              {%- if p.featured_image -%}
                {{- p.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '240,360,480,600', sizes: '(max-width: 699px) 45vw, 190px', alt: p.featured_image.alt, class: 'nf-rec__img' -}}
              {%- endif -%}
            </span>
            <span class="nf-rec__title">{{ p.title }}</span>
            <span class="nf-rec__price">
              {%- if p.price_varies -%}<span class="nf-rec__from">From</span>{%- endif -%}
              <span class="nf-rec__now{% if p.compare_at_price > p.price %} nf-rec__sale{% endif %}">{{ p.price | money }}</span>
              {%- if p.compare_at_price > p.price -%}
                <s class="nf-rec__compare">{{ p.compare_at_price | money }}</s>
              {%- endif -%}
            </span>
          </a>
        {%- endfor -%}
      </div>
    </section>
  {%- endif -%}

  <div class="nf-tagshare nf-article__col">
    {%- if article.tags.size > 0 -%}
      <div class="nf-tagshare__tags">
        <span class="nf-label">Tags:</span>
        {%- for t in article.tags -%}
          <a class="nf-pill nf-pill--sm" href="{{ nf_blog_url }}/tagged/{{ t | handle }}">{{ t }}</a>
        {%- endfor -%}
      </div>
    {%- endif -%}
    <div class="nf-tagshare__share">
      <span class="nf-label">Share:</span>
      <a class="nf-share" href="https://www.facebook.com/sharer/sharer.php?u={{ nf_share_url_enc }}" target="_blank" rel="noopener" aria-label="Share on Facebook">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M13.5 21v-7.6h2.6l.4-3h-3V8.5c0-.9.3-1.5 1.5-1.5h1.6V4.3c-.3 0-1.2-.1-2.3-.1-2.3 0-3.9 1.4-3.9 4v2.2H7.8v3h2.6V21h3.1z"/></svg>
      </a>
      <a class="nf-share" href="https://twitter.com/intent/tweet?url={{ nf_share_url_enc }}&amp;text={{ nf_share_title_enc }}" target="_blank" rel="noopener" aria-label="Share on X">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M17.8 3h3.1l-6.8 7.8L22 21h-6.2l-4.9-6.4L5.3 21H2.2l7.3-8.3L2 3h6.4l4.4 5.8L17.8 3zm-1.1 16.2h1.7L7.4 4.7H5.6l11.1 14.5z"/></svg>
      </a>
      <a class="nf-share" href="https://pinterest.com/pin/create/button/?url={{ nf_share_url_enc }}{% if nf_share_img != blank %}&amp;media={{ nf_share_img }}{% endif %}&amp;description={{ nf_share_title_enc }}" target="_blank" rel="noopener" aria-label="Share on Pinterest">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 2C6.5 2 2 6.5 2 12c0 4.2 2.6 7.8 6.3 9.3-.1-.8-.2-2 0-2.9l1.2-5s-.3-.6-.3-1.5c0-1.4.8-2.4 1.8-2.4.9 0 1.3.6 1.3 1.4 0 .9-.5 2.1-.8 3.3-.2 1 .5 1.8 1.5 1.8 1.8 0 3.1-1.9 3.1-4.6 0-2.4-1.7-4.1-4.2-4.1-2.9 0-4.5 2.1-4.5 4.4 0 .9.3 1.8.8 2.3.1.1.1.2.1.3l-.3 1.2c0 .2-.2.2-.4.1-1.3-.6-2.1-2.5-2.1-4 0-3.3 2.4-6.3 6.9-6.3 3.6 0 6.4 2.6 6.4 6 0 3.6-2.3 6.5-5.4 6.5-1.1 0-2.1-.6-2.4-1.2l-.7 2.5c-.2.9-.9 2.1-1.3 2.8 1 .3 2 .5 3 .5 5.5 0 10-4.5 10-10S17.5 2 12 2z"/></svg>
      </a>
    </div>
  </div>
</div>

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": {{ article.title | json }},
    "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%:z' | json }},
    "dateModified": {{ article.updated_at | date: '%Y-%m-%dT%H:%M:%S%:z' | json }},
    "author": { "@type": "Organization", "name": {{ article.author | default: shop.name | json }} },
    "publisher": { "@type": "Organization", "name": {{ shop.name | json }} },
    {%- if article.image %}
    "image": {{ article.image | image_url: width: 1200 | prepend: 'https:' | json }},
    {%- endif %}
    "mainEntityOfPage": {{ nf_share_url | json }}
  }
</script>

{% schema %}
{
  "name": "NF Article",
  "class": "shopify-section--nf-article",
  "tag": "section",
  "settings": []
}
{% endschema %}
