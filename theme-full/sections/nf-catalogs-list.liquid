{%- comment -%}
  nf-catalogs-list : /pages/catalog. One card per "catalog" block (open book mockup or an image,
  title, page count, link). Page count is read from the catalog page's metafield custom.catalog
  through snippets/nf-catalog-book.liquid (mode stats), so it matches the viewer.
{%- endcomment -%}
{{ 'nf-catalog.css' | asset_url | stylesheet_tag }}
<div class="nfcat-list">
  <div class="nfcat-list__in">
    <h1 class="nfcat-list__h">{{ section.settings.heading | escape }}</h1>
    {%- if section.settings.intro != blank -%}<p class="nfcat-list__intro">{{ section.settings.intro | escape }}</p>{%- endif -%}
    <div class="nfcat-list__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign bp = block.settings.catalog_page
          if bp == blank
            assign bp = pages['lighting-catalog']
          endif
          assign cat = bp.metafields.custom.catalog.value
          assign n_pages = 0
          if cat != blank
            capture nf_stats
              render 'nf-catalog-book', cat: cat, mode: 'stats'
            endcapture
            assign n_pages = nf_stats | strip | split: '|' | first | plus: 0
          endif
          assign link = block.settings.url | default: bp.url
          assign card_title = block.settings.title | default: cat.title
        -%}
        <div class="nfcat-lcard" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <a href="{{ link }}" tabindex="-1" aria-hidden="true">{{ block.settings.image | image_url: width: 900 | image_tag: class: 'nfcat-lcard__img', loading: 'lazy', sizes: '(max-width: 749px) 70vw, 300px' }}</a>
          {%- elsif cat != blank -%}
            {%- render 'nf-catalog-book', cat: cat, url: link, sizes: '(max-width: 749px) 45vw, 200px' -%}
          {%- endif -%}
          <h2 class="nfcat-lcard__t"><a href="{{ link }}" style="color:inherit;text-decoration:none">{{ card_title | escape }}</a></h2>
          {%- if n_pages > 0 -%}<p class="nfcat-lcard__meta">{{ n_pages }} pages</p>{%- endif -%}
          <a class="nfcat-lcard__link" href="{{ link }}" style="color:inherit">{{ block.settings.link_label | escape }}</a>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>
<script src="{{ 'nf-catalog.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "NF catalogs list",
  "class": "nf-catalogs-list-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "2026 Nora Furnish Lighting Catalog" },
    { "type": "text", "id": "intro", "label": "Intro line", "default": "Browse the full collection page by page. Every page links to the products inside, with live prices." }
  ],
  "blocks": [
    {
      "type": "catalog",
      "name": "Catalog",
      "settings": [
        { "type": "page", "id": "catalog_page", "label": "Catalog page", "info": "Page whose metafield custom.catalog holds the catalog." },
        { "type": "text", "id": "title", "label": "Title", "default": "2026 Lighting Catalog" },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "View the catalog" },
        { "type": "url", "id": "url", "label": "Link", "info": "Leave blank to link to the catalog page." },
        { "type": "image_picker", "id": "image", "label": "Card image", "info": "Optional. Replaces the open book mockup." }
      ]
    }
  ],
  "presets": [{ "name": "NF catalogs list", "blocks": [{ "type": "catalog" }] }]
}
{% endschema %}
