{%- comment -%}
  NF-DUSK-V1 (2026-09-12) Homepage "day to night" drag slider.
  Base layer = the day photo. Top layer = the matched night photo, revealed LEFT of the handle,
  so dragging right switches the room on. Hotspot blocks link to the real products in the photo
  and only appear on the lit side. Reduced motion: no drag handle, a plain on/off toggle button.
  Files: sections/nf-dusk-slider.liquid, assets/nf-dusk.css, assets/nf-dusk.js
  Rollback: templates/index.json -> disable nf_dusk_slider, enable custom_liquid_pPnBYa.
{%- endcomment -%}
{%- comment -%} NF-SPEED-A-0916: on the homepage this section is far below the first screen, so its stylesheet no longer holds up first paint (loads at once, applied when it arrives). {%- endcomment -%}{%- if request.page_type == 'index' -%}<link rel="stylesheet" href="{{ 'nf-dusk.css' | asset_url }}" media="print" onload="this.media='all'"><noscript>{{ 'nf-dusk.css' | asset_url | stylesheet_tag }}</noscript>{%- else -%}{{ 'nf-dusk.css' | asset_url | stylesheet_tag }}{%- endif -%}
{%- comment -%} NF-SPEED-A-0916: on the homepage this script loads when the section comes near (window.nfLazyJs in layout/theme.liquid). {%- endcomment -%}{%- if request.page_type == 'index' and request.design_mode == false -%}<script>if(window.nfLazyJs){nfLazyJs("{{ 'nf-dusk.js' | asset_url }}","#shopify-section-{{ section.id }}");}else{document.write('<script src="{{ 'nf-dusk.js' | asset_url }}" defer><\/script>');}</script>{%- else -%}<script src="{{ 'nf-dusk.js' | asset_url }}" defer></script>{%- endif -%}
{%- liquid
  assign day = section.settings.image_day
  assign night = section.settings.image_night
  assign start = section.settings.start
  assign sizes = '(min-width: 1776px) 1584px, (min-width: 750px) calc(100vw - 96px), calc(100vw - 40px)'
  assign widths = '600,900,1200,1600,2000,2400'
-%}
<section
  class="nfdk{% if section.settings.rule %} nfdk--rule{% endif %}"
  data-nfdk
  data-start="{{ start }}"
  data-label-on="{{ section.settings.label_on | escape }}"
  data-label-back="{{ section.settings.label_back | escape }}"
  data-toggle-on="{{ section.settings.toggle_on | escape }}"
  data-toggle-off="{{ section.settings.toggle_off | escape }}"
  style="--dk-pos: {{ start }}%; --dk-opx: {{ section.settings.mobile_focus }}%;"
>
  <div class="nfdk__wrap">
    <header class="nfdk__head">
      <div class="nfdk__intro">
        {%- if section.settings.eyebrow != blank -%}<p class="nfdk__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="nfdk__title">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<p class="nfdk__sub">{{ section.settings.text }}</p>{%- endif -%}
      </div>
      {%- if section.settings.link_label != blank and section.settings.link != blank -%}
        <a class="nfdk__cta" href="{{ section.settings.link }}">
          <span>{{ section.settings.link_label }}</span>
          <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      {%- endif -%}
    </header>

    <div class="nfdk__stage" data-nfdk-stage>
      {%- if day != blank -%}
        {{- day | image_url: width: 2400 | image_tag: loading: 'lazy', widths: widths, sizes: sizes, class: 'nfdk__img nfdk__img--day', alt: section.settings.day_alt, data-nfdk-day: '' -}}
      {%- endif -%}
      <div class="nfdk__night" data-nfdk-night>
        {%- if night != blank -%}
          {{- night | image_url: width: 2400 | image_tag: loading: 'lazy', widths: widths, sizes: sizes, class: 'nfdk__img nfdk__img--night', alt: section.settings.night_alt -}}
        {%- endif -%}
      </div>

      {%- for block in section.blocks -%}
        {%- assign p = block.settings.product -%}
        {%- if p == blank -%}{%- continue -%}{%- endif -%}
        {%- assign kind = block.settings.kind | default: 'Shop this light' -%}
        {%- assign ttl = block.settings.title | default: p.title -%}
        {%- capture price -%}{%- if p.price_varies -%}From {% endif -%}{% render 'nf-acc-price', product: p, format: 'text' %}{%- endcapture -%}
        <a
          class="nfdk__spot{% if block.settings.x > 58 %} nfdk__spot--left{% endif %}{% if block.settings.y > 62 %} nfdk__spot--up{% endif %}"
          href="{{ p.url }}"
          data-nfdk-spot
          data-x="{{ block.settings.x }}"
          data-y="{{ block.settings.y }}"
          style="--x: {{ block.settings.x }}%; --y: {{ block.settings.y }}%;"
          tabindex="-1"
          aria-hidden="true"
          aria-label="{{ kind | escape }}: {{ ttl | escape }}, {{ price | escape }}"
          {{ block.shopify_attributes }}
        >
          <span class="nfdk__dot" aria-hidden="true"></span>
          <span class="nfdk__card" aria-hidden="true">
            <span class="nfdk__kind">{{ kind }}</span>
            <span class="nfdk__name">{{ ttl }}</span>
            <span class="nfdk__price">{{ price }}</span>
          </span>
        </a>
      {%- endfor -%}

      <div
        class="nfdk__handle"
        data-nfdk-handle
        role="slider"
        tabindex="0"
        aria-label="{{ section.settings.slider_label | escape }}"
        aria-orientation="horizontal"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="{{ start }}"
        aria-valuetext="Daylight"
      >
        <span class="nfdk__line" aria-hidden="true"></span>
        <span class="nfdk__knob" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M9 7l-5 5 5 5M15 7l5 5-5 5"/></svg></span>
        <span class="nfdk__label" data-nfdk-label aria-hidden="true">{{ section.settings.label_on }}</span>
      </div>

      <button type="button" class="nfdk__toggle" data-nfdk-toggle aria-pressed="false">
        <span class="nfdk__switch" aria-hidden="true"><span></span></span>
        <span data-nfdk-toggle-text>{{ section.settings.toggle_on }}</span>
      </button>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "NF Dusk slider",
  "tag": "div",
  "class": "shopify-section--nf-dusk",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Day to night" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Watch the kitchen come alive" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Drag across the room to switch every light on, then tap a glowing light to shop it." },
    { "type": "text", "id": "link_label", "label": "Button label", "default": "Shop kitchen and dining" },
    { "type": "url", "id": "link", "label": "Button link" },
    { "type": "checkbox", "id": "rule", "label": "Hairline above section", "default": false },
    { "type": "header", "content": "Matched photos" },
    { "type": "image_picker", "id": "image_day", "label": "Day photo (lights off)" },
    { "type": "text", "id": "day_alt", "label": "Day photo alt text", "default": "A bright kitchen and dining room in soft daylight" },
    { "type": "image_picker", "id": "image_night", "label": "Night photo (same framing, lights on)" },
    { "type": "text", "id": "night_alt", "label": "Night photo alt text", "default": "The same kitchen at night with the pendants, sconce and table lamp glowing" },
    { "type": "range", "id": "start", "label": "Handle start position", "min": 0, "max": 60, "step": 2, "unit": "%", "default": 16 },
    { "type": "range", "id": "mobile_focus", "label": "Phone crop focus (left to right)", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 55 },
    { "type": "header", "content": "Labels" },
    { "type": "text", "id": "slider_label", "label": "Slider name for screen readers", "default": "Day to night slider. Use the arrow keys to switch the lights on." },
    { "type": "text", "id": "label_on", "label": "Handle label", "default": "Drag to switch the lights on" },
    { "type": "text", "id": "label_back", "label": "Handle label past halfway", "default": "Drag back for daylight" },
    { "type": "text", "id": "toggle_on", "label": "Reduced motion button (off state)", "default": "Switch the lights on" },
    { "type": "text", "id": "toggle_off", "label": "Reduced motion button (on state)", "default": "Switch the lights off" }
  ],
  "blocks": [
    {
      "type": "hotspot",
      "name": "Hotspot",
      "limit": 5,
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "kind", "label": "Small label", "default": "Pendant" },
        { "type": "text", "id": "title", "label": "Title override" },
        { "type": "range", "id": "x", "label": "Left to right", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
        { "type": "range", "id": "y", "label": "Top to bottom", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 30 }
      ]
    }
  ],
  "presets": [ { "name": "NF Dusk slider" } ]
}
{% endschema %}
