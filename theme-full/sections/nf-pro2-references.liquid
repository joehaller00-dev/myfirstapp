{%- comment -%}
  NF-PRO-V2 nf-pro2-references (2026-09-11). "Application references": a deliberate dark charcoal band with a grid of
  about 8 inspiration images and short uppercase labels. The images "switch on" in sequence when the band scrolls into
  view, and a small wall switch turns them off and on again (assets/nf-pro2.js). Without JS everything is lit.
  These are inspiration images, never presented as our installed projects: the caption says so.
  Images come from Shopify Files by file name through snippets/nf-pro-media.
{%- endcomment -%}
{{- 'nf-pro.css' | asset_url | stylesheet_tag -}}
{{- 'nf-pro2.css' | asset_url | stylesheet_tag -}}
<script src="{{ 'nf-pro2.js' | asset_url }}" defer></script>
{%- assign s = section.settings -%}
<section class="nfp nfp2 nfp2-refs nfp-sec" id="{{ s.anchor | default: 'references' | handle }}" data-nfp2-refs aria-labelledby="{{ section.id }}-h">
  <div class="nfp-wrap">
    <div class="nfp2-head nfp2-head--dark">
      <div class="nfp2-head__main">
        {%- if s.eyebrow != blank -%}<p class="nfp2-eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
        <h2 class="nfp2-h2" id="{{ section.id }}-h">{{ s.heading | escape }}</h2>
      </div>
      <div class="nfp2-refs__side">
        <p class="nfp2-head__note">{{ s.caption | escape }}</p>
        <button type="button" class="nfp2-switch" role="switch" aria-checked="true" data-nfp2-switch>
          <span class="nfp2-switch__plate" aria-hidden="true"><span class="nfp2-switch__rocker"></span></span>
          <span class="nfp2-switch__txt">Lights <b data-on>on</b><b data-off>off</b></span>
        </button>
      </div>
    </div>
    <ul class="nfp2-refs__grid" role="list">
      {%- for block in section.blocks -%}
        <li class="nfp2-ref" style="--i:{{ forloop.index0 }}" {{ block.shopify_attributes }}>
          <figure class="nfp2-ref__fig">
            <div class="nfp2-ref__img">
              {%- render 'nf-pro-media', file: block.settings.image_file, alt: block.settings.alt, fallback: block.settings.fallback, sizes: '(max-width: 699px) 50vw, (max-width: 1100px) 33vw, 330px', label: block.settings.label -%}
              <span class="nfp2-ref__glow" aria-hidden="true"></span>
              {%- if s.quote_links -%}<a class="nfp2-ref__cta" href="#{{ s.quote_anchor | default: 'quote' }}" data-nfp2-ref="{{ block.settings.label | handleize }}">Quote this look<span class="nfp2-sr"> ({{ block.settings.label | escape }})</span></a>{%- endif -%}
            </div>
            <figcaption class="nfp2-ref__label"><span class="nfp2-ref__n" aria-hidden="true">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>{{ block.settings.label | escape }}</figcaption>
          </figure>
        </li>
      {%- endfor -%}
    </ul>
    {%- if s.btn1_label != blank or s.btn2_label != blank -%}
      <div class="nfp2-refs__foot">
        <p>{{ s.foot | escape }}</p>
        <div class="nfp2-actions">
          {%- if s.btn1_label != blank -%}<a class="nfp2-btn nfp2-btn--gold" href="{{ s.btn1_url | default: '#quote' }}">{{ s.btn1_label | escape }}</a>{%- endif -%}
          {%- if s.btn2_label != blank -%}<a class="nfp2-btn nfp2-btn--outline" href="{{ s.btn2_url }}">{{ s.btn2_label | escape }} <span class="nfp-arrow" aria-hidden="true">&rarr;</span></a>{%- endif -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "NF Pro references",
  "class": "nfp-shell",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "references" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Inspiration" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Application references" },
    { "type": "textarea", "id": "caption", "label": "Caption", "default": "Inspiration for how these systems are used. These are example spaces, not our installed projects." },
    { "type": "text", "id": "foot", "label": "Footer line", "default": "Seen a look you like? Tell us which one and we will quote it for your space." },
    { "type": "text", "id": "btn1_label", "label": "Gold button label", "default": "Start a Custom Request" },
    { "type": "text", "id": "btn1_url", "label": "Gold button link", "default": "#quote" },
    { "type": "text", "id": "btn2_label", "label": "Outline button label" },
    { "type": "text", "id": "btn2_url", "label": "Outline button link" },
    { "type": "checkbox", "id": "quote_links", "label": "Show 'Quote this look' on each image", "default": true },
    { "type": "text", "id": "quote_anchor", "label": "Quote form anchor", "default": "quote" }
  ],
  "blocks": [
    {
      "type": "ref",
      "name": "Reference",
      "settings": [
        { "type": "text", "id": "label", "label": "Short label", "info": "Shown in uppercase, for example Open Workspace" },
        { "type": "text", "id": "image_file", "label": "Image file name in Content > Files" },
        { "type": "text", "id": "alt", "label": "Alt text" },
        { "type": "text", "id": "fallback", "label": "Fallback collection handle" }
      ]
    }
  ],
  "max_blocks": 12
}
{% endschema %}
