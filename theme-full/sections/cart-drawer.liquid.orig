<cart-drawer
  id="cart-drawer"
  aria-label="{{ 'cart.general.title' | t | escape_once }}"
  class="cart-drawer drawer {% if cart.empty? %}drawer--center-body{% endif %} color-scheme color-scheme--{{ section.settings.color_scheme.id }}"
  initial-focus="false"
  handle-editor-events
>
  {%- liquid
    assign nf_cnt = 0
    for li in cart.items
      unless li.product.tags contains 'membership-product'
        assign nf_cnt = nf_cnt | plus: li.quantity
      endunless
    endfor
  -%}
  {%- comment -%} NF-CART-V3 (2026-10-15, owner: "copy their cart ... it slides into place", MOD's cart): serif "Your Cart" with the item count {%- endcomment -%}
  <p class="nf-cd-title" slot="header">Your Cart{% if nf_cnt > 0 %} <span class="nf-cd-count">{{ nf_cnt }} {% if nf_cnt == 1 %}item{% else %}items{% endif %}</span>{% endif %}</p>
  {%- comment -%} NF-CART-V3 stale guard (2026-10-19): what this drawer was rendered with. assets/nf-cart-v3.js compares it with the live
    cart when the drawer opens or the page comes back (back/forward cache, prerendered page, another tab) and veils it until fresh. {%- endcomment -%}
  {%- capture nf_sig -%}{{ cart.item_count }}:{{ cart.total_price }}:{%- for li in cart.items -%}{{ li.variant_id }}x{{ li.quantity }},{%- endfor -%}{%- endcapture -%}
  <span hidden data-nf-cd-sig="{{ nf_sig | strip }}"></span>

  {%- if cart.empty? -%}
    {%- comment -%} NF-CART-V2: the lamp empty state. The pendant glows warm as the drawer opens (CSS keys off [open]),
      then three big tiles lead back into the store. {%- endcomment -%}
    <div class="nf-cv2-empty">
      <svg class="nf-cv2-lamp" viewBox="0 0 92 116" aria-hidden="true" focusable="false"><defs><radialGradient id="nfCv2GlowGrad" cx="50%" cy="30%" r="62%"><stop offset="0" stop-color="#c9a36a" stop-opacity="0.9"/><stop offset="0.45" stop-color="#c9a36a" stop-opacity="0.38"/><stop offset="1" stop-color="#c9a36a" stop-opacity="0"/></radialGradient></defs><ellipse class="nf-cv2-lamp__glow" cx="46" cy="88" rx="45" ry="30" fill="url(#nfCv2GlowGrad)"/><path class="nf-cv2-lamp__line" d="M37 2.5h18M46 2.5v41"/><path class="nf-cv2-lamp__shade" d="M41 43.5h10l1.6 6.2C63.5 52.6 71.4 62 73 75.5H19c1.6-13.5 9.5-22.9 20.4-25.8z"/><path class="nf-cv2-lamp__bulb" d="M39.5 75.5a6.5 6.5 0 0 0 13 0z"/></svg>
      <p class="nf-cv2-empty__title">Your cart is empty</p>
      <p class="nf-cv2-empty__text">Start with a favorite, or pick a room to light.</p>
      {%- comment -%} NF-CART-OFFER (2026-09-12): the real automatic discount, see nf-cart-v2.css {%- endcomment -%}
      <p class="nf-cv2-offer"><span class="nf-cv2-offer__dot" aria-hidden="true"></span>Buy 2 items, save 10%. Buy 3 or more, save 15%</p>
      <div class="nf-cv2-tiles">
        {%- assign nf_c = collections['best-sellers'] -%}{%- assign nf_img = nf_c.featured_image -%}
        <a class="nf-cv2-tile" href="{{ routes.collections_url }}/best-sellers">
          <span class="nf-cv2-tile__img">{%- if nf_img -%}{{ nf_img | image_url: width: 480 | image_tag: loading: 'lazy', sizes: '(max-width: 699px) 30vw, 140px', widths: '240,360,480', alt: '' }}{%- endif -%}</span>
          <span class="nf-cv2-tile__label">Best Sellers</span>
        </a>
        {%- assign nf_c = collections['ceiling-light'] -%}{%- assign nf_img = nf_c.featured_image -%}
        <a class="nf-cv2-tile" href="{{ routes.collections_url }}/ceiling-light">
          <span class="nf-cv2-tile__img">{%- if nf_img -%}{{ nf_img | image_url: width: 480 | image_tag: loading: 'lazy', sizes: '(max-width: 699px) 30vw, 140px', widths: '240,360,480', alt: '' }}{%- endif -%}</span>
          <span class="nf-cv2-tile__label">Ceiling Lights</span>
        </a>
        {%- assign nf_c = collections['outdoor-lighting'] -%}{%- assign nf_img = nf_c.featured_image -%}
        <a class="nf-cv2-tile" href="{{ routes.collections_url }}/outdoor-lighting">
          <span class="nf-cv2-tile__img">{%- if nf_img -%}{{ nf_img | image_url: width: 480 | image_tag: loading: 'lazy', sizes: '(max-width: 699px) 30vw, 140px', widths: '240,360,480', alt: '' }}{%- endif -%}</span>
          <span class="nf-cv2-tile__label">Outdoor Lighting</span>
        </a>
      </div>
      <div class="nf-cv2-trust"><span><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M1.6 5.6h11v9h-11z" stroke="currentColor" stroke-width="1.2"/><path d="M12.6 8.4h4.2l3.6 3.4v2.8h-7.8z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/><circle cx="6" cy="17.4" r="1.7" stroke="currentColor" stroke-width="1.2"/><circle cx="16.7" cy="17.4" r="1.7" stroke="currentColor" stroke-width="1.2"/></svg>Free US shipping</span><span><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20 12a8 8 0 1 1-2.3-5.6" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/><path d="M20 3.5V8h-4.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>30 day returns</span><span><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="5" y="10.5" width="14" height="9" rx="1.5" stroke="currentColor" stroke-width="1.3"/><path d="M8 10.5V8a4 4 0 0 1 8 0v2.5" stroke="currentColor" stroke-width="1.3"/></svg>Secure checkout</span></div>
    </div>
  {%- else -%}
    {%- if settings.cart_show_free_shipping_bar -%}
      {%- render 'free-shipping-bar' -%}
    {%- endif -%}

    {%- comment -%} NF-CART-V2: gold progress line for the real Buy 2+ items, save 10% automatic discount {%- endcomment -%}
    {%- comment -%} 2026-09-24: the progress line moved down into the footer, next to Checkout (owner: not at the top) {%- endcomment -%}
    {%- comment -%} NF-CART-V3: beige bar under the title (MOD "Free Shipping Available"), with our real Buy 2+/3+ discount line {%- endcomment -%}
    <div class="nf-cd-bar">
      <p class="nf-cd-bar__ship"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M1.6 5.6h11v9h-11z" stroke="currentColor" stroke-width="1.3"/><path d="M12.6 8.4h4.2l3.6 3.4v2.8h-7.8z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/><circle cx="6" cy="17.4" r="1.7" stroke="currentColor" stroke-width="1.3"/><circle cx="16.7" cy="17.4" r="1.7" stroke="currentColor" stroke-width="1.3"/></svg>Free shipping on this order</p>
      {%- render 'nf-promo-cart', part: 'gamify' -%}
      {%- render 'nf-promo-cart' -%}{%- comment -%} NF-PROMO-WINDOWS (2026-10-19): Buy 2/3 line (hidden during Black Friday), then the Fall Hosting Event / Black Friday line, each only inside its real window {%- endcomment -%}
    </div>
    <div class="cart-drawer__items">
      {%- for line_item in cart.items -%}
        {%- if line_item.product.tags contains 'membership-product' -%}{%- continue -%}{%- endif -%}
        {%- render 'nf-drawer-line', line_item: line_item -%}
      {%- endfor -%}
    </div>
    {%- comment -%} NF-CD-YML (2026-10-19, owner 22:29): "You may also like" showcase row under the lines {%- endcomment -%}
    {%- render 'nf-cd-yml' -%}
    {%- comment -%} NF-CART-V3: MOD's two fold-out rows under the items {%- endcomment -%}
    <div class="nf-cd-info">
      <details class="nf-cd-fold">
        <summary>30-day returns<svg viewBox="0 0 12 12" aria-hidden="true"><path d="M2 4l4 4 4-4"/></svg></summary>
        <p>Changed your mind? Send it back within 30 days of delivery. If it arrives damaged, defective or incorrect, the return is on us. See our <a href="{{ shop.refund_policy.url | default: '/policies/refund-policy' }}">Refund Policy</a>.</p>
      </details>
      <details class="nf-cd-fold">
        <summary>Questions? Real people answer<svg viewBox="0 0 12 12" aria-hidden="true"><path d="M2 4l4 4 4-4"/></svg></summary>
        <p>Email <a href="mailto:info@norafurnish.com">info@norafurnish.com</a>, Monday to Friday, 9 AM to 5 PM CT. We help with sizing, finishes and installation before you order.</p>
      </details>
    </div>
    {%- comment -%} NF-TRADE (2026-10-16): membership row removed from the drawer (owner). snippets/nf-member-cart.liquid is kept, unrendered. {%- endcomment -%}

    {%- liquid
      assign cross_sell_products_count = 0

      for product in section.settings.cross_sell_products
        assign items_for_product = cart | line_items_for: product

        if items_for_product.size == 0 and product.available
          assign cross_sell_products_count = cross_sell_products_count | plus: 1
        endif
      endfor
    -%}

    {%- if cross_sell_products_count > 0 -%}
      <div class="cart-drawer__complementary-products complementary-products">
        {%- assign carousel_id = 'complementary-products-carousel-' | append: section.id -%}

        {%- if section.settings.cross_sell_title != blank or section.settings.cross_sell_stack_products == false and cross_sell_products_count > 1 -%}
          <div class="complementary-products__header complementary-products__header--align-start">
            <p class="h6">{{ section.settings.cross_sell_title }}</p>

            {%- if section.settings.cross_sell_stack_products == false and cross_sell_products_count > 1 -%}
              <carousel-navigation aria-controls="{{ carousel_id }}" class="page-dots page-dots--narrow">
                {%- for i in (1..cross_sell_products_count) -%}
                  <button class="relative" aria-current="{% if forloop.first %}true{% else %}false{% endif %}">
                    <span class="sr-only">{{ 'general.accessibility.go_to_item' | t: index: forloop.index }}</span>
                  </button>
                {%- endfor -%}
              </carousel-navigation>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- liquid
          capture complementary_products
            for product in section.settings.cross_sell_products
              assign products_in_cart = cart.items | where: 'product_id', product.id

              if products_in_cart.size == 0 and product.available
                render 'product-card-horizontal', product: product, show_quick_buy: true
              endif
            endfor
          endcapture
        -%}

        {%- if section.settings.cross_sell_stack_products -%}
          <div class="complementary-products__product-list">
            {{- complementary_products -}}
          </div>
        {%- else -%}
          <scroll-carousel id="{{ carousel_id }}" class="complementary-products__product-list complementary-products__product-list--carousel scroll-area bleed snap-x">
            {{- complementary_products -}}
          </scroll-carousel>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- comment -%} NF-CART-V2 "Pairs well with" strip removed 2026-10-19: replaced by the "You may also like" row (snippets/nf-cd-yml.liquid). {%- endcomment -%}

    <div slot="footer">
      {%- render 'nf-cd-footer' -%}
    </div>
  {%- endif -%}
</cart-drawer>
{%- comment -%} NF-CART-V3 (2026-10-19, owner 22:29 cart list): footer, "You may also like", wishlist heart, quantity loading, stale guard {%- endcomment -%}
{{ 'nf-cart-v3.css' | asset_url | stylesheet_tag }}
<script src="{{ 'nf-cart-v3.js' | asset_url }}" defer></script>

{%- comment -%} NF-CART-V3 (2026-10-15): MOD-style cart. Look, and the slide: up from the bottom on phones (full screen), in from the
  right on desktop, 0.5s on MOD's easing, backdrop fades in 0.32s; closing is 0.3s. Replaces Prestige's 0.3s snap. {%- endcomment -%}
<style>
  html body cart-drawer#cart-drawer.cart-drawer{--nf-cd-ink:#1c1c1c;--nf-cd-sub:#5c5047;--nf-cd-line:#e4e0da;--nf-cd-beige:#ece6dd;--nf-cd-gold:#c9a36a}
  html body cart-drawer#cart-drawer.cart-drawer::part(header){padding-block:18px 14px;border-bottom:0}
  html body cart-drawer#cart-drawer.cart-drawer .nf-cd-title{display:flex!important;align-items:baseline;gap:10px;margin:0!important;font-family:"EB Garamond",Georgia,serif!important;font-size:27px!important;font-weight:400!important;letter-spacing:0!important;text-transform:none!important;color:var(--nf-cd-ink)!important;line-height:1.1}
  html body cart-drawer#cart-drawer.cart-drawer .nf-cd-count{font-family:"EB Garamond",Georgia,serif;font-size:17px;color:var(--nf-cd-sub)}
  html body cart-drawer#cart-drawer.cart-drawer .nf-cd-bar{background:var(--nf-cd-beige);margin:0 0 4px;padding:11px 24px}
  html body cart-drawer#cart-drawer.cart-drawer .nf-cd-bar__ship{display:flex;align-items:center;gap:8px;margin:0;font-family:"Poppins",sans-serif;font-size:13.5px;font-weight:500;color:var(--nf-cd-ink)}
  html body cart-drawer#cart-drawer.cart-drawer .nf-cd-bar__ship svg{width:18px;height:18px;flex:0 0 auto}
  html body cart-drawer#cart-drawer.cart-drawer .nf-cd-bar .nf-cv2-progress{display:block!important;margin:4px 0 0!important;padding:0!important;border:0!important;background:none!important;text-align:left!important}
  html body cart-drawer#cart-drawer.cart-drawer .nf-cd-bar .nf-gm-track{display:none!important}
  html body cart-drawer#cart-drawer.cart-drawer .nf-cd-bar .nf-cv2-progress__text{display:block!important;margin:0!important;padding-left:26px;justify-content:flex-start!important;font-size:12.5px!important;color:var(--nf-cd-sub)!important;text-align:left!important}
  html body cart-drawer#cart-drawer.cart-drawer .nf-cd-bar .nf-cv2-progress__text strong{color:var(--nf-cd-ink)}
  /* line items */
  html body cart-drawer#cart-drawer.cart-drawer .cart-drawer__items{margin:0!important}
  html body cart-drawer#cart-drawer.cart-drawer .nf-dl{display:grid!important;grid-template-columns:84px minmax(0,1fr)!important;gap:14px!important;align-items:start;padding:18px 24px!important;border-bottom:1px solid var(--nf-cd-line)!important;margin:0!important}
  html body cart-drawer#cart-drawer.cart-drawer .nf-dl__img{width:84px!important;height:84px!important;border-radius:3px;overflow:hidden;background:#f4f1ec}
  html body cart-drawer#cart-drawer.cart-drawer .nf-dl__img img{width:100%;height:100%;object-fit:cover}
  html body cart-drawer#cart-drawer.cart-drawer .nf-dl__info{display:block!important;min-width:0}
  html body cart-drawer#cart-drawer.cart-drawer .nf-dl__top{display:flex;justify-content:space-between;align-items:flex-start;gap:12px}
  html body cart-drawer#cart-drawer.cart-drawer .nf-dl__t{display:-webkit-box!important;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;font-family:"EB Garamond",Georgia,serif!important;font-size:18px!important;font-weight:400!important;line-height:1.25!important;color:var(--nf-cd-ink)!important;text-decoration:none!important}
  html body cart-drawer#cart-drawer.cart-drawer .nf-dl__price{flex:0 0 auto;display:flex!important;flex-direction:column;align-items:flex-end;margin:0!important;font-family:"Poppins",sans-serif;font-size:15px;color:var(--nf-cd-ink)}
  html body cart-drawer#cart-drawer.cart-drawer .nf-dl__ps{color:#1c1c1c!important;font-weight:500}
  html body cart-drawer#cart-drawer.cart-drawer .nf-dl__pc{font-size:12.5px;color:#8a8178}
  html body cart-drawer#cart-drawer.cart-drawer .nf-dl__v{margin:4px 0 10px!important;font-size:13px!important;color:#8a8178!important;line-height:1.4}
  html body cart-drawer#cart-drawer.cart-drawer .nf-dl__ctl{display:flex!important;flex-flow:row nowrap!important;align-items:center!important;justify-content:space-between!important;gap:12px;margin:0!important;grid-template-columns:none!important;grid-template-areas:none!important}
  html body cart-drawer#cart-drawer.cart-drawer .nf-dl__ctl>*{grid-area:auto!important}
  html body cart-drawer#cart-drawer.cart-drawer .nf-dl__ctl .quantity-selector__input-wrapper,html body cart-drawer#cart-drawer.cart-drawer .nf-dl__ctl .quantity-selector__input{border:0!important;box-shadow:none!important;background:none!important}
  html body cart-drawer#cart-drawer.cart-drawer .nf-dl__ctl quantity-selector{border:0!important;background:none!important;height:34px!important;width:auto!important;gap:4px}
  html body cart-drawer#cart-drawer.cart-drawer .nf-dl__ctl .quantity-selector__button{width:30px!important;height:34px!important;color:var(--nf-cd-ink)!important}
  html body cart-drawer#cart-drawer.cart-drawer .nf-dl__ctl .quantity-selector__input{font-size:15px!important;min-width:22px;text-align:center}
  html body cart-drawer#cart-drawer.cart-drawer .nf-dl__acts{display:flex!important;align-items:center;gap:16px;margin:0 0 0 auto!important;padding:0!important;width:auto!important;flex:0 0 auto!important;border:0!important}
  html body cart-drawer#cart-drawer.cart-drawer .nf-dl__acts button,html body cart-drawer#cart-drawer.cart-drawer .nf-dl__acts a{display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;padding:0;border:0;background:none;color:var(--nf-cd-ink);font-size:0}
  html body cart-drawer#cart-drawer.cart-drawer .nf-dl__acts svg{width:21px;height:21px;fill:none;stroke:currentColor;stroke-width:1.4;stroke-linecap:round;stroke-linejoin:round}
  /* fold-out rows */
  html body cart-drawer#cart-drawer.cart-drawer .nf-cd-info{margin:2px 0 14px;padding:0 24px}
  html body cart-drawer#cart-drawer.cart-drawer .nf-cd-fold{border-bottom:1px solid var(--nf-cd-line)}
  html body cart-drawer#cart-drawer.cart-drawer .nf-cd-fold summary{list-style:none;display:flex;align-items:center;justify-content:space-between;gap:10px;padding:15px 0;cursor:pointer;font-family:"Poppins",sans-serif;font-size:14.5px;font-weight:500;color:var(--nf-cd-ink)}
  html body cart-drawer#cart-drawer.cart-drawer .nf-cd-fold summary::-webkit-details-marker{display:none}
  html body cart-drawer#cart-drawer.cart-drawer .nf-cd-fold summary svg{width:12px;height:12px;fill:none;stroke:currentColor;stroke-width:1.5;transition:transform .25s ease}
  html body cart-drawer#cart-drawer.cart-drawer .nf-cd-fold[open] summary svg{transform:rotate(180deg)}
  html body cart-drawer#cart-drawer.cart-drawer .nf-cd-fold p{margin:0 0 15px;font-size:13.5px;line-height:1.6;color:var(--nf-cd-sub)}
  html body cart-drawer#cart-drawer.cart-drawer .nf-cd-fold a{color:var(--nf-cd-ink);text-decoration:underline;text-underline-offset:3px}
  /* footer */
  html body cart-drawer#cart-drawer.cart-drawer .nf-cd-form{display:flex!important;flex-direction:column!important;align-items:stretch!important;padding:14px 0 26px!important;box-sizing:border-box!important;width:100%!important;max-width:100%!important;grid-template-columns:none!important}
  html body cart-drawer#cart-drawer.cart-drawer .nf-cd-form>*{grid-column:auto!important;flex:none!important;margin-left:0!important;margin-right:0!important;max-width:100%!important;min-width:0!important;box-sizing:border-box!important}
  html body cart-drawer#cart-drawer.cart-drawer .nf-cd-form .nf-cd-checkout{order:1}
  html body cart-drawer#cart-drawer.cart-drawer .nf-cd-form .nf-cd-view{order:2}
  html body cart-drawer#cart-drawer.cart-drawer .nf-cd-form .nf-cd-trust{order:3}
  html body cart-drawer#cart-drawer.cart-drawer .nf-cd-form .nf-cd-pay{order:4}
  html body cart-drawer#cart-drawer.cart-drawer .nf-cd-form .nf-cd-note{order:5}
  html body cart-drawer#cart-drawer.cart-drawer .nf-promo{border:0!important;margin:0 0 12px!important;padding:0!important}
  html body cart-drawer#cart-drawer.cart-drawer .nf-promo__trigger{display:none!important}
  html body cart-drawer#cart-drawer.cart-drawer .nf-promo__body,html body cart-drawer#cart-drawer.cart-drawer .nf-promo__body[hidden]{display:block!important;padding:0!important}
  html body cart-drawer#cart-drawer.cart-drawer .nf-promo__row{display:flex!important;gap:10px!important}
  html body cart-drawer#cart-drawer.cart-drawer .nf-promo__input{flex:1 1 auto;min-width:0;height:46px!important;border:1px solid #d9d3cb!important;border-radius:4px!important;padding:0 14px!important;font-size:15px!important;background:#fff!important}
  html body cart-drawer#cart-drawer.cart-drawer .nf-promo__apply{height:46px!important;padding:0 22px!important;border:1px solid var(--nf-cd-ink)!important;border-radius:4px!important;background:#fff!important;color:var(--nf-cd-ink)!important;font-size:15px!important;font-weight:500!important}
  html body cart-drawer#cart-drawer.cart-drawer .nf-cd-sub{display:flex!important;justify-content:space-between!important;margin:6px 0 14px!important;padding:12px 0 0!important;border-top:1px solid var(--nf-cd-line)!important;font-family:"Poppins",sans-serif;font-size:17px!important;font-weight:600!important;color:var(--nf-cd-ink)!important}
  html body cart-drawer#cart-drawer.cart-drawer .nf-cd-checkout{width:100%!important;height:50px!important;border:0!important;border-radius:2px!important;background:var(--nf-cd-gold)!important;color:var(--nf-cd-ink)!important;font-family:"Poppins",sans-serif!important;font-size:14px!important;font-weight:600!important;letter-spacing:.16em!important;text-transform:uppercase!important;box-shadow:none!important}
  html body cart-drawer#cart-drawer.cart-drawer .nf-cd-view{display:flex!important;align-items:center;justify-content:center;width:100%;height:46px!important;margin-top:8px!important;border:1px solid #cfc8be!important;border-radius:2px!important;background:#fff!important;color:var(--nf-cd-ink)!important;font-family:"Poppins",sans-serif!important;font-size:13px!important;font-weight:600!important;letter-spacing:.16em!important;text-transform:uppercase!important;text-decoration:none!important}
  html body cart-drawer#cart-drawer.cart-drawer .nf-cd-trust{display:flex;gap:20px;margin-top:14px;font-family:"Poppins",sans-serif;font-size:12.5px;color:var(--nf-cd-ink)}
  html body cart-drawer#cart-drawer.cart-drawer .nf-cd-trust span{display:inline-flex;align-items:center;gap:7px}
  html body cart-drawer#cart-drawer.cart-drawer .nf-cd-trust svg{width:18px;height:18px}
  html body cart-drawer#cart-drawer.cart-drawer .nf-cd-pay{display:flex;flex-wrap:wrap;gap:6px;margin-top:10px}
  html body cart-drawer#cart-drawer.cart-drawer .nf-cd-pay__i{width:36px;height:23px}
  html body cart-drawer#cart-drawer.cart-drawer .nf-cd-note{margin:8px 0 0!important;font-size:11.5px!important;color:#8a8178!important;text-align:left!important}
  html body cart-drawer#cart-drawer.cart-drawer .nf-mc{margin:0 0 12px!important}
  body:has(#cart-drawer[open]) .nf-gm-toast{display:none!important}
  @media (max-width:699px){
    /* full screen, one scroll for everything (MOD) */
    html body cart-drawer#cart-drawer.cart-drawer::part(content){width:100%!important;max-width:100%!important;height:100%!important;max-height:100%!important;margin:0!important;inset:0!important;border-radius:0!important;overflow-y:auto!important;overscroll-behavior:contain;display:block!important}
    html body cart-drawer#cart-drawer.cart-drawer::part(body){overflow:visible!important;max-height:none!important;flex:none!important}
    html body cart-drawer#cart-drawer.cart-drawer::part(footer){position:static!important;box-shadow:none!important;border-top:0!important}
    html body cart-drawer#cart-drawer.cart-drawer::part(header){position:sticky;top:0;z-index:2;background:#fff}
  }
</style>
<script>
(function () {
  if (window.__nfCdAnim) return; window.__nfCdAnim = 1;
  var EASE = 'cubic-bezier(.455,.03,.515,.955)';
  function ctl(list) {
    return {
      finished: Promise.all(list.map(function (a) { return a.finished; })).then(function () {}, function () {}),
      finish: function () { list.forEach(function (a) { try { a.finish(); } catch (e) {} }); },
      cancel: function () { list.forEach(function (a) { try { a.cancel(); } catch (e) {} }); }
    };
  }
  customElements.whenDefined('cart-drawer').then(function () {
    var C = customElements.get('cart-drawer'); if (!C || C.prototype.__nfAnim) return; C.prototype.__nfAnim = 1;
    var origIn = C.prototype.createEnterAnimationControls, origOut = C.prototype.createLeaveAnimationControls;
    function parts(el) { return [el.getShadowPartByName && el.getShadowPartByName('overlay'), el.getShadowPartByName && el.getShadowPartByName('content')]; }
    /* NF-M4 (2026-10-21, owner: "copy MOD's cart drawer ... the same slide in from right to left"): phones slide in from the right too (was up from the bottom) */
    function from() { return 'translateX(calc(var(--transform-logical-flip, 1) * 100%))'; }
    C.prototype.createEnterAnimationControls = function () {
      var p = parts(this); if (!p[0] || !p[1] || !p[1].animate) return origIn.call(this);
      if (this.__nfA) this.__nfA.cancel();
      p[1].style.marginInlineStart = 'auto';
      return (this.__nfA = ctl([
        p[0].animate({ opacity: [0, 1] }, { duration: 320, easing: EASE, fill: 'both' }),
        p[1].animate({ transform: [from(), 'translate(0, 0)'] }, { duration: 500, easing: EASE, fill: 'both' })
      ]));
    };
    C.prototype.createLeaveAnimationControls = function () {
      var p = parts(this); if (!p[0] || !p[1] || !p[1].animate) return origOut.call(this);
      if (this.__nfA) this.__nfA.cancel();
      return (this.__nfA = ctl([
        p[0].animate({ opacity: [1, 0] }, { duration: 300, easing: EASE, fill: 'both' }),
        p[1].animate({ transform: ['translate(0, 0)', from()] }, { duration: 300, easing: EASE, fill: 'both' })
      ]));
    };
  });
})();
</script>

{% schema %}
{
  "name": "t:sections.cart_drawer.name",
  "class": "shopify-section--cart-drawer",
  "tag": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.cart_drawer.page_info"
    },
    {
      "type": "paragraph",
      "content": "t:sections.cart_drawer.free_shipping_bar_info"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "show_cart_note",
      "label": "t:sections.cart_drawer.show_cart_note",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "allow_discount_application",
      "label": "t:sections.cart_drawer.allow_discount_application",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_shipping_text",
      "label": "t:sections.cart_drawer.show_shipping_text",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_view_cart_button",
      "label": "t:sections.cart_drawer.show_view_cart_button",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_checkout_button",
      "label": "t:sections.cart_drawer.show_checkout_button",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_price_in_checkout_button",
      "label": "t:sections.cart_drawer.show_price_in_checkout_button",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.cart_drawer.cross_sell_category"
    },
    {
      "type": "product_list",
      "id": "cross_sell_products",
      "label": "t:sections.cart_drawer.cross_sell_products",
      "info": "t:sections.cart_drawer.cross_sell_products_info",
      "limit": 5
    },
    {
      "type": "inline_richtext",
      "id": "cross_sell_title",
      "label": "t:sections.cart_drawer.cross_sell_heading",
      "default": "Complete with",
      "visible_if": "{{ section.settings.cross_sell_products != blank }}"
    },
    {
      "type": "checkbox",
      "id": "cross_sell_stack_products",
      "label": "t:sections.cart_drawer.cross_sell_stack_products",
      "default": false,
      "visible_if": "{{ section.settings.cross_sell_products != blank }}"
    }
  ]
}
{% endschema %}
