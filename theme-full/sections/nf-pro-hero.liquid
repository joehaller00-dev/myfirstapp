{%- comment -%} nf-pro-hero (Professionals, 2026-09-11). Split or banner hero. Image by Files name through snippets/nf-pro-media. {%- endcomment -%}
{{- 'nf-pro.css' | asset_url | stylesheet_tag -}}
{{- 'nf-pro2.css' | asset_url | stylesheet_tag -}}{%- comment -%} NF-PRO-V2: rhythm, uppercase headings, gold buttons {%- endcomment -%}
{{- 'nf-rhythm.css' | asset_url | stylesheet_tag -}}{%- comment -%} NF-RHYTHM-V1: charcoal bands, photo tiles {%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign facts = s.facts | newline_to_br | split: '<br />'
-%}
{%- capture hero_text -%}
  {%- if s.crumb_label != blank -%}
    <ol class="nfp-crumbs">
      <li><a href="/">Home</a></li>
      {%- if s.crumb_parent -%}<li><a href="/pages/professionals">Professionals</a></li>{%- endif -%}
      <li aria-current="page">{{ s.crumb_label | escape }}</li>
    </ol>
  {%- endif -%}
  {%- if s.eyebrow != blank -%}<p class="nfp-eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
  <h1 class="nfp-h1">{{ s.heading | default: page.title | escape }}</h1>
  {%- if s.text != blank -%}<p class="nfp-lead">{{ s.text | escape }}</p>{%- endif -%}
  {%- if s.btn1_label != blank or s.btn2_label != blank or s.link_label != blank -%}
    <div class="nfp-actions">
      {%- if s.btn1_label != blank -%}<a class="nfp-btn nfp-btn--{{ s.btn1_style }}" href="{{ s.btn1_url }}">{{ s.btn1_label | escape }}{% if s.btn1_style == 'browse' %} <span class="nfp-arrow" aria-hidden="true">&rarr;</span>{% endif %}</a>{%- endif -%}
      {%- if s.btn2_label != blank -%}<a class="nfp-btn nfp-btn--{{ s.btn2_style }}" href="{{ s.btn2_url }}">{{ s.btn2_label | escape }}{% if s.btn2_style == 'browse' %} <span class="nfp-arrow" aria-hidden="true">&rarr;</span>{% endif %}</a>{%- endif -%}
      {%- if s.link_label != blank -%}<a class="nfp-link" href="{{ s.link_url }}">{{ s.link_label | escape }} <span class="nfp-arrow" aria-hidden="true">&rarr;</span></a>{%- endif -%}
    </div>
  {%- endif -%}
  {%- if s.facts != blank -%}
    <ul class="nfp-facts">
      {%- for f in facts -%}{%- assign ft = f | strip -%}{%- if ft != blank -%}<li>{{ ft | escape }}</li>{%- endif -%}{%- endfor -%}
    </ul>
  {%- endif -%}
{%- endcapture -%}

<section class="nfp nfp--{{ s.bg }} nfp-hero nfp-hero--{{ s.layout }}">
  <div class="nfp-wrap">
    {%- if s.layout == 'banner' -%}
      <div class="nfp-hero__stage">
        <div class="nfp-media nfp-hero__bg">
          {%- render 'nf-pro-media', file: s.image_file, alt: s.image_alt, fallback: s.fallback_collection, sizes: '(max-width: 1320px) 100vw, 1320px', eager: true, label: s.heading -%}
        </div>
        <div class="nfp-hero__card">{{ hero_text }}</div>
      </div>
    {%- else -%}
      <div class="nfp-hero__grid">
        <div class="nfp-hero__text">{{ hero_text }}</div>
        <div class="nfp-media nfp-hero__media">
          {%- render 'nf-pro-media', file: s.image_file, alt: s.image_alt, fallback: s.fallback_collection, sizes: '(max-width: 899px) 100vw, 55vw', eager: true, label: s.heading -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "NF Pro hero",
  "class": "nfp-shell",
  "settings": [
    { "type": "select", "id": "layout", "label": "Layout", "default": "split", "options": [ { "value": "split", "label": "Text and image" }, { "value": "banner", "label": "Wide image with card" } ] },
    { "type": "select", "id": "bg", "label": "Background", "default": "cream", "options": [ { "value": "cream", "label": "Cream" }, { "value": "sand", "label": "Sand" }, { "value": "white", "label": "White" }, { "value": "charcoal", "label": "Charcoal" } ] },
    { "type": "text", "id": "crumb_label", "label": "Breadcrumb label", "info": "Leave blank to hide breadcrumbs" },
    { "type": "checkbox", "id": "crumb_parent", "label": "Show Professionals in breadcrumb", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "image_file", "label": "Image file name in Content > Files", "info": "For example nf-pro-hub.jpg. A warm panel shows until the file exists." },
    { "type": "text", "id": "image_alt", "label": "Image alt text" },
    { "type": "text", "id": "fallback_collection", "label": "Fallback collection handle" },
    { "type": "text", "id": "btn1_label", "label": "Button 1 label" },
    { "type": "text", "id": "btn1_url", "label": "Button 1 link" },
    { "type": "select", "id": "btn1_style", "label": "Button 1 style", "default": "primary", "options": [ { "value": "gold", "label": "Gold" }, { "value": "outline", "label": "Gold outline" }, { "value": "primary", "label": "Primary" }, { "value": "secondary", "label": "Secondary" }, { "value": "browse", "label": "Browse" } ] },
    { "type": "text", "id": "btn2_label", "label": "Button 2 label" },
    { "type": "text", "id": "btn2_url", "label": "Button 2 link" },
    { "type": "select", "id": "btn2_style", "label": "Button 2 style", "default": "browse", "options": [ { "value": "gold", "label": "Gold" }, { "value": "outline", "label": "Gold outline" }, { "value": "primary", "label": "Primary" }, { "value": "secondary", "label": "Secondary" }, { "value": "browse", "label": "Browse" } ] },
    { "type": "text", "id": "link_label", "label": "Quiet link label" },
    { "type": "text", "id": "link_url", "label": "Quiet link" },
    { "type": "textarea", "id": "facts", "label": "Facts", "info": "One per line" }
  ]
}
{% endschema %}
