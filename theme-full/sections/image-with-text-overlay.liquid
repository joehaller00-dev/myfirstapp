}
#shopify-section-{{ section.id }} .content .prose .h1,#shopify-section-{{ section.id }} .content .prose > div:first-child p{ text-align:center !important; align-self:center !important; margin-left:0 !important; }
}
{%- endif -%}
</style>

  {%- comment -%}
    ------------------------------------------------------------------------------------------------------------------------
    LIQUID
    ------------------------------------------------------------------------------------------------------------------------
  {%- endcomment -%}

  <div
    class="{% unless section.settings.remove_vertical_spacing %}section-spacing{% endunless %} color-scheme color-scheme--{{ section.settings.color_scheme.id }} color-scheme--with-image-overlay"
    {% if section.settings.allow_transparent_header %}
      allow-transparent-header
    {% endif %}
  >
    <image-with-text-overlay class="content-over-media content-over-media--{{ section.settings.image_size }}" reveal-on-scroll="{{ section.settings.reveal_on_scroll }}">
      {%- if section.settings.image != blank -%}
        {%- comment -%}NF-PERF2-0911: the homepage hero (TebrQa) is the LCP image, so it loads eager with fetchpriority high.
          Any other use of this section that is not the first section on its template (e.g. the Best Sellers banner on
          product pages) lazy loads, so it no longer competes with that page's own LCP image.{%- endcomment -%}
        {%- liquid
          assign nf_perf2_loading = 'eager'
          assign nf_perf2_priority = 'auto'
          if section.id contains 'image_with_text_overlay_TebrQa'
            assign nf_perf2_priority = 'high'
          elsif section.index > 1
            assign nf_perf2_loading = 'lazy'
          endif
        -%}
        <picture>
          {%- comment -%} NF-SPEED-0913 (round 2): phones up to 499px get a portrait crop of exactly the strip they see (custom-nav.css puts
            the hero at object-position 62% 55% on mobile), cut on Shopify's CDN, so they download ~92KB instead of the 149KB landscape
            file and the picture looks the same. crop_left = 0.62 x (width - crop width) keeps the visible region identical on every
            phone width. Only for landscape hero photos; anything else falls through to the sources below. {%- endcomment -%}
          {%- if section.id contains 'image_with_text_overlay_TebrQa' and section.settings.image.aspect_ratio > 1.2 -%}
            {%- liquid
              assign nfh = section.settings.image
              assign nfh_h = nfh.height
              assign nfh_cw = nfh_h | times: 0.952 | round
              assign nfh_cl = nfh.width | minus: nfh_cw | times: 0.04 | round
            -%}
            <source
              media="(max-width: 499px)"
              srcset="{{ nfh | image_url: width: 360, crop: 'region', crop_left: nfh_cl, crop_top: 0, crop_width: nfh_cw, crop_height: nfh_h }} 360w, {{ nfh | image_url: width: 450, crop: 'region', crop_left: nfh_cl, crop_top: 0, crop_width: nfh_cw, crop_height: nfh_h }} 450w, {{ nfh | image_url: width: 550, crop: 'region', crop_left: nfh_cl, crop_top: 0, crop_width: nfh_cw, crop_height: nfh_h }} 550w"
              sizes="460px"
              width="550"
              height="578"
            >
          {%- endif -%}
          {%- if section.id == 'image_with_text_overlay_rxf9er' -%}
            <source
              media="(max-width: 699px)"
              srcset="{{ 'comfort_mobile_portrait.jpg' | asset_url }}"
              width="900"
              height="1200"
            >
          {%- elsif section.settings.mobile_image != blank -%}
            <source
              media="(max-width: 699px)"
              srcset="{{ section.settings.mobile_image | image_url: width: 400 }} 400w, {{ section.settings.mobile_image | image_url: width: 600 }} 600w, {{ section.settings.mobile_image | image_url: width: 800 }} 800w, {{ section.settings.mobile_image | image_url: width: 1000 }} 1000w"
              sizes="100vw"
              width="{{ section.settings.mobile_image.width }}"
              height="{{ section.settings.mobile_image.height }}"
            >
          {%- endif -%}

          {{-
            section.settings.image
            | image_url: width: section.settings.image.width
            | image_tag: sizes: '100vw', widths: '200,300,400,500,600,700,800,900,1000,1200,1400,1600,1800,2000,2200,2400,2600,2800,3000,3200', loading: nf_perf2_loading, fetchpriority: nf_perf2_priority
          -}}
        </picture>
      {%- else -%}
        {{- 'lifestyle-1' | placeholder_svg_tag: 'placeholder' | replace: '<svg', '<svg preserveAspectRatio="xMinYMin slice"' -}}
      {%- endif -%}

      {%- if section.id contains 'image_with_text_overlay_TebrQa' -%}
        {%- assign hero_btn_url = '' -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'button' and block.settings.url != blank -%}
            {%- assign hero_btn_url = block.settings.url -%}
          {%- endif -%}
        {%- endfor -%}
        {%- if hero_btn_url != blank -%}
          <a class="hero-cover-link" href="{{ hero_btn_url }}" aria-label="Shop Best Sellers"></a>
        {%- endif -%}
      {%- endif -%}
      {%- if section.blocks.size > 0 -%}
        <div class="content {{ section.settings.mobile_text_position }} {{ section.settings.desktop_text_position }}">
          <div class="prose">
            {%- if section.id == 'image_with_text_overlay_rxf9er' -%}
              <div class="rxf9er-gold-line"></div>
            {%- endif -%}
            {%- for block in section.blocks -%}
              {%- case block.type -%}
                {%- when 'subheading' -%}
                  {%- if block.settings.text != blank -%}
                    <p class="h6" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>
                  {%- endif -%}

                {%- when 'heading' -%}
                  {%- if block.settings.text != blank -%}
                    {%- if section.id contains 'image_with_text_overlay_TebrQa' -%}
                      <p class="{{ block.settings.heading_tag }}" style="font-size:var(--hero-h-size, 58px) !important;  line-height:1.15 !important; font-weight:var(--hero-h-weight, 400) !important; letter-spacing:0 !important; color:var(--nf-hero-ink,#ffffff) !important; -webkit-text-fill-color:var(--nf-hero-ink,#ffffff) !important; opacity:1 !important; text-shadow:var(--hero-h-shadow, 0 1px 3px rgba(0,0,0,0.6), 0 2px 12px rgba(0,0,0,0.5)) !important; margin-top:0 !important; margin-bottom:var(--hero-h-mb, 18px) !important; margin-right:0 !important; margin-left:var(--hero-h-ml, 0px) !important;" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>
                    {%- else -%}
                      <p class="{{ block.settings.heading_tag }}" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>
                    {%- endif -%}
                  {%- endif -%}

                {%- when 'richtext' -%}
                  {%- if block.settings.content != blank -%}
                    {%- if section.id contains 'image_with_text_overlay_TebrQa' -%}
                      <div style="font-size:var(--hero-p-size, 17px) !important; line-height:1.2 !important; font-weight:400 !important; letter-spacing:0 !important; color:var(--nf-hero-ink,#ffffff) !important; -webkit-text-fill-color:var(--nf-hero-ink,#ffffff) !important; opacity:1 !important; text-shadow:var(--hero-p-shadow, 0 1px 3px rgba(0,0,0,0.5)) !important; margin-top:0 !important; margin-bottom:var(--hero-p-mb, 18px) !important; margin-right:0 !important; margin-left:var(--hero-p-ml, 0px) !important;" {{ block.shopify_attributes }}>
                        {{- block.settings.content -}}
                      </div>
                    {%- else -%}
                      <div {{ block.shopify_attributes }}>
                        {{- block.settings.content -}}
                      </div>
                    {%- endif -%}
                  {%- endif -%}

                {%- when 'liquid' -%}
                  {%- if block.settings.liquid != blank -%}
                    <div {{ block.shopify_attributes }}>
                      {{- block.settings.liquid -}}
                    </div>
                  {%- endif -%}

                {%- when 'button' -%}
                  {%- if block.settings.text != blank -%}
                    {%- render 'button',
                      content: block.settings.text,
                      href: block.settings.url,
                      style: block.settings.style,
                      background: block.settings.background,
                      text_color: block.settings.text_color,
                      block: block
                    -%}
                  {%- endif -%}

                {%- when 'link' -%}
                  {%- if block.settings.text != blank -%}
                    <div {{ block.shopify_attributes }}>
                      <a href="{{ block.settings.url }}">{{ block.settings.text }}</a>
                    </div>
                  {%- endif -%}
              {%- endcase -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    </image-with-text-overlay>
  </div>
{%- endif -%}

