{%- if section.settings.image != blank or section.blocks.size > 0 -%}
  {%- comment -%}
    ------------------------------------------------------------------------------------------------------------------------
    CSS
    ------------------------------------------------------------------------------------------------------------------------
  {%- endcomment -%}

  <style>
    #shopify-section-{{ section.id }} {
      {%- if section.settings.overlay_color != 'rgba(0,0,0,0)' -%}
        --content-over-media-overlay: {{ section.settings.overlay_color.rgb }} / {{ section.settings.overlay_opacity | divided_by: 100.0 }};
      {%- endif -%}

      --content-over-media-content-max-width: var(--container-{{ section.settings.content_width }}-max-width);

      --text-color: 255 255 255;
      --heading-color: 255 255 255;
      --button-background: 255 255 255;
      --button-text-color: 17 17 17;
      --border-color: 255 255 255;

      --hero-h-size: 68px;
      --hero-h-weight: 700;
      --hero-h-mb: 18px;
      --hero-p-size: 20px;
      --hero-p-mb: 18px;
    }

        /* Tight letter-spacing for heading on product best-sellers banner */
    #shopify-section-{{ section.id }} .content-over-media p {
      letter-spacing: 0.75px !important;
    }

    /* Desktop: xs height for products/FAQ, big hero for home page */
    @media screen and (min-width: 700px) {
      #shopify-section-{{ section.id }} .content-over-media {
        --content-over-media-height: clamp(15rem, 65vw, 25rem) !important;
      }
    }

    {%- if section.id contains 'image_with_text_overlay_TebrQa' -%}
    @media screen and (min-width: 700px) {
      #shopify-section-{{ section.id }} .content-over-media {
        --content-over-media-height: clamp(60rem, 100vh, 85rem) !important;
      }
    }
    @media screen and (min-width: 700px) {
      #shopify-section-{{ section.id }} .content .prose .h1,
      #shopify-section-{{ section.id }} .content .prose h1 {
        white-space: nowrap !important;
      }
    }
    @media screen and (max-width: 699px) {
      #shopify-section-{{ section.id }} .content-over-media {
        --content-over-media-height: clamp(38rem, 130vw, 55rem) !important;
      }
      #shopify-section-{{ section.id }} {
        --hero-h-size: clamp(16px, 5.5vw, 22px);
      }
      /* Mobile: McGee & Co style - left aligned, upper left */
      #shopify-section-{{ section.id }} .content {
        padding-top: 35px !important;
        padding-left: 20px !important;
        padding-right: 20px !important;
        width: 100% !important;
        place-self: start center !important;
        justify-self: center !important;
        align-items: center !important;
        text-align: center !important;
      }
      /* Constrain heading width on mobile to force 2-line wrap */
      #shopify-section-{{ section.id }} .content .prose .h1,
      #shopify-section-{{ section.id }} .content .prose .h2,
      #shopify-section-{{ section.id }} .content .prose .h3,
      #shopify-section-{{ section.id }} .content .prose h1,
      #shopify-section-{{ section.id }} .content .prose h2,
      #shopify-section-{{ section.id }} .content .prose h3 {
        max-width: 100% !important;
        text-align: center !important;
        font-weight: 900 !important;
        text-shadow: none !important;
        font-size: clamp(20px, 5.5vw, 30px) !important;
        margin-left: 0 !important;
        margin-right: 0 !important;
      }
      /* Subtitle - small and light */
      #shopify-section-{{ section.id }} .content .prose > div:first-child {
        text-align: center !important;
        margin-top: 0 !important;
        margin-left: -10px !important;
        font-size: 13px !important;
        font-weight: 300 !important;
        white-space: nowrap !important;
      }
      /* Button - left aligned, compact */
      #shopify-section-{{ section.id }} .button,
      #shopify-section-{{ section.id }} .button--solid {
        padding-left: 28px !important;
        padding-right: 28px !important;
        align-self: center !important;
        position: relative !important;
        z-index: 2 !important;
      }
    }
    /* Full-cover clickable overlay */
    #shopify-section-{{ section.id }} .content-over-media {
      position: relative !important;
    }
    #shopify-section-{{ section.id }} .hero-cover-link {
      position: absolute !important;
      inset: 0 !important;
      z-index: 1 !important;
      display: block !important;
    grid-area: auto !important;
    max-width: none !important;
    width: auto !important;
    height: auto !important;
    }
    #shopify-section-{{ section.id }} .content {
      position: relative !important;
      z-index: 2 !important;
      pointer-events: none !important;
    }
    #shopify-section-{{ section.id }} .content .button,
    #shopify-section-{{ section.id }} .content a {
      pointer-events: auto !important;
    }
    /* Hero content positioning and text size customization */
    #shopify-section-{{ section.id }} .content {
      padding-top: 150px !important;
      padding-left: 45px !important;
    }
    /* "New Arrivals" subtitle - left aligned, tight to heading */
    {%- if section.id contains 'image_with_text_overlay_TebrQa' -%}
    #shopify-section-{{ section.id }} .content .prose > div:first-child p {
      text-align: left !important;
      margin-bottom: 4px !important;
    }
    {%- endif -%}
    
    @media screen and (max-width: 699px) {
      #shopify-section-{{ section.id }} .content {
        padding-top: 35px !important;
        padding-left: 20px !important;
        padding-right: 20px !important;
      }
    }
        #shopify-section-{{ section.id }} .content .prose > div:first-child {
          font-size: 55px !important;
            line-height: 1.1 !important;
            margin-top: 8px !important;
            }
    {%- endif -%}

    /* Mobile sizing (non-hero sections) */
    @media screen and (max-width: 699px) {
      #shopify-section-{{ section.id }} {
        --hero-h-size: clamp(16px, 5.5vw, 22px);
        --hero-h-mb: 10px;
        --hero-h-ml: 15px;
        --hero-p-ml: -10px;
        --hero-p-size: 26px;
        --hero-p-mb: 4px;
      }
    }

    {%- if section.id contains 'image_with_text_overlay_rxf9er' or section.id contains 'image_with_text_overlay_DYm7Nb' or section.id contains 'image_with_text_overlay_7UiPzb' -%}
    /* Desktop: object-fit cover */
    @media screen and (min-width: 700px) {
      #shopify-section-{{ section.id }} .content-over-media img {
        object-fit: cover !important;
        object-position: center 72% !important;
      }
      /* Hide gold line on desktop */
      #shopify-section-{{ section.id }} .rxf9er-gold-line {
        display: none !important;
      }
      /* NF: readability scrim + text-shadow for overlay text */
      #shopify-section-{{ section.id }} .content-over-media { position: relative; }
      #shopify-section-{{ section.id }} .content-over-media::after {
        content: ''; position: absolute; inset: 0; z-index: 0; pointer-events: none;
        border-radius: inherit;
        background: linear-gradient(90deg, rgba(0,0,0,0.50) 0%, rgba(0,0,0,0.30) 35%, rgba(0,0,0,0.05) 60%, rgba(0,0,0,0) 78%);
      }
      #shopify-section-{{ section.id }} .content { z-index: 1; }
      #shopify-section-{{ section.id }} .content .prose,
      #shopify-section-{{ section.id }} .content .prose * {
        text-shadow: 0 1px 14px rgba(0,0,0,0.55), 0 1px 3px rgba(0,0,0,0.45);
      }
    }

    /* Mobile: Option B — bottom-left, portrait, clean editorial */
    @media screen and (max-width: 699px) {
      /* Portrait image */
      #shopify-section-{{ section.id }} .content-over-media {
        aspect-ratio: 3 / 4 !important;
        height: auto !important;
        min-height: 0 !important;
        max-height: none !important;
      }
      #shopify-section-{{ section.id }} .content-over-media img {
        object-fit: cover !important;
        object-position: center center !important;
        width: 100% !important;
        height: 100% !important;
      }
      /* Text block: bottom-left, padded */
      #shopify-section-{{ section.id }} .content-over-media .content {
        padding: 0 0 24px 22px !important;
        max-width: 82% !important;
        place-self: end start !important;
      }
      /* Left-align everything */
      #shopify-section-{{ section.id }} .content-over-media .prose,
      #shopify-section-{{ section.id }} .content-over-media .prose * {
        text-align: left !important;
      }
      /* Gold accent line injected via liquid */
      #shopify-section-{{ section.id }} .rxf9er-gold-line {
        display: block !important;
        width: 42px !important;
        height: 1px !important;
        background-color: #b69456 !important;
        margin-bottom: 10px !important;
      }
      /* Heading: bold, strong multi-layer shadow */
      #shopify-section-{{ section.id }} .content-over-media .prose .h4 {
        font-size: 20px !important;
        font-weight: 300 !important;
        line-height: 1.1 !important;
        letter-spacing: 0 !important;
        color: #ffffff !important;
        -webkit-text-fill-color: #ffffff !important;
        text-shadow:
          0 1px 2px rgba(0,0,0,1),
          0 2px 6px rgba(0,0,0,0.9),
          0 4px 14px rgba(0,0,0,0.75),
          0 8px 24px rgba(0,0,0,0.5) !important;
        margin: 0 0 8px 0 !important;
      }
      /* Body text: small, airy, strong shadow */
      #shopify-section-{{ section.id }} .content-over-media .prose div,
      #shopify-section-{{ section.id }} .content-over-media .prose div > p {
        font-size: 10px !important;
        line-height: 1.55 !important;
        font-weight: 400 !important;
        letter-spacing: 0 !important;
        color: rgba(235,230,220,0.95) !important;
        -webkit-text-fill-color: rgba(235,230,220,0.95) !important;
        text-shadow:
          0 1px 2px rgba(0,0,0,0.95),
          0 2px 8px rgba(0,0,0,0.8),
          0 4px 16px rgba(0,0,0,0.6) !important;
        margin: 0 !important;
      }
    }
    {%- endif -%}

    /* NF-CHROME-V1: Best Sellers banner under products. Heading and button share one left edge (theme.liquid
       nora-bestsellers-banner centred the button) and sit mid height on the photo's left side, not in its top corner. */
    {%- if section.id contains 'image_with_text_overlay_7UiPzb' -%}
    @media screen and (min-width: 700px) {
      #shopify-section-{{ section.id }} .content-over-media .content {
        place-self: center start !important;
        padding: 0 0 0 clamp(40px, 5vw, 72px) !important;
      }
      #shopify-section-{{ section.id }} .content-over-media .prose {
        align-items: flex-start !important;
        gap: 22px !important;
      }
      #shopify-section-{{ section.id }} .content-over-media .prose .button {
        align-self: flex-start !important;
        margin: 0 !important;
      }
    }
    @media screen and (max-width: 699px) {
      #shopify-section-{{ section.id }} .content-over-media .prose .button {
        align-self: flex-start !important;
      }
    }
    /* NF-MOBILE-V4 (2026-09-12): phones. The photo runs nearly edge to edge (12px side gaps) at 4:5 so it reads,
       a bottom scrim for the text, a 28px heading and a normal size button in the site's button style. */
    @media screen and (max-width: 699px) {
      #shopify-section-{{ section.id }} { padding-left: 0 !important; padding-right: 0 !important; }
      #shopify-section-{{ section.id }} > .section-spacing { padding-left: 12px !important; padding-right: 12px !important; }
      #shopify-section-{{ section.id }} > .section-spacing .content-over-media {
        aspect-ratio: 4 / 5 !important; width: 100% !important; height: auto !important; min-height: 0 !important; max-height: none !important;
        border-radius: 14px !important; position: relative !important; overflow: hidden !important;
      }
      #shopify-section-{{ section.id }} > .section-spacing .content-over-media::after {
        content: ''; position: absolute; inset: 0; z-index: 0; pointer-events: none; border-radius: inherit;
        background: linear-gradient(180deg, rgba(0,0,0,0) 42%, rgba(0,0,0,.28) 66%, rgba(0,0,0,.62) 100%);
      }
      #shopify-section-{{ section.id }} > .section-spacing .content-over-media .content {
        position: relative !important; z-index: 1 !important; place-self: end start !important;
        padding: 0 22px 24px !important; max-width: 100% !important;
      }
      #shopify-section-{{ section.id }} > .section-spacing .content-over-media .prose { gap: 14px !important; }
      #shopify-section-{{ section.id }} > .section-spacing .content-over-media .prose .h2,
      #shopify-section-{{ section.id }} > .section-spacing .content-over-media .prose h2 {
        font-size: 28px !important; line-height: 1.15 !important; letter-spacing: 0 !important; margin: 0 !important;
        text-wrap: balance; text-shadow: 0 1px 12px rgba(0,0,0,.45), 0 1px 3px rgba(0,0,0,.35) !important;
      }
      #shopify-section-{{ section.id }} > .section-spacing .content-over-media .prose .button {
        align-self: flex-start !important; width: auto !important; max-width: 100% !important; white-space: nowrap !important;
        font-size: 13px !important; line-height: 1.6 !important; letter-spacing: .13em !important; font-weight: 500 !important;
        padding: 10.4px 28px !important; min-height: 0 !important; margin: 2px 0 0 !important; text-shadow: none !important;
      }
    }
    {%- endif -%}

    /* Kill any opacity dimming in this section */
    #shopify-section-{{ section.id }} [reveal-on-scroll="true"],
    #shopify-section-{{ section.id }} .content-over-media {
      opacity: 1 !important;
    }

    #shopify-section-{{ section.id }} .prose figcaption,
    #shopify-section-{{ section.id }} .link-faded,
    #shopify-section-{{ section.id }} p,
    #shopify-section-{{ section.id }} h1,
    #shopify-section-{{ section.id }} h2,
    #shopify-section-{{ section.id }} h3,
    #shopify-section-{{ section.id }} span,
    #shopify-section-{{ section.id }} div:not(.button) {
      color: rgb(255 255 255) !important;
      -webkit-text-fill-color: #ffffff !important;
    }

    /* Button - refined premium */
    #shopify-section-{{ section.id }} .button,
    #shopify-section-{{ section.id }} .button--solid {
      background-color: #ffffff !important;
      background-image: none !important;
      color: #1c1c1c !important;
      -webkit-text-fill-color: #1c1c1c !important;
      border-color: #ffffff !important;
      font-size: 13px !important;
      font-weight: 500 !important;
      letter-spacing: 0.12em !important;
      text-transform: uppercase !important;
      padding: 19px 34px !important;
      min-height: 0 !important;
      display: inline-block !important;
      margin: 0 0 !important;
      opacity: 1 !important;
    }
    #shopify-section-{{ section.id }} .button *,
    #shopify-section-{{ section.id }} .button--solid * {
      color: #1c1c1c !important;
      -webkit-text-fill-color: #1c1c1c !important;
    }
    #shopify-section-{{ section.id }} .button:hover,
    #shopify-section-{{ section.id }} .button--solid:hover {
      background-color: #ffffff !important;
      background-image: none !important;
      opacity: 0.88;
    }

    /* Tight row gap so button hugs the text above */
    #shopify-section-{{ section.id }} .content-over-media {
      --content-over-media-gap: 0.5rem !important;
      --content-over-media-row-gap: 0.5rem !important;
    }
    #shopify-section-{{ section.id }} .content-over-media .prose {
      gap: 0.4rem !important;
      display: flex !important;
      flex-direction: column !important;
      align-items: flex-start !important;
    }
    #shopify-section-{{ section.id }} .content-over-media .prose > * + * {
      margin-top: 0 !important;
    }

    /* Mobile button */
    @media screen and (max-width: 699px) {
      #shopify-section-{{ section.id }} .button,
      #shopify-section-{{ section.id }} .button--solid {
        font-size: 14px !important;
        padding: 13px 30px !important;
        letter-spacing: 0 !important;
      }
    }

    /* Inner p of richtext inherits from wrapper inline style */
    #shopify-section-{{ section.id }} .content-over-media .content .prose > div > p {
      font-size: inherit !important;
      color: inherit !important;
      -webkit-text-fill-color: inherit !important;
      line-height: inherit !important;
      text-shadow: inherit !important;
      opacity: 1 !important;
      margin: 0 !important;
    }
  
    /* === NF MOBILE HERO OVERRIDES (TebrQa) === */
    {%- if section.id contains 'image_with_text_overlay_TebrQa' -%}
    @media screen and (max-width: 699px) {
      #shopify-section-{{ section.id }} {
        --hero-h-size: 30px !important;
        --hero-h-weight: 600 !important;
        --hero-h-mb: 16px !important;
        --hero-h-ml: 0 !important;
        --hero-p-size: 13px !important;
        --hero-p-mb: 8px !important;
        --hero-p-ml: 0 !important;
        --hero-h-shadow: none !important;
        --hero-p-shadow: none !important;
      }
      #shopify-section-{{ section.id }} .content-over-media {
        --content-over-media-height: 480px !important;
      }
      #shopify-section-{{ section.id }} .content {
        place-self: start start !important;
        align-items: flex-start !important;
        justify-self: start !important;
        text-align: left !important;
        padding-top: 44px !important;
        padding-left: 22px !important;
        padding-right: 22px !important;
        width: auto !important;
        max-width: 92% !important;
      }
      #shopify-section-{{ section.id }} .content .prose {
        align-items: flex-start !important;
        text-align: left !important;
      }
      #shopify-section-{{ section.id }} .content .prose .h1,
      #shopify-section-{{ section.id }} .content .prose h1 {
        max-width: 100% !important;
        text-align: left !important;
        margin-left: 0 !important;
        margin-right: 0 !important;
        font-weight: 600 !important;
      }
      #shopify-section-{{ section.id }} .content .prose > div:first-child {
        text-align: left !important;
        margin-left: 0 !important;
        white-space: normal !important;
      }
      #shopify-section-{{ section.id }} .content .button,
      #shopify-section-{{ section.id }} .content .button--solid {
        font-size: 10px !important;
        padding: 9px 16px !important;
        letter-spacing: 0.08em !important;
        align-self: flex-start !important;
        margin-left: 0 !important;
      }
    }
    {%- endif -%}
  
{%- if section.id contains 'image_with_text_overlay_TebrQa' -%}
/* NF-AUTUMNHERO-V3 centred type straight on the image, no panel */
#shopify-section-{{ section.id }}{ --nf-hero-ink:#ffffff; --hero-h-shadow:0 2px 18px rgba(0,0,0,.45); --hero-p-shadow:0 1px 10px rgba(0,0,0,.45); }
