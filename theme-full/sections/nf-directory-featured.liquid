{%- comment -%}
  NF-DIRECTORY-V1 (2026-09-11): dark "Start with our favorites" band closing the /collections directory
  (templates/list-collections.json): Best Sellers Indoor, Best Sellers Outdoor, New Arrivals and Sale as big photo cards.
  Sale points at /collections/clearance (the `sale` collection is not published to the Online Store).
  A card whose collection is missing or empty on the storefront is skipped. Email only, never a phone.
{%- endcomment -%}
{{- 'nf-directory.css' | asset_url | stylesheet_tag -}}
{%- assign nff_anchor = section.settings.anchor | default: 'featured' -%}
{%- assign nff_email = section.settings.email | default: 'info@norafurnish.com' -%}
<section class="nfd nfd-feat nfd-on-dark" id="{{ nff_anchor }}" data-nfd-sec aria-labelledby="nfd-fh-{{ section.id }}">
  <div class="nfd-wrap">
    <div class="nfd-head">
      <div class="nfd-head__main">
        {%- if section.settings.eyebrow != blank -%}<p class="nfd-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2 class="nfd-h2" id="nfd-fh-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.text != blank -%}<p class="nfd-lead">{{ section.settings.text | escape }}</p>{%- endif -%}
      </div>
    </div>
    <ul class="nfd-feat__grid" role="list">
      {%- for block in section.blocks -%}
        {%- assign c = block.settings.collection -%}
        {%- if c == blank or c.all_products_count == 0 -%}{%- continue -%}{%- endif -%}
        {%- assign f_title = block.settings.title | default: c.title -%}
        {%- assign f_img = blank -%}
        {%- if block.settings.image_file != blank -%}
          {%- assign f_img = images[block.settings.image_file] -%}
          {%- if f_img.width == blank or f_img.width == 0 -%}{%- assign f_img = blank -%}{%- endif -%}
        {%- endif -%}
        {%- if f_img == blank -%}{%- assign f_img = c.image | default: c.featured_image -%}{%- endif -%}
        <li class="nfd-feat__li" data-nfd-item data-nfd-k="{{ f_title | downcase | escape }} {{ c.title | downcase | escape }} {{ block.settings.keywords | downcase | escape }}" {{ block.shopify_attributes }}>
          <a class="nfd-fcard" href="{{ c.url }}">
            <span class="nfd-fcard__img">
              {%- if f_img != blank -%}{{- f_img | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360,540,720,900', sizes: '(min-width: 1000px) 24vw, (min-width: 700px) 48vw, 100vw', alt: '' -}}{%- endif -%}
            </span>
            <span class="nfd-fcard__body">
              <span class="nfd-fcard__n">{{ c.all_products_count }} pieces</span>
              <span class="nfd-fcard__t">{{ f_title | escape }}</span>
              {%- if block.settings.text != blank -%}<span class="nfd-fcard__p">{{ block.settings.text | escape }}</span>{%- endif -%}
              <span class="nfd-fcard__cta">Shop now<span class="nfd-arrow" aria-hidden="true">&rarr;</span></span>
            </span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
    <p class="nfd-feat__foot">Looking for one particular piece? <a href="{{ routes.search_url }}">Search the store</a> or email <a href="mailto:{{ nff_email | escape }}">{{ nff_email | escape }}</a> and we will point you to it.</p>
  </div>
</section>

{% schema %}
{
  "name": "NF directory featured",
  "class": "nfd-section nfd-section--feat",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "featured" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Featured" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Start with our favorites" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "email", "label": "Email", "default": "info@norafurnish.com" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "text", "id": "text", "label": "Short line" },
        { "type": "text", "id": "image_file", "label": "Image filename in Files" },
        { "type": "text", "id": "keywords", "label": "Extra filter words" }
      ]
    }
  ],
  "max_blocks": 6
}
{% endschema %}
