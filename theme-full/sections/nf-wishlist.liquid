{%- comment -%}
  NF-WISHLIST-PAGE-V1 (2026-09-25, owner round 10: "when a customer clicks their profile, have a wishlist button and show
  their wishlist, recently viewed and similar"). /pages/wishlist (templates/page.wishlist.json). The header heart and the
  "Wishlist" item in the customer account menu both open it.
  Shopify's new customer account pages (account.norafurnish.com) cannot be themed, so this page is the account hub:
    Your wishlist     localStorage nf_wishlist_v1 (saved from the product page heart, assets/nf-pdp3.js section 6)
    Recently viewed   localStorage nf_rv_v1 (written on every product page, assets/nf-pdp.js)
    You may also like Shopify product recommendations for the newest saved or viewed piece
  Signed in customers also get links to their orders and profile.
{%- endcomment -%}
{%- liquid
  assign heading = section.settings.heading | default: 'Your wishlist'
-%}
<style>
.nfwl{--tan:#b38b5d;--tan-d:#9a7447;--ink:#1c1c1c;--muted:#6b6259;--line:#e6ddcf;--card:#fffcf6;padding:clamp(40px,6vw,80px) 0 clamp(40px,5vw,64px);background:#faf7f1;color:var(--ink)}
.nfwl__in{max-width:1400px;margin:0 auto;padding-inline:clamp(16px,4vw,60px)}
.nfwl__top{display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:18px 28px;margin:0 0 30px;padding-bottom:22px;border-bottom:1px solid var(--line)}
.nfwl__eyebrow{margin:0 0 10px;font:600 12px/1 var(--text-font-family,Inter,system-ui,sans-serif);letter-spacing:.2em;text-transform:uppercase;color:var(--tan-d)}
.nfwl__h{margin:0;font-family:var(--heading-font-family,Georgia,serif);font-weight:400;font-size:clamp(34px,4vw,56px);line-height:1.05;color:var(--tan)}
.nfwl__hi{margin:10px 0 0;font-size:15px;color:var(--muted)}
.nfwl__acct{display:flex;flex-wrap:wrap;gap:10px}
.nfwl__pill{display:inline-flex;align-items:center;gap:8px;min-height:44px;padding:0 20px;border:1px solid var(--ink);border-radius:999px;background:#fff;color:var(--ink);font:600 12.5px/1 var(--text-font-family,Inter,system-ui,sans-serif);letter-spacing:.12em;text-transform:uppercase;text-decoration:none;transition:background-color .2s,color .2s,border-color .2s}
.nfwl__pill:hover{background:var(--ink);color:#fff}
.nfwl__pill--tan{border-color:var(--tan);background:var(--tan);color:#fff}
.nfwl__pill--tan:hover{border-color:var(--tan-d);background:var(--tan-d)}
.nfwl__tabs{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 26px}
.nfwl__tab{padding:9px 16px;border:1px solid var(--line);border-radius:999px;background:#fff;color:var(--ink);font:600 13px/1 var(--text-font-family,Inter,system-ui,sans-serif);text-decoration:none}
.nfwl__tab:hover{border-color:var(--tan);color:var(--tan-d)}
.nfwl__tab b{margin-left:6px;color:var(--tan-d)}
.nfwl__block{margin:0 0 54px;scroll-margin-top:120px}
.nfwl__block[hidden]{display:none}
.nfwl__bh{display:flex;align-items:baseline;justify-content:space-between;gap:16px;margin:0 0 18px}
.nfwl__h2{margin:0;font-family:var(--heading-font-family,Georgia,serif);font-weight:400;font-size:clamp(24px,2.4vw,32px);color:var(--ink)}
.nfwl__clear{padding:0;border:0;background:none;font-size:13px;color:var(--muted);text-decoration:underline;text-underline-offset:3px;cursor:pointer}
.nfwl__grid{list-style:none;display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:22px;margin:0;padding:0}
.nfwl__card{position:relative;display:flex;flex-direction:column;border:1px solid var(--line);border-radius:14px;background:var(--card);overflow:hidden}
.nfwl__img{display:block;aspect-ratio:1/1;background:#f1ece3;overflow:hidden}
.nfwl__img img{display:block;width:100%;height:100%;object-fit:cover;transition:transform .6s cubic-bezier(.2,.7,.3,1)}
.nfwl__card:hover .nfwl__img img{transform:scale(1.04)}
.nfwl__body{display:flex;flex-direction:column;gap:6px;flex:1;padding:14px 16px 16px}
.nfwl__t{display:-webkit-box;overflow:hidden;font-family:var(--heading-font-family,Georgia,serif);font-size:16px;line-height:1.3;color:var(--ink);text-decoration:none;-webkit-line-clamp:2;-webkit-box-orient:vertical}
.nfwl__p{font-size:14.5px;font-weight:600;color:var(--tan-d)}
.nfwl__go{display:flex;align-items:center;justify-content:center;min-height:42px;margin-top:auto;border-radius:999px;background:var(--tan);color:#fff;font:600 12px/1 var(--text-font-family,Inter,system-ui,sans-serif);letter-spacing:.12em;text-transform:uppercase;text-decoration:none;transition:background-color .2s}
.nfwl__go:hover{background:var(--tan-d)}
.nfwl__rm{position:absolute;top:10px;right:10px;display:grid;place-items:center;width:36px;height:36px;padding:0;border:0;border-radius:50%;background:rgba(255,255,255,.94);box-shadow:0 2px 10px rgba(0,0,0,.15);cursor:pointer}
.nfwl__rm svg{width:18px;height:18px;fill:var(--tan);stroke:var(--tan);stroke-width:1.6}
.nfwl__rm:hover svg{fill:none}
.nfwl__empty{margin:0;padding:34px 24px;border:1px dashed #d8cbb4;border-radius:14px;background:#fff;text-align:center;color:var(--muted);font-size:15px;line-height:1.6}
.nfwl__empty a{color:var(--tan-d);font-weight:600}
.nfwl__note{margin:-30px 0 40px;font-size:13px;color:var(--muted)}
@media (max-width:749px){
  .nfwl__grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
  .nfwl__body{padding:10px 10px 12px}
  .nfwl__t{font-size:14px}
  .nfwl__go{min-height:38px;font-size:11px;letter-spacing:.08em}
  .nfwl__acct{width:100%}
  .nfwl__pill{flex:1;justify-content:center;padding:0 12px}
}
</style>

<section class="nfwl" data-nfwl aria-labelledby="nfwl-h">
  <div class="nfwl__in">
    <div class="nfwl__top">
      <div>
        <p class="nfwl__eyebrow">{% if customer %}Your account{% else %}Saved pieces{% endif %}</p>
        <h1 class="nfwl__h" id="nfwl-h">{{ heading | escape }}</h1>
        {%- if customer -%}
          <p class="nfwl__hi">Welcome back{% if customer.first_name != blank %}, {{ customer.first_name | escape }}{% endif %}.</p>
        {%- endif -%}
      </div>
      <div class="nfwl__acct">
        {%- if customer -%}
          <a class="nfwl__pill" href="{{ routes.account_url }}">Orders &amp; profile</a>
          <a class="nfwl__pill" href="{{ routes.account_logout_url }}">Sign out</a>
        {%- elsif shop.customer_accounts_enabled -%}
          <a class="nfwl__pill nfwl__pill--tan" href="{{ routes.account_login_url }}">Sign in</a>
        {%- endif -%}
      </div>
    </div>

    <nav class="nfwl__tabs" aria-label="On this page">
      <a class="nfwl__tab" href="#nfwl-saved">Wishlist <b data-nfwl-n="saved">0</b></a>
      <a class="nfwl__tab" href="#recent">Recently viewed <b data-nfwl-n="recent">0</b></a>
      <a class="nfwl__tab" href="#nfwl-more">You may also like</a>
    </nav>

    <div class="nfwl__block" id="nfwl-saved">
      <div class="nfwl__bh"><h2 class="nfwl__h2">Wishlist</h2></div>
      <ul class="nfwl__grid" data-nfwl-saved></ul>
      <p class="nfwl__empty" data-nfwl-empty hidden>Nothing saved yet. Tap the heart on any product to keep it here. <a href="{{ section.settings.browse_url | default: '/collections/all' }}">Start browsing</a></p>
    </div>
    <p class="nfwl__note">Your wishlist and recently viewed pieces are saved on this device.</p>

    <div class="nfwl__block" id="recent" hidden data-nfwl-recent-block>
      <div class="nfwl__bh"><h2 class="nfwl__h2">Recently viewed</h2><button type="button" class="nfwl__clear" data-nfwl-clear>Clear history</button></div>
      <ul class="nfwl__grid" data-nfwl-recent></ul>
    </div>

    <div class="nfwl__block" id="nfwl-more" hidden data-nfwl-more-block>
      <div class="nfwl__bh"><h2 class="nfwl__h2">You may also like</h2></div>
      <ul class="nfwl__grid" data-nfwl-more></ul>
    </div>
  </div>
</section>

<script>
(function () {
  var root = document.querySelector('[data-nfwl]'); if (!root) return;
  var WK = 'nf_wishlist_v1', RV = 'nf_rv_v1';
  function read(k) { try { return JSON.parse(localStorage.getItem(k) || '[]') || []; } catch (e) { return []; } }
  function write(k, a) { try { localStorage.setItem(k, JSON.stringify(a)); } catch (e) {} }
  function esc(s) { return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }
  function sized(src, w) { if (!src) return ''; src = src.indexOf('//') === 0 ? 'https:' + src : src; return src + (src.indexOf('?') > -1 ? '&' : '?') + 'width=' + w; }
  var HEART = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20.3l-1.3-1.2C5.9 14.8 3 12.1 3 8.7 3 6 5.1 4 7.7 4c1.5 0 2.9.7 3.8 1.8h1C13.4 4.7 14.8 4 16.3 4 18.9 4 21 6 21 8.7c0 3.4-2.9 6.1-7.7 10.4z"/></svg>';
  function card(x, saved) {
    var url = x.u || ('/products/' + x.h);
    return '<li class="nfwl__card">' +
      '<a class="nfwl__img" href="' + esc(url) + '" tabindex="-1" aria-hidden="true"><img src="' + esc(sized(x.i, 600)) + '" alt="" loading="lazy" width="600" height="600"></a>' +
      (saved ? '<button type="button" class="nfwl__rm" data-rm="' + esc(x.h) + '" aria-label="Remove ' + esc(x.t) + ' from your wishlist">' + HEART + '</button>' : '') +
      '<div class="nfwl__body"><a class="nfwl__t" href="' + esc(url) + '">' + esc(x.t) + '</a>' +
      (x.p ? '<span class="nfwl__p">' + esc(x.p) + '</span>' : '') +
      '<a class="nfwl__go" href="' + esc(url) + '">View piece</a></div></li>';
  }
  function count(k, n) { var b = root.querySelector('[data-nfwl-n="' + k + '"]'); if (b) b.textContent = n; }

  function paintSaved() {
    var list = read(WK).filter(function (x) { return x && x.h && x.t; });
    root.querySelector('[data-nfwl-saved]').innerHTML = list.map(function (x) { return card(x, true); }).join('');
    root.querySelector('[data-nfwl-empty]').hidden = list.length > 0;
    count('saved', list.length);
    document.dispatchEvent(new CustomEvent('nf:wishlist-change'));
    return list;
  }
  function paintRecent() {
    var list = read(RV).filter(function (x) { return x && x.h && x.t && x.i; }).slice(0, 12);
    root.querySelector('[data-nfwl-recent]').innerHTML = list.map(function (x) { return card(x, false); }).join('');
    root.querySelector('[data-nfwl-recent-block]').hidden = !list.length;
    count('recent', list.length);
    return list;
  }
  root.addEventListener('click', function (e) {
    var rm = e.target.closest('[data-rm]');
    if (rm) { var h = rm.getAttribute('data-rm'); write(WK, read(WK).filter(function (x) { return x.h !== h; })); paintSaved(); return; }
    if (e.target.closest('[data-nfwl-clear]')) { write(RV, []); paintRecent(); }
  });

  var saved = paintSaved(), recent = paintRecent();

  /* You may also like: Shopify recommendations for the newest saved (else viewed) piece, minus what is already listed */
  var seed = (saved[0] || recent[0] || {}).h;
  if (!seed || !window.fetch) return;
  var skip = {}; saved.concat(recent).forEach(function (x) { skip[x.h] = 1; });
  fetch('/products/' + encodeURIComponent(seed) + '.js')
    .then(function (r) { if (!r.ok) throw 0; return r.json(); })
    .then(function (p) { return fetch('/recommendations/products.json?limit=10&intent=related&product_id=' + p.id); })
    .then(function (r) { if (!r.ok) throw 0; return r.json(); })
    .then(function (data) {
      var items = (data.products || []).filter(function (p) { return !skip[p.handle] && p.available !== false; }).slice(0, 8).map(function (p) {
        var cents = p.price_min != null ? p.price_min : p.price;
        var price = (p.price_varies ? 'From ' : '') + '$' + (cents / 100).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
        return { h: p.handle, t: p.title, i: p.featured_image, p: price, u: p.url || ('/products/' + p.handle) };
      });
      if (!items.length) return;
      root.querySelector('[data-nfwl-more]').innerHTML = items.map(function (x) { return card(x, false); }).join('');
      root.querySelector('[data-nfwl-more-block]').hidden = false;
    })
    .catch(function () {});
})();
</script>

{% schema %}
{
  "name": "NF wishlist",
  "tag": "div",
  "class": "shopify-section--nf-wishlist",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your wishlist" },
    { "type": "url", "id": "browse_url", "label": "Empty wishlist link" }
  ],
  "presets": [{ "name": "NF wishlist" }]
}
{% endschema %}
