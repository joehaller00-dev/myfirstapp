{%- comment -%} nf-pro-band (Professionals, 2026-09-11). Dark call to action band. {%- endcomment -%}
{{- 'nf-pro.css' | asset_url | stylesheet_tag -}}
{%- assign s = section.settings -%}
<section class="nfp nfp--{{ s.bg }} nfp-sec nfp-sec--tight">
  <div class="nfp-wrap">
    <div class="nfp-band nfp-on-dark">
      <div>
        {%- if s.eyebrow != blank -%}<p class="nfp-eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
        <h2 class="nfp-h2">{{ s.heading | escape }}</h2>
        {%- if s.text != blank -%}<p class="nfp-lead">{{ s.text | escape }}</p>{%- endif -%}
      </div>
      <div class="nfp-actions">
        {%- if s.btn1_label != blank -%}<a class="nfp-btn nfp-btn--primary" href="{{ s.btn1_url }}">{{ s.btn1_label | escape }}</a>{%- endif -%}
        {%- if s.btn2_label != blank -%}<a class="nfp-btn nfp-btn--secondary" href="{{ s.btn2_url }}">{{ s.btn2_label | escape }}</a>{%- endif -%}
        {%- if s.link_label != blank -%}<a class="nfp-link" href="{{ s.link_url }}">{{ s.link_label | escape }} <span class="nfp-arrow" aria-hidden="true">&rarr;</span></a>{%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "NF Pro call to action",
  "class": "nfp-shell",
  "settings": [
    { "type": "select", "id": "bg", "label": "Background", "default": "cream", "options": [ { "value": "cream", "label": "Cream" }, { "value": "sand", "label": "Sand" }, { "value": "white", "label": "White" } ] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "btn1_label", "label": "Primary button label" },
    { "type": "text", "id": "btn1_url", "label": "Primary button link" },
    { "type": "text", "id": "btn2_label", "label": "Secondary button label" },
    { "type": "text", "id": "btn2_url", "label": "Secondary button link" },
    { "type": "text", "id": "link_label", "label": "Quiet link label" },
    { "type": "text", "id": "link_url", "label": "Quiet link" }
  ]
}
{% endschema %}
