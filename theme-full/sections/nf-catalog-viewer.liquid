{%- comment -%}
  nf-catalog-viewer : Nora Furnish digital catalog viewer (templates/page.lighting-catalog.json).
  Catalog content: page metafield custom.catalog (json). Prices: printed live from the
  lighting-catalog-2026 collection on every render, so they always match the product pages.
  Styles and behavior: assets/nf-catalog.css, assets/nf-catalog.js.
{%- endcomment -%}
{%- liquid
  assign cat_page = page
  if section.settings.catalog_page != blank
    assign cat_page = section.settings.catalog_page
  endif
  assign cat = cat_page.metafields.custom.catalog.value
  assign cat_coll = section.settings.collection
  if cat_coll == blank
    assign cat_coll = collections['lighting-catalog-2026']
  endif
  assign cat_title = section.settings.title
  if cat_title == blank
    assign cat_title = cat.title | default: page.title
  endif
-%}
{{ 'nf-catalog.css' | asset_url | stylesheet_tag }}
<!--NFCAT-MARKUP-START-->
<section class="nfcat" id="nfcat-{{ section.id }}" data-nfcat-viewer data-collection="{{ cat_coll.handle }}" data-money="{{ shop.money_format | strip_html | escape }}">
  <div class="nfcat-wrap">
    <header class="nfcat-head">
      <p class="nfcat-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h1 class="nfcat-title">{{ cat_title | escape }}</h1>
      <p class="nfcat-lede">{{ section.settings.lede | escape }}</p>
    </header>
    <div class="nfcat-viewer" data-viewer>
      <div class="nfcat-bar" data-bar>
        <div class="nfcat-bar__l">
          <button type="button" class="nfcat-pagesbtn" data-act="pages" aria-expanded="false" aria-label="Show all pages"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3.5 3.5h5v5h-5zM11.5 3.5h5v5h-5zM3.5 11.5h5v5h-5zM11.5 11.5h5v5h-5z" fill="none" stroke="currentColor" stroke-width="1.4"/></svg><span>Pages</span></button>
        </div>
        <div class="nfcat-bar__c">
          <button type="button" class="nfcat-ic" data-act="prev" aria-label="Previous page"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M12.5 4.5 7 10l5.5 5.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
          <span class="nfcat-count"><span data-cur>1</span> / <span data-total>1</span></span>
          <button type="button" class="nfcat-ic" data-act="next" aria-label="Next page"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M7.5 4.5 13 10l-5.5 5.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
        </div>
        <div class="nfcat-bar__r">
          <button type="button" class="nfcat-ic" data-act="zoomout" aria-label="Zoom out"><svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M6 8.5h5M12.6 12.6 17 17" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg></button>
          <span class="nfcat-zoomval" data-zoom>100%</span>
          <button type="button" class="nfcat-ic" data-act="zoomin" aria-label="Zoom in"><svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M6 8.5h5M8.5 6v5M12.6 12.6 17 17" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg></button>
          <button type="button" class="nfcat-ic" data-act="fs" aria-label="Full screen"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 7.5V3h4.5M12.5 3H17v4.5M17 12.5V17h-4.5M7.5 17H3v-4.5" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
        </div>
      </div>
      <div class="nfcat-stage" data-stage tabindex="0" role="region" aria-roledescription="catalog" aria-label="{{ cat_title | escape }}">
        <div class="nfcat-track" data-track><div class="nfcat-slot" data-slot></div></div>
        <div class="nfcat-grid" data-grid hidden aria-label="All pages"></div>
        {%- if cat == blank -%}<p class="nfcat-empty">The catalog is being prepared. Please check back soon.</p>{%- endif -%}
      </div>
      <p class="nfcat-sr" aria-live="polite" data-live></p>
    </div>
    <p class="nfcat-hint">{{ section.settings.hint | escape }}</p>
    <div class="nfcat-cta">
      <a class="nfcat-pill nfcat-pill--dark" href="/collections/best-sellers">Shop Best Sellers</a>
      <a class="nfcat-pill" href="/pages/contact">Contact Us</a>
    </div>
  </div>
<!--NFCAT-MARKUP-END-->
  {%- if cat != blank -%}
  <script type="application/json" data-nfcat-json>{{ cat | json }}</script>
  <script type="application/json" data-nfcat-products>{
  {%- if cat_coll != blank -%}
    {%- paginate cat_coll.products by 250 -%}
      {%- for p in cat_coll.products -%}
        {%- liquid
          assign cmp = 0
          for v in p.variants
            if v.price == p.price_min and v.compare_at_price > cmp
              assign cmp = v.compare_at_price
            endif
          endfor
        -%}
        {{ p.handle | json }}:{"t":{{ p.title | json }},"u":{{ p.url | json }},"p":{%- capture nf_cp -%}{% render 'nf-acc-price', product: p, format: 'text' %}{%- endcapture -%}{{ nf_cp | json }},"c":{% if cmp > p.price_min %}{{ cmp | money | strip_html | json }}{% else %}""{% endif %},"v":{{ p.price_varies | json }},"i":{% if p.featured_image %}{{ p.featured_image | image_url: width: 400 | json }}{% else %}""{% endif %},"a":{{ p.available | json }}}{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    {%- endpaginate -%}
  {%- endif -%}
  }</script>
  {%- endif -%}
</section>
<script src="{{ 'nf-catalog.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "NF catalog viewer",
  "class": "nf-catalog-viewer-section",
  "settings": [
    { "type": "page", "id": "catalog_page", "label": "Catalog page", "info": "Leave blank to use this page. The catalog is read from the page metafield custom.catalog." },
    { "type": "collection", "id": "collection", "label": "Price collection", "info": "Collection that holds every catalog product (lighting-catalog-2026)." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Nora Furnish Lighting" },
    { "type": "text", "id": "title", "label": "Title", "default": "2026 Nora Furnish Lighting Catalog" },
    { "type": "text", "id": "lede", "label": "Intro line", "default": "Explore lighting by room and select any hotspot to view the matching fixture." },
    { "type": "text", "id": "hint", "label": "Hint", "default": "Select a + hotspot to view the matching fixture. Swipe or use the arrows to change pages." }
  ]
}
{% endschema %}
