{%- comment -%} nf-pro-faq (Professionals, 2026-09-11). Accordion FAQ with FAQPage structured data. {%- endcomment -%}
{{- 'nf-pro.css' | asset_url | stylesheet_tag -}}
{%- assign s = section.settings -%}
<section class="nfp nfp--{{ s.bg }} nfp-sec"{% if s.anchor != blank %} id="{{ s.anchor | handle }}"{% endif %}>
  <div class="nfp-wrap">
    <div class="nfp-faqwrap">
      <div>
        {%- if s.eyebrow != blank -%}<p class="nfp-eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
        <h2 class="nfp-h2">{{ s.heading | escape }}</h2>
        {%- if s.text != blank -%}<p class="nfp-lead">{{ s.text | escape }}</p>{%- endif -%}
        {%- if s.show_email -%}
          <a class="nfp-link nfp-mailto" href="mailto:info@norafurnish.com">{% render 'nf-pro-icon', name: 'mail' %} info@norafurnish.com</a>
        {%- endif -%}
      </div>
      <div class="nfp-faq">
        {%- for block in section.blocks -%}
          <details {{ block.shopify_attributes }}{% if forloop.first and s.open_first %} open{% endif %}>
            <summary>{{ block.settings.q | escape }}<span class="nfp-faq__icon" aria-hidden="true"></span></summary>
            <div class="nfp-faq__a">{{ block.settings.a }}</div>
          </details>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>
{%- if section.blocks.size > 0 -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for block in section.blocks -%}
    { "@type": "Question", "name": {{ block.settings.q | json }}, "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.a | strip_html | json }} } }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
</script>
{%- endif -%}

{% schema %}
{
  "name": "NF Pro FAQ",
  "class": "nfp-shell",
  "settings": [
    { "type": "select", "id": "bg", "label": "Background", "default": "cream", "options": [ { "value": "cream", "label": "Cream" }, { "value": "sand", "label": "Sand" }, { "value": "white", "label": "White" } ] },
    { "type": "text", "id": "anchor", "label": "Anchor id" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Common questions" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "checkbox", "id": "show_email", "label": "Show email link", "default": true },
    { "type": "checkbox", "id": "open_first", "label": "Open the first answer", "default": false }
  ],
  "blocks": [
    { "type": "faq", "name": "Question", "settings": [ { "type": "text", "id": "q", "label": "Question" }, { "type": "richtext", "id": "a", "label": "Answer" } ] }
  ],
  "max_blocks": 14
}
{% endschema %}
