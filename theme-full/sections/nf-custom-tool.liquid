{%- comment -%} NF-CUSTOM3-V1 (2026-09-11). Interactive tool for the custom services pages: curtain measuring helper,
chandelier sizing guide or neon name sign preview. Logic in assets/nf-custom.js; it fills the quote form's Design details. {%- endcomment -%}
{{- 'nf-custom.css' | asset_url | stylesheet_tag -}}
<script src="{{ 'nf-custom.js' | asset_url }}" defer></script>
{%- assign s = section.settings -%}
<section class="nfc nfc--{{ s.bg }} nfc-sec" id="{{ s.anchor | default: 'design' | handle }}">
  <div class="nfc-wrap">
    {%- if s.heading != blank or s.eyebrow != blank -%}
      <div class="nfc-head">
        {%- if s.eyebrow != blank -%}<p class="nfc-eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="nfc-h2">{{ s.heading | escape }}</h2>{%- endif -%}
        {%- if s.text != blank -%}<p class="nfc-lead">{{ s.text | escape }}</p>{%- endif -%}
      </div>
    {%- endif -%}
    {%- case s.tool -%}
      {%- when 'curtains' -%}{%- render 'nf-custom-curtains', cta: s.cta_label -%}
      {%- when 'chandeliers' -%}{%- render 'nf-custom-chandeliers', cta: s.cta_label -%}
      {%- when 'signs' -%}{%- render 'nf-custom-sign', cta: s.cta_label -%}
    {%- endcase -%}
  </div>
</section>

{% schema %}
{
  "name": "NF Custom tool",
  "class": "nfc-shell",
  "settings": [
    { "type": "select", "id": "tool", "label": "Tool", "default": "curtains", "options": [ { "value": "curtains", "label": "Curtain measuring helper" }, { "value": "chandeliers", "label": "Chandelier sizing guide" }, { "value": "signs", "label": "Neon name sign preview" } ] },
    { "type": "select", "id": "bg", "label": "Background", "default": "grey", "options": [ { "value": "white", "label": "White" }, { "value": "grey", "label": "Light grey" }, { "value": "dark", "label": "Dark evening" } ] },
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "design" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Add this to my quote" }
  ]
}
{% endschema %}
