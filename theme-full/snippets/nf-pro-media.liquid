{%- comment -%}
  nf-pro-media (Professionals, 2026-09-11). Renders a Shopify Files image by FILENAME through the images global,
  for example render 'nf-pro-media', file: 'nf-pro-hub.jpg'. When the file does not exist yet it never shows a
  broken image: it uses a lifestyle photo from the fallback collection, then a product photo on a warm panel,
  then a plain warm panel.
  Params: file, alt, fallback (collection handle), sizes, loading, eager (true for the first hero), label (panel text)
{%- endcomment -%}
{%- liquid
  assign nfm_img = blank
  if file != blank
    assign nfm_img = images[file]
  endif
  assign nfm_ok = false
  if nfm_img != blank and nfm_img.width > 0
    assign nfm_ok = true
  endif
  assign nfm_sizes = sizes | default: '(max-width: 899px) 100vw, 50vw'
  assign nfm_loading = 'lazy'
  if eager
    assign nfm_loading = 'eager'
  endif
-%}
{%- if nfm_ok -%}
  {%- if eager -%}
    {%- comment -%} NF-IMG-SHARP-0916: add a 2400 candidate for the wide banner hero on 2x screens {%- endcomment -%}{{- nfm_img | image_url: width: 2400 | image_tag: loading: nfm_loading, fetchpriority: 'high', sizes: nfm_sizes, widths: '480,720,960,1280,1600,2000,2400', alt: alt -}}
  {%- else -%}
    {{- nfm_img | image_url: width: 2200 | image_tag: loading: nfm_loading, sizes: nfm_sizes, widths: '480,720,960,1280,1600,2000', alt: alt -}}
  {%- endif -%}
{%- else -%}
  {%- liquid
    assign nfm_life = blank
    assign nfm_any = blank
    if fallback != blank
      assign nfm_c = collections[fallback]
      for p in nfm_c.products limit: 16
        if p.featured_image == blank
          continue
        endif
        if nfm_any == blank
          assign nfm_any = p.featured_image
        endif
        assign nfm_src = p.featured_image.src | append: ''
        if nfm_src contains '/image_1'
          assign nfm_life = p.featured_image
          break
        endif
      endfor
    endif
  -%}
  {%- if nfm_life != blank -%}
    {{- nfm_life | image_url: width: 1600 | image_tag: loading: 'lazy', sizes: nfm_sizes, widths: '480,720,960,1280,1600', alt: alt -}}
  {%- else -%}
    <div class="nfp-fallback" role="img" aria-label="{{ alt | escape }}">
      {%- if nfm_any != blank -%}
        {{- nfm_any | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(max-width: 899px) 70vw, 420px', widths: '400,600,800', alt: '' -}}
      {%- elsif label != blank -%}
        <span class="nfp-fallback__mark">{{ label | escape }}</span>
      {%- endif -%}
    </div>
  {%- endif -%}
{%- endif -%}
