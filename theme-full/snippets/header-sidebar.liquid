{%- assign nfd_skip = ',best-sellers,ceiling-light,wall-lights,lamps,ambient-lighting,outdoor-lighting,outdoor-wall-lights,decor,soft-furnishings,storage-shelves,poufs-floor-cushions,home-fragrance,sale,' -%}
{%- assign nfd_force = ',soft-furnishings=throw-blankets,storage-shelves=display-racks,ambient-lighting=led-strip-lights,' -%}
{%- capture nfd_urls -%}{%- for nfd_l1 in linklists['main-menu'].links -%}{{ nfd_l1.url }} {% for nfd_l2 in nfd_l1.links %}{{ nfd_l2.url }} {% endfor -%}{%- endfor -%}{%- endcapture -%}
<script type="application/json" id="nfd-hero-map">{
{%- assign nfd_n = 0 -%}{%- assign nfd_seen = ',' -%}
{%- assign nfd_list = nfd_urls | split: ' ' -%}
{%- for nfd_u in nfd_list -%}
{%- unless nfd_u contains '/collections/' -%}{%- continue -%}{%- endunless -%}
{%- assign nfd_h = nfd_u | split: '/collections/' | last | split: '?' | first | split: '#' | first | split: '/' | first -%}
{%- assign nfd_k = ',' | append: nfd_h | append: ',' -%}
{%- if nfd_seen contains nfd_k -%}{%- continue -%}{%- endif -%}
{%- assign nfd_fk = ',' | append: nfd_h | append: '=' -%}{%- assign nfd_src = nfd_h -%}
{%- if nfd_force contains nfd_fk -%}{%- assign nfd_src = nfd_force | split: nfd_fk | last | split: ',' | first -%}{%- elsif nfd_skip contains nfd_k -%}{%- continue -%}{%- endif -%}
{%- assign nfd_c = collections[nfd_src] -%}
{%- if nfd_c == blank or nfd_c.image == blank -%}{%- continue -%}{%- endif -%}
{%- assign nfd_seen = nfd_seen | append: nfd_h | append: ',' -%}
{%- assign nfd_p = nfd_c.metafields.custom.nf_band_pos.value | default: '' | append: '' | remove: 'fit' | split: '|' | first | strip -%}
{%- if nfd_n > 0 -%},{%- endif -%}{%- assign nfd_n = nfd_n | plus: 1 -%}
{{- '/collections/' | append: nfd_h | json -}}:{"u":{{ nfd_c.image | image_url: width: 900 | json }},"p":{{ nfd_p | default: '' | json }}}
{%- endfor -%}
{%- comment -%} NF-DRAWER-V3 pages (2026-09-13): the Professionals and Made to Order panels borrow a warm collection photo (their nf-pro-hospitality image had blue windows). {%- endcomment -%}
{%- assign nfd_pages = '/pages/professionals=style-glam,/pages/custom-lighting=material-crystal' | split: ',' -%}
{%- for nfd_pp in nfd_pages -%}
{%- assign nfd_pk = nfd_pp | split: '=' | first -%}{%- assign nfd_ph = nfd_pp | split: '=' | last -%}
{%- assign nfd_c = collections[nfd_ph] -%}
{%- if nfd_c == blank or nfd_c.image == blank -%}{%- continue -%}{%- endif -%}
{%- assign nfd_p = nfd_c.metafields.custom.nf_band_pos.value | default: '' | append: '' | remove: 'fit' | split: '|' | first | strip -%}
{%- if nfd_n > 0 -%},{%- endif -%}{%- assign nfd_n = nfd_n | plus: 1 -%}
{{- nfd_pk | json -}}:{"u":{{ nfd_c.image | image_url: width: 900 | json }},"p":{{ nfd_p | default: '' | json }}}
{%- endfor -%}
}</script>
