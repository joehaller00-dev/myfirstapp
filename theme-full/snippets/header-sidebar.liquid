    text-transform: capitalize !important;
  }
</style>
<script>
(function() {
  function initL3Panels() {
    const sidebar = document.querySelector('.header-sidebar');
    if (!sidebar) return;
    const collPanel = sidebar.querySelector('header-sidebar-collapsible-panel');
    if (!collPanel) { setTimeout(initL3Panels, 100); return; }

    sidebar.addEventListener('click', function(e) {
      const panelBtn = e.target.closest('.nf-panel-btn');
      if (panelBtn) {
        e.preventDefault();
        e.stopPropagation();
        const targetId = panelBtn.getAttribute('data-target');
        const parentId = panelBtn.getAttribute('data-parent');
        if (!targetId) return;
        const targetPanel = document.getElementById(targetId);
        if (!targetPanel) return;
        const backBtn = targetPanel.querySelector('.nf-back-btn');
        if (backBtn) backBtn.setAttribute('data-parent-panel', parentId);
        collPanel.setAttribute('aria-activedescendant', targetId);
      }

      const backBtn = e.target.closest('.nf-back-btn');
      if (backBtn) {
        e.preventDefault();
        e.stopPropagation();
        const parentId = backBtn.getAttribute('data-parent-panel');
        if (!parentId) return;
        collPanel.setAttribute('aria-activedescendant', parentId);
      }
    }, true);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initL3Panels);
  } else {
    initL3Panels();
  }
})();
</script>
{%- comment -%}
  ----------------------------------------------------------------------------------------------------------------------
  HEADER SIDEBAR COMPONENT
  ----------------------------------------------------------------------------------------------------------------------

  This snippet the navigation sidebar for the header. It is used for both the mobile menu and for the desktop menu when
  the merchant configures the drawer mode.

  ********************************************
  Supported variables
  ********************************************

  * menu: the menu to render
  * color_scheme: the color scheme to use for the sidebar
  * show_dividers: whether dividers are shown for the collapsible
  * open_second_level_menus: if true, second level dropdown are open by default
{%- endcomment -%}

{%- comment -%}
  IMPLEMENTATION NOTE: while being a drawer, the sidebar has a completely different structure for the content. We are
  therefore using a different structure for the Shadow DOM template
{%- endcomment -%}
<template id="header-sidebar-template">
  <div part="base">
    <div part="overlay"></div>

    <div part="content">
      <header part="header">
        <dialog-close-button class="contents">
          <button type="button" part="close-button tap-area" aria-label="{{ 'general.accessibility.close' | t | escape }}">
            {%- render 'icon' with 'close', width: 16 -%}
          </button>
        </dialog-close-button>
      </header>

      <div part="panel-list">
        <slot name="main-panel"></slot>

        {%- if menu.levels > 0 -%}
          <slot name="collapsible-panel"></slot>
        {%- endif -%}
      </div>
    </div>
  </div>
</template>

<header-sidebar id="sidebar-menu" class="header-sidebar drawer drawer--sm color-scheme color-scheme--{{ color_scheme.id }}" template="header-sidebar-template" open-from="left">
  {%- comment -%}We are using a Shadow DOM where each panel has a slot, so we can directly render each level individually{%- endcomment -%}

  {%- comment -%}Panel 1 is the first level{%- endcomment -%}
  <div class="header-sidebar__main-panel" slot="main-panel">
    <div class="header-sidebar__scroller">
      <ul class="header-sidebar__linklist {% if show_dividers %}divide-y{% endif %} unstyled-list" role="list">
        {%- comment -%} NF-TOPBAR-V2 (2026-09-11): a main menu item that is also a top bar dropdown (Best Sellers) opens that dropdown's panel here instead of being a plain link, so the drawer lists it once, in its usual place. {%- endcomment -%}
        {%- for link in menu.links -%}
          {%- assign nf_tb_dup = 0 -%}
          {%- for nf_tl in linklists['top-bar'].links -%}{%- if nf_tl.links.size > 0 and nf_tl.title == link.title -%}{%- assign nf_tb_dup = forloop.index -%}{%- endif -%}{%- endfor -%}
          <li>
            {%- if nf_tb_dup > 0 -%}
              <button type="button" class="header-sidebar__linklist-button {% if section.settings.sidebar_text_font == 'heading' %}h6{% endif %}" aria-controls="header-panel-tb{{ nf_tb_dup }}" aria-expanded="false">
                {{- link.title -}}
                {%- render 'icon' with 'chevron-right', width: 12, direction_aware: true -%}
              </button>
            {%- elsif link.links.size > 0 -%}
              <button
                type="button"
                class="header-sidebar__linklist-button {% if section.settings.sidebar_text_font == 'heading' %}h6{% endif %}"
                aria-controls="header-panel-{{ forloop.index }}"
                aria-expanded="false"
              >
                {{- link.title -}}
                {%- render 'icon' with 'chevron-right', width: 12, direction_aware: true -%}
              </button>
            {%- else -%}
              <a href="{{ link.url }}" class="header-sidebar__linklist-button {% if section.settings.sidebar_text_font == 'heading' %}h6{% endif %}">
                {{- link.title -}}
              </a>
            {%- endif -%}
          </li>
        {%- endfor -%}
        {%- comment -%} NF-TOPBAR-V1 (2026-09-11): Shop By, Ideas & Guides and Professionals moved from the main menu to the "top-bar" menu, so the drawer lists that menu's dropdown items here. Their panels sit at the end of the collapsible panel below, ids prefixed "tb". {%- endcomment -%}
        {%- assign nf_tb_menu = linklists['top-bar'] -%}
        {%- for link in nf_tb_menu.links -%}
          {%- assign nf_tb_in_main = false -%}
          {%- for nf_ml in menu.links -%}{%- if nf_ml.title == link.title -%}{%- assign nf_tb_in_main = true -%}{%- endif -%}{%- endfor -%}
          {%- if link.links.size > 0 and nf_tb_in_main == false -%}
            <li class="nf-tb-drawer-item">
              <button
                type="button"
                class="header-sidebar__linklist-button {% if section.settings.sidebar_text_font == 'heading' %}h6{% endif %}"
                aria-controls="header-panel-tb{{ forloop.index }}"
                aria-expanded="false"
              >
                {{- link.title -}}
                {%- render 'icon' with 'chevron-right', width: 12, direction_aware: true -%}
              </button>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>

    <div class="header-sidebar__utility-links">
      {%- for link in linklists['Info'].links -%}
        <a href="{{ link.url }}" class="header-sidebar__utility-link">{{ link.title }}</a>
      {%- endfor -%}
    </div>

    <div class="header-sidebar__brand-footer">
      {%- comment -%}NF-PERF2-0911: was the full 229KB wordmark PNG on every page load; now a 400px CDN rendition (2x of its 190px box), lazy so it only loads when the drawer opens{%- endcomment -%}<a href="{{ routes.root_url }}" class="header-sidebar__brand-logo"><img src="//norafurnish.com/cdn/shop/files/e0cf0a7c-0740-403b-9bd3-70fc7e7f6dc9.png?width=400" srcset="//norafurnish.com/cdn/shop/files/e0cf0a7c-0740-403b-9bd3-70fc7e7f6dc9.png?width=200 200w, //norafurnish.com/cdn/shop/files/e0cf0a7c-0740-403b-9bd3-70fc7e7f6dc9.png?width=400 400w, //norafurnish.com/cdn/shop/files/e0cf0a7c-0740-403b-9bd3-70fc7e7f6dc9.png?width=600 600w" sizes="190px" alt="{{ shop.name }}" class="header-sidebar__brand-logo-img" width="190" height="80" loading="lazy" decoding="async"></a>
      <div class="header-sidebar__socials">
        <a href="https://www.instagram.com/norafurnishllc/" target="_blank" rel="noopener" aria-label="Instagram" class="header-sidebar__social-link">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1.2" fill="currentColor" stroke="none"/></svg>
        </a>
        <a href="https://www.tiktok.com/@norafurnish" target="_blank" rel="noopener" aria-label="TikTok" class="header-sidebar__social-link">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"/></svg>
        </a>
        <a href="https://www.facebook.com/profile.php?id=61578464993386" target="_blank" rel="noopener" aria-label="Facebook" class="header-sidebar__social-link">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
        </a>
      </div>
    </div>
    </div>

    {%- liquid
      if section.settings.show_country_selector and localization.available_countries.size > 1
        assign show_country_selector = true
      endif

      if section.settings.show_locale_selector and localization.available_languages.size > 1
        assign show_locale_selector = true
      endif
    -%}

    {%- if shop.customer_accounts_enabled or show_country_selector or show_locale_selector -%}
      <div class="header-sidebar__footer">
        {%- if shop.customer_accounts_enabled -%}
          <shopify-account menu="{{ section.settings.customer_account_menu }}">
            <div slot="signed-out-avatar">
              <div class="text-with-icon smallcaps sm:hidden">
                {%- render 'icon' with 'account', width: 20 -%}
                {{- 'header.general.login' | t -}}
              </div>
            </div>
          </shopify-account>
        {%- endif -%}

        {%- if show_country_selector or show_locale_selector -%}
          <div class="localization-selectors">
            {%- if show_country_selector -%}
              {%- render 'localization-selector',
                type: 'country',
                placement: 'top-start',
                show_country_name: section.settings.show_country_name,
                show_country_flag: section.settings.show_country_flag,
                id_prefix: 'header-sidebar'
              -%}
            {%- endif -%}

            {%- if show_country_selector and show_locale_selector -%}
              <span class="localization-selectors__separator" aria-hidden="true"></span>
            {%- endif -%}

            {%- if show_locale_selector -%}
              {%- render 'localization-selector', type: 'locale', placement: 'top-start', id_prefix: 'header-sidebar' -%}
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  {%- comment -%}Panel 2 holds all the second levels{%- endcomment -%}
  {%- if menu.levels > 0 -%}
    <header-sidebar-collapsible-panel class="header-sidebar__collapsible-panel" slot="collapsible-panel">
      <div class="header-sidebar__scroller">
        {%- comment -%} NF-MENUS-DEFER (2026-09-14): the sub panels are snippets/nf-drawer-subpanels.liquid, served by
          sections/nf-menus-deferred.liquid and injected after load by assets/nf-menus.js. Rollback: set nf_menus_defer to false. {%- endcomment -%}
        {%- assign nf_menus_defer = true -%}
        {%- unless nf_menus_defer -%}
          {%- render 'nf-drawer-subpanels', menu: menu, show_dividers: show_dividers, text_font: section.settings.sidebar_text_font -%}
        {%- endunless -%}
      </div>
    </header-sidebar-collapsible-panel>
  {%- endif -%}
</header-sidebar>